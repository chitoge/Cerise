# Filesystem gate: fshost_probe — proves a component reads a real file from a
# namespace real fshost auto-mounted (see src/main.rs for the full mechanism).
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:fuchsia_platform.bzl", "fuchsia_stripped")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "fshost_probe",
    srcs = ["src/main.rs"],
    crate_name = "fshost_probe",
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS + [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/lib/fuchsia:fuchsia",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "//src/upstream/fuchsia/src/lib/fuchsia-fs:fuchsia-fs",
        "@crates//:anyhow",
        # Real fdio (not the link-time libfdio.so stub) — fuchsia-fs's open_in_namespace FFIs
        # into libfdio.so at final link time; statically link the real implementation.
        "//src/upstream/fuchsia/sdk/lib/fdio:fdio",
    ],
)

# Staged STRIPPED into the boot ZBI, same rationale as the other probes.
fuchsia_stripped(
    name = "fshost_probe_stripped.fuchsia",
    src = ":fshost_probe",
)
