// Cerise gop_display driver: COMPOSITE bind rules for ANY PCI display-class device
// (fuchsia.BIND_PCI_CLASS == DISPLAY, 0x03) — deliberately NOT a VID:DID match. The
// framebuffer geometry/base come from the boot-shim's ZBI_TYPE_FRAMEBUFFER item, not
// from this device's BARs; the PCI node is only a hardware-portable BIND ANCHOR (the
// Intel iGPU on real hardware, the stdvga on the OVMF QEMU gate) so the driver sits in
// the driver framework like every other Cerise driver.
//
// MUTUAL EXCLUSION with the stdvga display driver (which also matches a class-0x03
// device by VID:DID): resolved at the PRODUCT level — hw-x64-firstlight stages
// gop_display only; QEMU console products stage the stdvga driver only. Never stage
// both in one product, or driver-index match order between them is unspecified.
//
// Composite + acpi parent: same rationale as display.bind/e1000.bind — bus-pci
// publishes every PCI device as a composite node spec (which driver-index prioritizes),
// and cold-plugged bus-0 devices have ACPI companions (has_acpi=true) on q35 and on
// real UEFI/ACPI x86 boards (the iGPU is _SB.PCI0.GFX0-shaped). If a metal board ever
// publishes a display device with no ACPI companion, this spec won't match and the
// bind must be revisited.
composite gop_display;

using fuchsia.acpi;
using fuchsia.pci;
using fuchsia.hardware.pci;

primary parent "pci" {
  fuchsia.hardware.pci.Service == fuchsia.hardware.pci.Service.ZirconTransport;
  fuchsia.BIND_PCI_CLASS == fuchsia.pci.BIND_PCI_CLASS.DISPLAY;
}

parent "acpi" {
  fuchsia.BIND_PROTOCOL == fuchsia.acpi.BIND_PROTOCOL.DEVICE;
  fuchsia.BIND_ACPI_BUS_TYPE == fuchsia.acpi.BIND_ACPI_BUS_TYPE.PCI;
}
