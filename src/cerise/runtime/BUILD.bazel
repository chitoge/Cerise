# Fuchsia C++ runtime — libc++ (libcxx) built from LLVM source,
# targeting x86_64-unknown-fuchsia against our musl libc.
#
# The @llvm-project//libcxx:libcxx.shared target cannot cross-compile for
# Fuchsia (its implementation_deps select has no default/fuchsia case).
# This BUILD authoring owns the source list and compile flags directly,
# using @llvm-project//libcxx:headers for the include tree.
#
# The result (libc++.so / libc++.a) goes into fuchsia_link_sysroot so
# cc_binary targets for //platforms:x64-fuchsia can link.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# --- Generated libcxx config headers for Fuchsia/musl ---

# __config_site: libc++ compile-time configuration for Fuchsia.
# Mirrors what upstream generates for musl + pthreads + no-Windows.
# Generated by write_file; placed at include/__config_site so that
# cc_library(includes=["include"]) makes it available as <__config_site>.
genrule(
    name = "libcxx_config_site_gen",
    outs = ["libcxx_include/__config_site"],
    cmd = """cat > $@ << 'CFGEOF'
// Runtime bring-up: libc++ config for x86_64-unknown-fuchsia (musl, pthreads).
// Mirrors the upstream write_file + select logic from libcxx BUILD.bazel.
#define _LIBCPP_ABI_VERSION             1
#define _LIBCPP_ABI_NAMESPACE           __1
#define _LIBCPP_ABI_FORCE_ITANIUM       0
#define _LIBCPP_ABI_FORCE_MICROSOFT     0
#define _LIBCPP_HAS_THREADS             1
#define _LIBCPP_HAS_MONOTONIC_CLOCK     1
#define _LIBCPP_HAS_TERMINAL            1
#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0
#define _LIBCPP_HAS_THREAD_API_C11      0
#define _LIBCPP_HAS_FILESYSTEM          1
#define _LIBCPP_HAS_RANDOM_DEVICE       1
#define _LIBCPP_HAS_LOCALIZATION        1
#define _LIBCPP_HAS_UNICODE             1
#define _LIBCPP_HAS_WIDE_CHARACTERS     1
#define _LIBCPP_HAS_STD_MODULES         0
#define _LIBCPP_HAS_TIME_ZONE_DATABASE  1
#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0
#define _LIBCPP_INSTRUMENTED_WITH_ASAN  0
#define _LIBCPP_PSTL_BACKEND_SERIAL
#define _LIBCPP_HARDENING_MODE_DEFAULT  _LIBCPP_HARDENING_MODE_NONE
#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT 2
// Fuchsia uses musl libc.
#define _LIBCPP_HAS_MUSL_LIBC 1
// Fuchsia uses POSIX pthreads (from musl).
#define _LIBCPP_HAS_THREAD_API_PTHREAD 1
#define _LIBCPP_HAS_THREAD_API_WIN32   0
CFGEOF
""",
    tags = ["manual"],
)

# __assertion_handler: default libc++ assertion hook (verbatim from LLVM upstream).
genrule(
    name = "libcxx_assertion_handler_gen",
    srcs = ["default_assertion_handler.in"],
    outs = ["libcxx_include/__assertion_handler"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

# The generated include directory, exposed as -I so <__config_site> resolves.
cc_library(
    name = "libcxx_generated_headers",
    hdrs = [
        ":libcxx_assertion_handler_gen",
        ":libcxx_config_site_gen",
    ],
    includes = ["libcxx_include"],
    tags = ["manual"],
)

# --- libcxx core static library for Fuchsia ---
#
# Compile the libc++ source files with our Fuchsia CC toolchain.
# We reference individual src/*.cpp files from @llvm-project//libcxx:
#   @llvm-project//libcxx:<path> resolves to the file in the libcxx package.
# Excludes: experimental/*, support/win32/*, support/ibm/*, pstl/libdispatch.cpp.
# Does NOT exclude exception.cpp or filesystem — Fuchsia supports both.
# filesystem/int128_builtins.cpp: omitted (LLVM comment says to omit; the
# __divti3/__udivmodti4 the fs int128 math emits come instead from
# //src/upstream/fuchsia/third_party/compiler-rt-builtins:int128_builtins,
# linked into libc++.so below — no libclang_rt.builtins is staged at runtime).

cc_library(
    name = "libcxx_fuchsia",
    srcs = [
        # Force-included into every TU (copts -include) — must be an input.
        "lgamma-prereq-override.h",
        # Core sources (LIBCXX_SOURCES in CMake)
        "@llvm-project//libcxx:src/algorithm.cpp",
        "@llvm-project//libcxx:src/any.cpp",
        "@llvm-project//libcxx:src/bind.cpp",
        "@llvm-project//libcxx:src/call_once.cpp",
        "@llvm-project//libcxx:src/charconv.cpp",
        "@llvm-project//libcxx:src/chrono.cpp",
        "@llvm-project//libcxx:src/error_category.cpp",
        "@llvm-project//libcxx:src/exception.cpp",
        "@llvm-project//libcxx:src/expected.cpp",
        "@llvm-project//libcxx:src/filesystem/filesystem_clock.cpp",
        "@llvm-project//libcxx:src/filesystem/filesystem_error.cpp",
        "@llvm-project//libcxx:src/filesystem/path.cpp",
        "@llvm-project//libcxx:src/functional.cpp",
        "@llvm-project//libcxx:src/hash.cpp",
        "@llvm-project//libcxx:src/memory.cpp",
        "@llvm-project//libcxx:src/memory_resource.cpp",
        "@llvm-project//libcxx:src/new_handler.cpp",
        "@llvm-project//libcxx:src/new_helpers.cpp",
        "@llvm-project//libcxx:src/optional.cpp",
        "@llvm-project//libcxx:src/print.cpp",
        "@llvm-project//libcxx:src/random_shuffle.cpp",
        "@llvm-project//libcxx:src/ryu/d2fixed.cpp",
        "@llvm-project//libcxx:src/ryu/d2s.cpp",
        "@llvm-project//libcxx:src/ryu/f2s.cpp",
        "@llvm-project//libcxx:src/stdexcept.cpp",
        "@llvm-project//libcxx:src/string.cpp",
        "@llvm-project//libcxx:src/system_error.cpp",
        "@llvm-project//libcxx:src/typeinfo.cpp",
        "@llvm-project//libcxx:src/valarray.cpp",
        "@llvm-project//libcxx:src/variant.cpp",
        "@llvm-project//libcxx:src/vector.cpp",
        "@llvm-project//libcxx:src/verbose_abort.cpp",
        # Threading (LIBCXX_ENABLE_THREADS)
        "@llvm-project//libcxx:src/atomic.cpp",
        "@llvm-project//libcxx:src/barrier.cpp",
        "@llvm-project//libcxx:src/condition_variable.cpp",
        "@llvm-project//libcxx:src/condition_variable_destructor.cpp",
        "@llvm-project//libcxx:src/future.cpp",
        "@llvm-project//libcxx:src/mutex.cpp",
        "@llvm-project//libcxx:src/mutex_destructor.cpp",
        "@llvm-project//libcxx:src/shared_mutex.cpp",
        "@llvm-project//libcxx:src/thread.cpp",
        "@llvm-project//libcxx:src/random.cpp",
        # Localization + I/O
        "@llvm-project//libcxx:src/fstream.cpp",
        "@llvm-project//libcxx:src/ios.cpp",
        "@llvm-project//libcxx:src/ios.instantiations.cpp",
        "@llvm-project//libcxx:src/iostream.cpp",
        "@llvm-project//libcxx:src/locale.cpp",
        "@llvm-project//libcxx:src/ostream.cpp",
        "@llvm-project//libcxx:src/regex.cpp",
        "@llvm-project//libcxx:src/strstream.cpp",
        "@llvm-project//libcxx:src/filesystem/directory_entry.cpp",
        "@llvm-project//libcxx:src/filesystem/directory_iterator.cpp",
        "@llvm-project//libcxx:src/filesystem/operations.cpp",
        # new.cpp is intentionally EXCLUDED: when LIBCXX_BUILDING_LIBCXXABI=1,
        # operator new/delete comes from libcxxabi's stdlib_new_delete.cpp.
        # Including both would cause duplicate symbol errors.
        # "@llvm-project//libcxx:src/new.cpp",
        # Textual includes needed by above
        "@llvm-project//libcxx:textual_hdrs",
        "@llvm-project//libcxxabi:textual_hdrs",
    ],
    copts = [
        # See lgamma-prereq-override.h: makes _LIBCPP_GLIBC_PREREQ(2, 8) true
        # so <random>'s lgamma_r redeclaration matches our noexcept libc.
        "-include",
        "src/cerise/runtime/lgamma-prereq-override.h",
        "-faligned-allocation",
        "-std=c++23",
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
        "-Wno-unused-parameter",
        "-Wno-long-long",
        "-Wno-nullability-completeness",
        "-Wno-user-defined-literals",
        "-Wno-covered-switch-default",
        "-Wno-suggest-override",
        # libcxx can include its own headers via angle brackets
        "-I$(GENDIR)/src/cerise/runtime/libcxx_include",
    ],
    local_defines = [
        "NDEBUG",
        # Must agree with LIBC_NAMESPACE in the Fuchsia toolchain (set globally).
        # libcxx's hand-in-hand llvm-libc headers use LIBC_NAMESPACE.
        "LIBC_NAMESPACE=__llvm_libc_common_utils",
        "_LIBCPP_BUILDING_LIBRARY",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES",
        "LIBCXX_BUILDING_LIBCXXABI",
        "_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER",
    ],
    # alwayslink forces --whole-archive when this library is linked into a shared
    # library. Without it, the cc_binary -shared wrapper would produce an empty .so
    # because no symbols are referenced from "outside" the library at link time.
    alwayslink = True,
    includes = [],
    tags = ["manual"],
    deps = [
        # libcxx's own public headers + generated __config_site + __assertion_handler
        "@llvm-project//libcxx:headers",
        # libcxxabi header (for __cxa_* declarations used inside libcxx)
        "@llvm-project//libcxxabi:headers",
        # llvm-libc shared headers (hand-in-hand project)
        "@llvm-project//libc:libc_headers",
        # Our generated config overrides (@llvm-project//libcxx:headers also has
        # __config_site but for the exec platform; ours is for Fuchsia/musl).
        ":libcxx_generated_headers",
        # Fuchsia musl headers (provides <pthread.h>, <stdio.h>, etc.)
        "//src/upstream/fuchsia/zircon/third_party/ulib/musl:libc_headers",
    ],
)

# --- libcxxabi (C++ ABI library) for Fuchsia ---
# Provides: __cxa_* functions, std::exception/terminate, operator new/delete,
# vtable for __cxxabiv1::*__type_info, __gxx_personality_v0.
# Built as a static lib with alwayslink=True so it folds into libc++.so.
cc_library(
    name = "libcxxabi_fuchsia",
    srcs = [
        "@llvm-project//libcxxabi:src/cxa_aux_runtime.cpp",
        "@llvm-project//libcxxabi:src/cxa_default_handlers.cpp",
        # Real Itanium demangler (replaces the old nullptr stub —
        # the "sandbox-broken symlink" for ItaniumNodes.def no longer
        # reproduces: libcxxabi:textual_hdrs globs src/**/*.def, which stages
        # the demangle/ headers+def in the action sandbox, and the
        # -Ilibcxxabi/src below resolves "demangle/ItaniumDemangle.h").
        "@llvm-project//libcxxabi:src/cxa_demangle.cpp",
        "@llvm-project//libcxxabi:src/cxa_exception_storage.cpp",
        "@llvm-project//libcxxabi:src/cxa_guard.cpp",
        "@llvm-project//libcxxabi:src/cxa_handlers.cpp",
        "@llvm-project//libcxxabi:src/cxa_vector.cpp",
        "@llvm-project//libcxxabi:src/cxa_virtual.cpp",
        "@llvm-project//libcxxabi:src/stdlib_exception.cpp",
        "@llvm-project//libcxxabi:src/stdlib_stdexcept.cpp",
        "@llvm-project//libcxxabi:src/stdlib_typeinfo.cpp",
        "@llvm-project//libcxxabi:src/abort_message.cpp",
        "@llvm-project//libcxxabi:src/fallback_malloc.cpp",
        "@llvm-project//libcxxabi:src/private_typeinfo.cpp",
        "@llvm-project//libcxxabi:src/stdlib_new_delete.cpp",
        "@llvm-project//libcxxabi:src/cxa_exception.cpp",
        "@llvm-project//libcxxabi:src/cxa_personality.cpp",
        "@llvm-project//libcxxabi:src/cxa_thread_atexit.cpp",
    ],
    # Textual headers needed by cxa_personality.cpp, cxa_demangle.cpp etc.
    # libcxxabi:textual_hdrs includes src/**/*.h and src/**/*.def (including
    # demangle/ItaniumNodes.def); libcxx:textual_hdrs provides atomic_support.h.
    # These MUST be in textual_hdrs, not srcs: cc_library silently drops .def
    # files from srcs filegroups (unrecognized extension), which was the real
    # cause of the historical "ItaniumNodes.def not found" sandbox error.
    textual_hdrs = [
        "@llvm-project//libcxxabi:textual_hdrs",
        "@llvm-project//libcxx:textual_hdrs",
    ],
    copts = [
        "-std=c++23",
        "-fstrict-aliasing",
        "-funwind-tables",
        "-fvisibility=hidden",
        "-fvisibility-inlines-hidden",
        "-Wno-unused-parameter",
        "-Wno-long-long",
        "-I$(GENDIR)/src/cerise/runtime/libcxx_include",
        # cxa_exception.cpp includes "include/atomic_support.h" which is in
        # libcxx/src/include/. Add libcxx/src/ to the search path.
        "-Iexternal/llvm++llvm+llvm-project/libcxx/src",
        # cxa_demangle.cpp includes "demangle/ItaniumDemangle.h" via libcxxabi/src/.
        "-Iexternal/llvm++llvm+llvm-project/libcxxabi/src",
    ],
    local_defines = [
        "NDEBUG",
        "_LIBCPP_BUILDING_LIBRARY",
        "LIBCXX_BUILDING_LIBCXXABI",
        "_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER",
    ],
    alwayslink = True,
    tags = ["manual"],
    deps = [
        "@llvm-project//libcxx:headers",
        "@llvm-project//libcxxabi:headers",
        "@llvm-project//libunwind:headers",
        "@llvm-project//libc:libc_headers",
        ":libcxx_generated_headers",
        "//src/upstream/fuchsia/zircon/third_party/ulib/musl:libc_headers",
    ],
)

# --- libunwind for Fuchsia ---
# Provides: _Unwind_Resume, _Unwind_RaiseException, etc.
# Only x86_64-relevant sources (no ARM EHABI, no SEH, no SJLJ, no WASM).
cc_library(
    name = "libunwind_fuchsia",
    srcs = [
        "@llvm-project//libunwind:src/libunwind.cpp",
        "@llvm-project//libunwind:src/UnwindLevel1.c",
        "@llvm-project//libunwind:src/UnwindLevel1-gcc-ext.c",
        "@llvm-project//libunwind:src/UnwindRegistersRestore.S",
        "@llvm-project//libunwind:src/UnwindRegistersSave.S",
        # Internal headers that the assembly and C files include directly.
        # Listed in srcs so they're available in the action sandbox.
        "@llvm-project//libunwind:src/assembly.h",
        "@llvm-project//libunwind:src/config.h",
        "@llvm-project//libunwind:src/dwarf2.h",
        "@llvm-project//libunwind:src/libunwind_ext.h",
        "@llvm-project//libunwind:src/AddressSpace.hpp",
        "@llvm-project//libunwind:src/CompactUnwinder.hpp",
        "@llvm-project//libunwind:src/DwarfInstructions.hpp",
        "@llvm-project//libunwind:src/DwarfParser.hpp",
        "@llvm-project//libunwind:src/EHHeaderParser.hpp",
        "@llvm-project//libunwind:src/FrameHeaderCache.hpp",
        "@llvm-project//libunwind:src/RWMutex.hpp",
        "@llvm-project//libunwind:src/Registers.hpp",
        "@llvm-project//libunwind:src/UnwindCursor.hpp",
        "@llvm-project//libunwind:src/Unwind-EHABI.h",
        "@llvm-project//libunwind:src/shadow_stack_unwind.h",
    ],
    copts = [
        "-fno-exceptions",
        "-fno-rtti",
        "-fvisibility=hidden",
        "-Wno-unused-parameter",
        # libunwind's assembly and C source files include "assembly.h", "config.h",
        # etc. from the src/ directory. Add it as an -I relative to the execroot.
        "-Iexternal/llvm++llvm+llvm-project/libunwind/src",
    ],
    cxxopts = ["-std=c++23"],
    local_defines = [
        "_LIBUNWIND_IS_NATIVE_ONLY",
        "_NDEBUG",
        "_LIBUNWIND_USE_FRAME_HEADER_CACHE",
    ],
    alwayslink = True,
    tags = ["manual"],
    deps = [
        "@llvm-project//libunwind:headers",
    ],
)

# --- Host proof for the demangler ---
# Compiles the SAME vendored cxa_demangle.cpp (+ demangle/*.h + ItaniumNodes.def)
# that libcxxabi_fuchsia folds into libc++.so, for the host, and demangles known
# Itanium names. Guards the .def textual-header staging against regressing to
# the old nullptr stub. Runtime execution on Fuchsia is #34's boot gate.
cc_library(
    name = "cxa_demangle_host",
    testonly = True,
    srcs = [
        "@llvm-project//libcxxabi:src/cxa_demangle.cpp",
    ],
    copts = [
        "-std=c++20",
        "-Wno-unused-parameter",
    ],
    local_defines = ["NDEBUG"],
    textual_hdrs = ["@llvm-project//libcxxabi:textual_hdrs"],
    deps = ["@llvm-project//libcxxabi:headers"],
)

cc_test(
    name = "demangle_host_test",
    size = "small",
    srcs = ["demangle_host_test.cc"],
    # Static: the hermetic host toolchain's from-source C++ runtime archives
    # are non-PIC; cc_test's default dynamic link would fold them into a .so.
    linkstatic = True,
    deps = [":cxa_demangle_host"],
)

# libcxx shared library for the Fuchsia link sysroot.
# The .so exposes the standard C++ ABI symbols (std::string, std::vector, ...).
#
# libcxx_fuchsia has alwayslink = True, which forces --whole-archive when it's
# linked into this cc_binary. Without alwayslink, the -shared binary would be
# empty because no symbols are referenced "from outside" at link time.
cc_binary(
    name = "libc++.so",
    linkopts = [
        "-shared",
        "-Wl,-soname,libc++.so.1",
        # Do not add default runtime libs (avoids circular -lc++ dependency
        # and the missing libclang_rt.builtins issue).
        "-nodefaultlibs",
        # Fuchsia linker flags (clang++ target-triple + lld).
        "--target=x86_64-unknown-fuchsia",
        "-fuse-ld=lld",
        # Tell the linker these are OK as undefined (resolved at runtime from libc.so).
        "-Wl,--allow-shlib-undefined",
        # Suppress dependent-library specifiers embedded in object files (e.g. chrono.o
        # embeds "-lzircon"; libzircon resolves at runtime, not at libc++.so link time).
        "-Wl,--no-dependent-libraries",
    ],
    stamp = 0,
    tags = ["manual"],
    deps = [
        ":libcxx_fuchsia",
        ":libcxxabi_fuchsia",
        ":libunwind_fuchsia",
        # __divti3/__udivmodti4 for std::filesystem's int128 fs-time math
        # (no libclang_rt.builtins is staged at runtime).
        "//src/upstream/fuchsia/third_party/compiler-rt-builtins:int128_builtins",
        # under -Oz, libc++'s codegen additionally emits 128-bit shift
        # builtins (__ashlti3, …) that aren't in libc.so's exported surface, so a
        # consumer linking libc++.so hits `--no-allow-shlib-undefined: __ashlti3`.
        # The full compiler-rt builtins archive is pulled ON-DEMAND (only the ops
        # actually referenced link in) at hidden visibility, so it resolves every
        # opt-emitted 128-bit builtin without whack-a-mole and without exporting
        # them. Same archive the DFv2 drivers already link.
        "@llvm-project//compiler-rt:builtins",
    ],
)
