# Cerise Archivist query proof component (logging bring-up).
#
# archivist_reader logs a known structured record through fuchsia.logger.LogSink
# (offered from #archivist) and reads it back through fuchsia.diagnostics.
# ArchiveAccessor using the vendored diagnostics_reader client, emitting
# CERISE-ARCHIVIST-QUERY-OK only on a real accessor round-trip. See the realm
# root_dfv2acpi_diagnostics.cml and the qemu-x64-diagnostics product.
#
# Compiled at fuchsia:HEAD to match diagnostics_reader (its FORMAT=Cbor arm and the
# fuchsia.diagnostics FIDL binding are @available(added=HEAD)); the same api level
# the archivist lib/bin use.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:fuchsia_platform.bzl", "fuchsia_stripped")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS")
load("//build:component.bzl", "cerise_component")

package(default_visibility = ["//visibility:public"])

exports_files(["meta/archivist_reader.cml"])

rust_binary(
    name = "archivist_reader_bin",
    srcs = ["src/main.rs"],
    crate_name = "archivist_reader",
    edition = "2024",
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    rustc_flags = FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS + [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/lib/diagnostics/reader/rust:diagnostics_reader",
        "//src/upstream/fuchsia/src/lib/fuchsia:fuchsia",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "@crates//:anyhow",
        "@crates//:log",
    ],
)

fuchsia_stripped(
    name = "archivist_reader_bin_stripped.fuchsia",
    src = ":archivist_reader_bin",
)

cerise_component(
    name = "archivist_reader",
    manifest = "meta/archivist_reader.cml",
    binary = ":archivist_reader_bin_stripped.fuchsia",
    visibility = ["//visibility:public"],
)
