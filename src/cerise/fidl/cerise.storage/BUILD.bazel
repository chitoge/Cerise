# Cerise-original FIDL: cerise.storage — the file server's storage-status report,
# served by the file server (which owns the disk-claim decision) and consumed by the
# status_console (which owns no block capability at all). Rust bindings only: both
# ends are Rust. Mirrors the codegen wiring of //src/cerise/fidl/cerise.display.
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "cerise.storage",
    srcs = ["storage.fidl"],
    tags = ["manual"],
)

fidl_rust(
    name = "cerise.storage_rs",
    library = ":cerise.storage",
    tags = ["manual"],
)

# Server bindings for the fileserver, client bindings for the status_console.
rust_library(
    name = "fidl_cerise_storage",
    srcs = [":cerise.storage_rs"],
    crate_name = "fidl_cerise_storage",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
