// shutdown_shim — the minimal Cerise terminal shutdown broker. It runs in-process in
// component_manager via the `builtin_shutdown_shim` runner (no ELF binary; see
// src/cerise/stubs/shutdown_shim). It serves fuchsia.hardware.power.statecontrol.Admin
// (which a product may route only to its lifecycle transaction controller) and
// fuchsia.system.state.SystemStateTransition (which driver_manager reads at Stop time
// to learn the target power state), and it uses
// fuchsia.sys2.SystemController to drive component_manager's reverse-dependency topology
// teardown. Intentionally minimal versus upstream: no inspect/syslog/collaborative-reboot
// /suspend.
{
    // The runner is supplied by the `use` block below (from parent), not here — cmc
    // rejects declaring it in both places. An empty program is enough: the builtin
    // shutdown_shim runner ignores the program dictionary.
    program: {},
    capabilities: [
        { protocol: "fuchsia.hardware.power.statecontrol.Admin" },
        { protocol: "fuchsia.system.state.SystemStateTransition" },
    ],
    use: [
        {
            runner: "builtin_shutdown_shim",
            from: "parent",
        },
        { protocol: "fuchsia.sys2.SystemController" },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.hardware.power.statecontrol.Admin",
                "fuchsia.system.state.SystemStateTransition",
            ],
            from: "self",
        },
    ],
}
