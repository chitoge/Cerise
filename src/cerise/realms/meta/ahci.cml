// ahci leaf-driver — upstream AHCI/SATA block driver; exposes block.volume.Service.
{
    program: {
        runner: "driver",
        binary: "driver/ahci.so",
        bind: "meta/bind/ahci_bind.bindbc",
    },
    capabilities: [
        { service: "fuchsia.hardware.block.volume.Service" },
    ],
    use: [
        { protocol: "fuchsia.logger.LogSink" },
        { service: "fuchsia.hardware.pci.Service" },
    ],
    expose: [
        { service: "fuchsia.hardware.block.volume.Service", from: "self" },
    ],
}
