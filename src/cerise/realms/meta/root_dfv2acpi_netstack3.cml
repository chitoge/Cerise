// root_dfv2acpi_netstack3 — component_manager root for x64-netstack3 / qemu-x64-net.
// SHARD A base driver stack MINUS netdev_probe, PLUS netstack3 + netstack3_probe
// (SHARD C).
{
    include: ["root_driver_base.shard.cml"],
    children: [
        {
            name: "elf_runner",
            url: "fuchsia-boot:///elf_runner#meta/elf_runner.cm",
            startup: "eager",
        },
        {
            name: "cerise_logsink",
            url: "fuchsia-boot:///cerise_logsink#meta/cerise_logsink.cm",
            startup: "eager",
            environment: "#elf-env",
        },
        {
            name: "driver_manager_rust",
            url: "fuchsia-boot:///driver_manager_rust_dfv2platbus#meta/driver_manager_rust_dfv2acpi.cm",
            startup: "eager",
            environment: "#elf-env",
        },
        {
            name: "driver_index",
            url: "fuchsia-boot:///driver_index#meta/driver_index.cm",
            startup: "eager",
            environment: "#elf-env",
        },
        {
            name: "netstack3",
            url: "fuchsia-boot:///netstack3#meta/netstack3.cm",
            startup: "eager",
            environment: "#elf-env",
        },
        {
            name: "netstack3_probe",
            url: "fuchsia-boot:///netstack3_probe#meta/netstack3_probe.cm",
            startup: "eager",
            environment: "#elf-env",
        },
    ],

    offer: [
        {
            protocol: "fuchsia.logger.LogSink",
            from: "#cerise_logsink",
            to: ["#netstack3", "#netstack3_probe"],
        },

        { directory: "dev", from: "#driver_manager_rust", to: "#netstack3_probe", rights: ["r*"] },
        { protocol: "fuchsia.net.interfaces.admin.Installer", from: "#netstack3", to: "#netstack3_probe" },
        { protocol: "fuchsia.posix.socket.Provider", from: "#netstack3", to: "#netstack3_probe" },
        { protocol: "fuchsia.posix.socket.packet.Provider", from: "#netstack3", to: "#netstack3_probe" },
        { protocol: "fuchsia.net.interfaces.State", from: "#netstack3", to: "#netstack3_probe" },
    ],
}
