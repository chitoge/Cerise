// devfs-driver leaf — synthetic placeholder driver (program runner=driver, binary=
// meta/devfs-driver.cm) that declares+exposes the full set of hardware Service
// capabilities devfs aggregates. Started by driver_manager's own `driver` runner via
// a pending-token handshake (no dlopen).
{
    program: {
        runner: "driver",
        binary: "meta/devfs-driver.cm",
    },
    capabilities: [
        { service: "fuchsia.gpu.magma.DependencyInjectionService" },
        { service: "fuchsia.gpu.magma.PerformanceCounterService" },
        { service: "fuchsia.hardware.adc.Service" },
        { service: "fuchsia.hardware.audio.CodecConnectorService" },
        { service: "fuchsia.hardware.audio.CompositeConnectorService" },
        { service: "fuchsia.hardware.audio.DaiConnectorService" },
        { service: "fuchsia.hardware.audio.Device" },
        { service: "fuchsia.hardware.audio.StreamConfigConnectorInputService" },
        { service: "fuchsia.hardware.audio.StreamConfigConnectorOutputService" },
        { service: "fuchsia.hardware.ax88179.Service" },
        { service: "fuchsia.hardware.backlight.Service" },
        { service: "fuchsia.hardware.bluetooth.EmulatorService" },
        { service: "fuchsia.hardware.bluetooth.Service" },
        { service: "fuchsia.hardware.clock.measure.Service" },
        { service: "fuchsia.hardware.cpu.ctrl.Service" },
        { service: "fuchsia.hardware.display.Service" },
        { service: "fuchsia.hardware.fan.Service" },
        { service: "fuchsia.hardware.goldfish.AddressSpaceService" },
        { service: "fuchsia.hardware.goldfish.ControllerService" },
        { service: "fuchsia.hardware.goldfish.ControlService" },
        { service: "fuchsia.hardware.goldfish.SyncService" },
        { service: "fuchsia.hardware.gpu.mali.UtilsService" },
        { service: "fuchsia.hardware.hrtimer.Service" },
        { service: "fuchsia.hardware.i2c.Service" },
        { service: "fuchsia.hardware.input.Service" },
        { service: "fuchsia.hardware.light.LightService" },
        { service: "fuchsia.hardware.mediacodec.Service" },
        { service: "fuchsia.hardware.midi.Service" },
        { service: "fuchsia.hardware.network.Service" },
        { service: "fuchsia.hardware.pin.DebugService" },
        { service: "fuchsia.hardware.power.battery.Service" },
        { service: "fuchsia.hardware.power.charger.Service" },
        { service: "fuchsia.hardware.power.sensor.Service" },
        { service: "fuchsia.hardware.power.source.Service" },
        { service: "fuchsia.hardware.powersource.Service" },
        { service: "fuchsia.hardware.radar.Service" },
        { service: "fuchsia.hardware.registers.Service" },
        { service: "fuchsia.hardware.rtc.Service" },
        { service: "fuchsia.hardware.sdio.DriverService" },
        { service: "fuchsia.hardware.skipblock.Service" },
        { service: "fuchsia.hardware.spi.ControllerService" },
        { service: "fuchsia.hardware.tee.Service" },
        { service: "fuchsia.hardware.temperature.Service" },
        { service: "fuchsia.hardware.thermal.Service" },
        { service: "fuchsia.hardware.usb.device.Service" },
        { service: "fuchsia.hardware.usb.tester.Service" },
        { service: "fuchsia.hardware.usb.virtualbustest.Service" },
        { service: "fuchsia.input.report.Service" },
        { service: "fuchsia.lowpan.spinel.Service" },
        { service: "fuchsia.power.battery.InfoService" },
        { service: "fuchsia.services.test.Device" },
        { service: "fuchsia.tpm.Service" },
        { service: "fuchsia.wlan.device.Service" },
    ],
    expose: [
        { service: "fuchsia.gpu.magma.DependencyInjectionService", from: "self" },
        { service: "fuchsia.gpu.magma.PerformanceCounterService", from: "self" },
        { service: "fuchsia.hardware.adc.Service", from: "self" },
        { service: "fuchsia.hardware.audio.CodecConnectorService", from: "self" },
        { service: "fuchsia.hardware.audio.CompositeConnectorService", from: "self" },
        { service: "fuchsia.hardware.audio.DaiConnectorService", from: "self" },
        { service: "fuchsia.hardware.audio.Device", from: "self" },
        { service: "fuchsia.hardware.audio.StreamConfigConnectorInputService", from: "self" },
        { service: "fuchsia.hardware.audio.StreamConfigConnectorOutputService", from: "self" },
        { service: "fuchsia.hardware.ax88179.Service", from: "self" },
        { service: "fuchsia.hardware.backlight.Service", from: "self" },
        { service: "fuchsia.hardware.bluetooth.EmulatorService", from: "self" },
        { service: "fuchsia.hardware.bluetooth.Service", from: "self" },
        { service: "fuchsia.hardware.clock.measure.Service", from: "self" },
