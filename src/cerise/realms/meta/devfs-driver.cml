        { service: "fuchsia.hardware.goldfish.SyncService", from: "self" },
        { service: "fuchsia.hardware.gpu.mali.UtilsService", from: "self" },
        { service: "fuchsia.hardware.hrtimer.Service", from: "self" },
        { service: "fuchsia.hardware.i2c.Service", from: "self" },
        { service: "fuchsia.hardware.input.Service", from: "self" },
        { service: "fuchsia.hardware.light.LightService", from: "self" },
        { service: "fuchsia.hardware.mediacodec.Service", from: "self" },
        { service: "fuchsia.hardware.midi.Service", from: "self" },
        { service: "fuchsia.hardware.network.Service", from: "self" },
        { service: "fuchsia.hardware.pin.DebugService", from: "self" },
        { service: "fuchsia.hardware.power.battery.Service", from: "self" },
        { service: "fuchsia.hardware.power.charger.Service", from: "self" },
        { service: "fuchsia.hardware.power.sensor.Service", from: "self" },
        { service: "fuchsia.hardware.power.source.Service", from: "self" },
        { service: "fuchsia.hardware.powersource.Service", from: "self" },
        { service: "fuchsia.hardware.radar.Service", from: "self" },
        { service: "fuchsia.hardware.registers.Service", from: "self" },
        { service: "fuchsia.hardware.rtc.Service", from: "self" },
        { service: "fuchsia.hardware.sdio.DriverService", from: "self" },
        { service: "fuchsia.hardware.skipblock.Service", from: "self" },
        { service: "fuchsia.hardware.spi.ControllerService", from: "self" },
        { service: "fuchsia.hardware.tee.Service", from: "self" },
        { service: "fuchsia.hardware.temperature.Service", from: "self" },
        { service: "fuchsia.hardware.thermal.Service", from: "self" },
        { service: "fuchsia.hardware.usb.device.Service", from: "self" },
