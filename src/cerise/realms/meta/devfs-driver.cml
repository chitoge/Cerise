        { service: "fuchsia.power.battery.InfoService", from: "self" },
        { service: "fuchsia.services.test.Device", from: "self" },
        { service: "fuchsia.tpm.Service", from: "self" },
        { service: "fuchsia.wlan.device.Service", from: "self" },
    ],
