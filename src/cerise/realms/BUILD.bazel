# ── The virtual machine monitor, and the realm that hosts it ────────────────
#
# THIS IS THE FIRST MANIFEST HERE WHOSE PROGRAM IS NOT BUILT BY THIS TREE'S
# PUBLIC HALF, and that is worth saying out loud rather than discovering. Realm
# manifests are compiled manifest-only — the product stages the ELF separately —
# so the .cml can live here with no build dependency on the binary at all. It is
# here rather than next to its program for one concrete reason: route_check's
# manifest pool is exactly this directory, and the whole risk of adding a
# component that holds two kernel resources is a routing mistake. A manifest the
# linter cannot see is a manifest the linter cannot lint.
exports_files([
    "meta/cryogen_vmm.cml",
])

# The generated structured-config CLIENT library: cmc lowers the `config: {}`
# schema in the .cml into the .cm's ConfigSchema, and configc's `rust`
# subcommand emits `cryogen_vmm_config::Config` with a take_from_startup_handle()
# that FIDL-decodes the delivered config VMO. The VMM's component build depends
# on this; the legacy userboot build has no config VMO to read and does not.
fuchsia_structured_config_rust_lib(
    name = "cryogen_vmm_config",
    config_package_path = "meta/cryogen_vmm.cvf",
    crate_name = "cryogen_vmm_config",
    manifest = "meta/cryogen_vmm.cml",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The ordinary VM host stages this managed-only worker manifest. Its complete
# construction contract arrives in the launch VMO, so the structured config is
# deliberately limited to the version/digest binding for that VMO.
cerise_component(
    name = "cryogen_vmm_managed",
    config_package_path = "meta/cryogen_vmm_managed.cvf",
    manifest = "meta/cryogen_vmm_managed.cml",
)

fuchsia_structured_config_rust_lib_from_cm(
    name = "cryogen_vmm_managed_config",
    cm = ":cryogen_vmm_managed_manifest",
    crate_name = "cryogen_vmm_managed_config",
    visibility = ["//visibility:public"],
)

# The leaf. Unlike every manifest-only entry above it carries `config_values`,
# because its schema has to be delivered as a real .cvf for the component to
# start at all. The values are the synthetic gate's numbers — small on purpose:
# a four-page cache is what makes every run exercise eviction, and 512 MiB is
# what makes it boot in a minute. A product that wants a real operating-system
# guest stages a differently-valued instance rather than raising these, which
# would quietly change what the green gate proves.
cerise_component(
    name = "cryogen_vmm",
    config_values = {
        "guest_mem_mb": 512,
        "vm_id": "vm-guest",
        "vm_name": "Guest",
        "image_id": "image-none",
        "image_name": "No image",
        "vp_count": 1,
        "cryogen_cache_pages": 4,
        "spill_resident_pages": 64,
        "guest_deadline_secs": 45,
        "fw_line_budget": 2000,
        "firmware_path": "/pkg/data/MSVM.fd",
        # No store yet: the blank-disk state, which is a producible intermediate
        # rather than a failure. The block path turns this to "block".
        "store_source": "none",
        # The guest-image partition type GUID. Empty while store_source is
        # "none"; a "block" configuration must name one, and the program refuses
        # rather than defaulting, because a default GUID is a default answer to
        # "which partition is the guest's" and there is no safe default.
        "store_partition_guid": "",
        "store_path": "",
        "store_server": "",
        "vmi_enabled": False,
        "vmi_port": 50053,
        "hvsock_port": 50054,
        "display_port": 50055,
        "inventory_only": False,
        "autostart": True,
        # Zero version and empty digest is the compatibility shape the manifest
        # documents: no authenticated launch envelope, so the program must also
        # receive no launch startup handle, and it checks for exactly that. The
        # manifest gained these two fields without any of the four value sets
        # here gaining them, which made every console product's .cvf -- and so
        # every emulator boot gate over this VMM -- fail to build rather than
        # fail a test. Spelled out per value set rather than defaulted, because
        # a default here would silently un-bind a managed worker.
        "launch_spec_version": 0,
        "launch_spec_digest": "",
    },
    manifest = "meta/cryogen_vmm.cml",
)

# The SAME manifest, with the store turned on.
#
# `cerise_config_values` against `:cryogen_vmm_manifest` rather than a second
# `cerise_component`, and that is the whole point: the compiled `.cm` a product
# stages is byte-identical either way, so between the blank-disk product and the
# block-backed one there is exactly ONE variable — the delivered values. A second
# component target would have produced a second `.cm` with a second schema
# checksum and a second chance for the two to differ, and a gate whose red could
# then be attributed to either.
#
# The store partition's TYPE GUID is spelled here rather than defaulted in the
# program. `boot_layout::GUEST_IMAGE_TYPE_GUID` is the same value in the
# mixed-endian on-disk encoding, and `guest_image_guid_round_trips` re-derives
# those bytes from the GPT_GUID rules — but nothing checks that this string and
# that constant agree, by design: "which partition holds the guest image" is a
# deployment decision, and a program that defaulted it would be answering a
# question that is not its to answer. A wrong GUID here does not misbehave, it
# refuses (see the wrong-GUID gate in the VMM's own BUILD file).
cerise_config_values(
    name = "cryogen_vmm_block_cvf",
    cm = ":cryogen_vmm_manifest",
    tags = ["manual"],
    values = {
        "guest_mem_mb": 512,
        "vm_id": "vm-guest",
        "vm_name": "Guest",
        "image_id": "image-block",
        "image_name": "Guest image",
        "vp_count": 1,
        "cryogen_cache_pages": 4,
        "spill_resident_pages": 64,
        "guest_deadline_secs": 45,
        "fw_line_budget": 2000,
        "firmware_path": "/pkg/data/MSVM.fd",
        "store_source": "block",
        "store_partition_guid": "43A1F4C2-7B5E-4D18-9E3A-6F0C21D8B7A5",
        "store_path": "",
        "store_server": "",
        "vmi_enabled": False,
        "vmi_port": 50053,
        "hvsock_port": 50054,
        "display_port": 50055,
        "inventory_only": False,
        "autostart": True,
        "launch_spec_version": 0,
        "launch_spec_digest": "",
    },
    visibility = ["//visibility:public"],
)

# A real-guest diagnostic instance. It differs from the ordinary block-backed
# instance only in scale and in holding the cooperatively stopped VP for the
# read-only VMI service.
cerise_config_values(
    name = "cryogen_vmm_vmi_cvf",
