        "store_source": "block",
        "store_partition_guid": "C12A7328-F81F-11D2-BA4B-00A0C93EC93B",
        "store_path": "",
        "store_server": "",
        "vmi_enabled": False,
        "vmi_port": 50053,
        "hvsock_port": 50054,
        "display_port": 50055,
        "inventory_only": False,
        "autostart": True,
        "launch_spec_version": 0,
