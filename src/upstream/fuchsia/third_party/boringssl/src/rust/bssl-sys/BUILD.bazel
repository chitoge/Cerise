load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Small C shim providing error-handling utilities the bindings use (real
# upstream target: //third_party/boringssl/rust:rust-wrapper in GN).
#
# This target was not exercised in a full product build before
# (nvme_probe/ahci_probe pull in fuchsia-merkle via
# block_client, but not through a path that reaches this specific cc_library
# compilation unit in the exec/target-platform combination a full `//products:x64-pci`
# build uses). The manual `-I` copt alone doesn't stage BoringSSL's public
# `include/openssl/*.h` headers for Bazel's sandboxed/remote compilation - only a
# real `hdrs`/`deps` relationship does. Depending on `:crypto` (which already
# declares `includes = ["src/include"]` + `hdrs`) fixes both the include path
# (via includes propagation) and header staging, and lets us drop the fragile
# manual copt.
cc_library(
    name = "rust-wrapper",
    srcs = ["rust_wrapper.c"],
    hdrs = ["rust_wrapper.h"],
    deps = ["//src/upstream/fuchsia/third_party/boringssl:crypto"],
)

# Real bssl-sys: raw FFI bindings to BoringSSL, generated by upstream's own
# rust-bindgen pass (checked-in bindgen.rs, included via BINDGEN_RS_FILE since
# Bazel has no Cargo-style OUT_DIR — same mechanism upstream's own GN build
# uses for non-Cargo build systems, see rust/BUILD.gn's bssl-sys.config).
rust_library(
    name = "bssl-sys",
    srcs = [
        "bindgen.rs",  # local copy of ../../../rust/bssl-sys/bindgen.rs (same content,
                        # colocated here — Bazel's $(location) across a remote-execution
                        # sandbox didn't reliably stage a cross-package `data` file for
                        # rustc_env; same-package is the robust option).
        "src/lib.rs",
    ],
    crate_name = "bssl_sys",
    edition = "2018",
    rustc_env = {
        "BINDGEN_RS_FILE": "$(location :bindgen.rs)",
    },
    rustc_flags = [
        "--cfg=bindgen_rs_file",
        "--cfg=unsupported_inline_wrappers",
        "-Aimproper_ctypes",
    ],
    deps = [
        ":rust-wrapper",
        # Matches upstream's "bssl-crypto.no-ssl" flavor (rust/BUILD.gn) — links
        # only libcrypto, not libssl/TLS, avoiding a dependency nothing here needs.
        "//src/upstream/fuchsia/third_party/boringssl:crypto",
    ],
)
