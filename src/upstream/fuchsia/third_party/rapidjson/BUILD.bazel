# Cerise BUILD (authored locally) — rapidjson (header-only JSON), third_party submodule
# vendored at the Fuchsia pin (a8bf9c8). Used by zxtest's json-reporter.
load("@rules_cc//cc:defs.bzl", "cc_library")
