        "source/components/utilities/utxfmutex.c",
    ],
    hdrs = glob(["source/include/**/*.h"]),
    # ACPICA internal files use #include "acpi.h" (relative to source/include/)
    includes = ["source/include"],
    # Re-export headers as <acpica/...> for external consumers
    strip_include_prefix = "source/include",
    include_prefix = "acpica",
    copts = [
        "-fno-strict-aliasing",
        "-Wno-conversion",
        "-Wno-extern-c-compat",
        "-Wno-implicit-fallthrough",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-null-pointer-arithmetic",
        "-Wno-null-pointer-subtraction",
        "-Wno-unused-but-set-parameter",
        "-Wno-unused-but-set-variable",
    ],
    local_defines = ["_ALL_SOURCE"],
    # ACPI_MISALIGNMENT_NOT_SUPPORTED propagates to consumers: byte-by-byte memory
    # accesses avoid UBSan misaligned-load warnings in ACPICA macros.
    defines = ["ACPI_MISALIGNMENT_NOT_SUPPORTED"],
    deps = [
        # Provides include/acfuchsia.h (ACPICA Fuchsia OS config) selected by
        # platform/acenv.h when __Fuchsia__ is defined.
        "//src/upstream/fuchsia/zircon/system/ulib/acpica:acpica_config",
    ],
)

# Cerise: expose ACPICA headers at the repo-relative path so consumers that include
# them as "third_party/acpica-migrating/src/source/include/<h>" (e.g. board/lib/acpi's
# power-resource.h) resolve, in addition to the <acpica/...> form above.
cc_library(
    name = "acpica_repo_headers",
    hdrs = glob(["source/include/**/*.h"]),
    strip_include_prefix = "/src/upstream/fuchsia",
)
