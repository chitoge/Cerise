load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ACPICA core static library (upstream Fuchsia fork at 087633dc).
#
# Source layout:
#   source/include/   — ACPICA headers; ACPICA's own files use #include "acpi.h"
#   source/common/    — shared ACPI ID/table strings (not OS-specific)
#   source/components — core ACPI implementation (dispatcher, tables, parser…)
#
# External consumers use <acpica/acpi.h>; strip_include_prefix + include_prefix
# remap source/include/ → acpica/ in Bazel's generated include tree.
# ACPICA's own .c files use bare #include "acpi.h" found via includes=["source/include"].
#
# acpica_config (zircon/system/ulib/acpica) provides acfuchsia.h selected by
# platform/acenv.h via #include "acfuchsia.h" (falls back to the search path).
cc_library(
    name = "acpica",
    srcs = [
        "source/common/ahids.c",
        "source/common/ahpredef.c",
        "source/common/ahtable.c",
        "source/common/dmtbdump.c",
        "source/common/dmtbdump3.c",
        "source/common/dmtbinfo.c",
        "source/common/dmtbinfo1.c",
        "source/common/dmtbinfo2.c",
        "source/common/dmtbinfo3.c",
