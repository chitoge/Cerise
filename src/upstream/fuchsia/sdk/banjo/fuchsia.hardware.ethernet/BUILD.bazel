# Vendored-at-baseline (Fuchsia @ 0f3c21bc) banjo library fuchsia.hardware.ethernet.
# Upstream: sdk/banjo/fuchsia.hardware.ethernet/{BUILD.gn,ethernet.fidl}.
#
# This is the legacy DFv1 EthernetImpl/EthernetIfc banjo protocol consumed by the
# realtek-8111 driver (src/upstream/fuchsia/src/connectivity/ethernet/drivers/realtek-8111).
# The FIDL depends only on zx (the vdso), identical to fuchsia.hardware.pciroot, so this
# BUILD is a direct clone of that library's BUILD.bazel with the names retargeted.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/fidl:fidl.bzl", "fidl_banjo_c", "fidl_banjo_cpp", "fidl_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.hardware.ethernet",
    srcs = ["ethernet.fidl"],
    available = "fuchsia:HEAD",
    deps = [
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_banjo_c(
    name = "fuchsia.hardware.ethernet_banjo_c_gen",
    library = ":fuchsia.hardware.ethernet",
)

# Copy the generated header to the canonical include path:
# <fuchsia/hardware/ethernet/c/banjo.h>
genrule(
    name = "ethernet_banjo_hdr",
    srcs = [":fuchsia.hardware.ethernet_banjo_c_gen"],
    outs = ["fuchsia/hardware/ethernet/c/banjo.h"],
    cmd = "cp $< $@",
)

cc_library(
    name = "fuchsia.hardware.ethernet_banjo_c",
    hdrs = [":ethernet_banjo_hdr"],
    # Strip the package prefix so the header is available as
    # <fuchsia/hardware/ethernet/c/banjo.h>
    strip_include_prefix = "/src/upstream/fuchsia/sdk/banjo/fuchsia.hardware.ethernet",
)

# C++ banjo (ddktl protocol/client classes), consumed by the realtek-8111 driver as
# fuchsia.hardware.ethernet_banjo_cpp. The cpp header includes "banjo-internal.h", so both
# the cpp and cpp_internal backends are generated and placed side by side.
fidl_banjo_cpp(
    name = "fuchsia.hardware.ethernet_banjo_cpp_gen",
    library = ":fuchsia.hardware.ethernet",
    backend = "cpp",
)

fidl_banjo_cpp(
    name = "fuchsia.hardware.ethernet_banjo_cpp_internal_gen",
    library = ":fuchsia.hardware.ethernet",
    backend = "cpp_internal",
)

genrule(
    name = "ethernet_banjo_cpp_hdr",
    srcs = [":fuchsia.hardware.ethernet_banjo_cpp_gen"],
    outs = ["fuchsia/hardware/ethernet/cpp/banjo.h"],
    cmd = "cp $< $@",
)

genrule(
    name = "ethernet_banjo_cpp_internal_hdr",
    srcs = [":fuchsia.hardware.ethernet_banjo_cpp_internal_gen"],
    outs = ["fuchsia/hardware/ethernet/cpp/banjo-internal.h"],
    cmd = "cp $< $@",
)

cc_library(
    name = "fuchsia.hardware.ethernet_banjo_cpp",
    hdrs = [
        ":ethernet_banjo_cpp_hdr",
        ":ethernet_banjo_cpp_internal_hdr",
    ],
    strip_include_prefix = "/src/upstream/fuchsia/sdk/banjo/fuchsia.hardware.ethernet",
    deps = [
        # The C++ banjo header wraps the C banjo header + ddktl protocol classes.
        ":fuchsia.hardware.ethernet_banjo_c",
        "//src/upstream/fuchsia/src/lib/ddktl:ddktl",
    ],
)

# Compile probe: ensure the generated C++ banjo header actually compiles.
cc_library(
    name = "banjo_cpp_probe",
    srcs = ["banjo_cpp_probe.cc"],
    tags = ["manual"],
    deps = [":fuchsia.hardware.ethernet_banjo_cpp"],
)
