# Bazel integration for this imported target. fidl_base headers
# (e.g. <lib/fidl/txn_header.h>) used by the loader-service message lib / ldso.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    deps = ["//src/upstream/fuchsia/zircon/system/public:public"],
)

# the FIDL wire-format runtime (decode/validate/format) — a core runtime
# component. Compiles against the assembled sysroot (compile-only, like
# net-types) to confirm the C++ runtime path is open independent of libc.so.
cc_library(
    name = "fidl_base",
    srcs = glob(["*.cc", "*.c"], allow_empty = True),
    tags = ["manual"],
    deps = [
        ":headers",
        "//sdk/lib/fit:fit",
        "//src/upstream/fuchsia/sdk/lib/stdcompat:stdcompat",
        "//src/upstream/fuchsia/sdk/lib/utf-utils:utf-utils",
        "//src/upstream/fuchsia/zircon/system/public:public",
        "//src/upstream/fuchsia/zircon/system/ulib/zircon-internal:headers",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)
