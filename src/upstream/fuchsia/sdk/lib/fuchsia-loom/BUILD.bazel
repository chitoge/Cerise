# Authored locally for Cerise. fuchsia-loom: thin wrapper
# around the loom concurrency testing tool. In non-loom mode (our case), the
# crate provides empty macros only — dep of fidl_next_protocol.
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fuchsia_loom",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_loom",
    edition = "2024",
    deps = ["@crates//:futures"],
)
