load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])
# client_includes (a CML-shard expect_includes) is manifest-validation, not a code dep — omitted.
cc_library(
    name = "cpp",
    srcs = glob(["*.cc"], exclude = ["*test*"], allow_empty = True),
    hdrs = glob(["**/*.h"], allow_empty = True),
    strip_include_prefix = "/src/upstream/fuchsia/sdk",
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.inspect:fuchsia.inspect_cpp",
        "//src/upstream/fuchsia/sdk/lib/async:async-cpp",
        "//src/upstream/fuchsia/sdk/lib/component/incoming/cpp:cpp",
        "//src/upstream/fuchsia/sdk/lib/component/outgoing/cpp:cpp",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/zircon/system/ulib/inspect:inspect",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)
