# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# bumped to HEAD -- fuchsia.net.routes.admin
# is wholly @available(added=HEAD)-gated in real upstream FIDL (the whole
# library does not exist below HEAD at all), and has no consumer in this tree
# other than the netstack3 _ext crates being vendored in the networking import. Safe by
# construction: nothing at level 30 could resolve this library either way.
fidl_library(
    name = "fuchsia.net.routes.admin",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fuchsia.net_head",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fuchsia.net.resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.routes:fuchsia.net.routes",
    ],
)

fidl_rust(
    name = "fuchsia.net.routes.admin_rs",
    library = ":fuchsia.net.routes.admin",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_net_routes_admin",
    srcs = [":fuchsia.net.routes.admin_rs"],
    crate_name = "fidl_fuchsia_net_routes_admin",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net_head",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fidl_fuchsia_net_resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.routes:fidl_fuchsia_net_routes",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)

# "_rust_flex" pure re-export -- see
# fuchsia.net's `flex_fuchsia_net` target comment for the full rationale.
genrule(
    name = "flex_fuchsia_net_routes_admin_rs_gen",
    outs = ["flex_fuchsia_net_routes_admin.rs"],
    cmd = "printf 'pub use fidl_fuchsia_net_routes_admin::*;\\n' > $(OUTS)",
    tags = ["manual"],
)

rust_library(
    name = "flex_fuchsia_net_routes_admin",
    srcs = [":flex_fuchsia_net_routes_admin_rs_gen"],
    crate_name = "flex_fuchsia_net_routes_admin",
    edition = "2024",
    tags = ["manual"],
    deps = [":fidl_fuchsia_net_routes_admin"],
)
