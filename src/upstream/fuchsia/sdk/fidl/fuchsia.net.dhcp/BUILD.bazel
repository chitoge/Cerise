# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# bumped to HEAD directly - netstack3's main.rs needs
# fidl_fuchsia_net_dhcp::ClientProviderMarker (@available(added=HEAD)); no C++
# or other Rust consumer of this library exists (grepped both bindings).
fidl_library(
    name = "fuchsia.net.dhcp",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fuchsia.net",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin",
    ],
)

fidl_rust(
    name = "fuchsia.net.dhcp_rs",
    library = ":fuchsia.net.dhcp",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_net_dhcp",
    srcs = [":fuchsia.net.dhcp_rs"],
    crate_name = "fidl_fuchsia_net_dhcp",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces.admin:fidl_fuchsia_net_interfaces_admin",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
