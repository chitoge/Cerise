# Authored locally for Cerise (board/driver x86 closure).
load("//build/fidl:fidl.bzl", "fidl_bind_library_cpp", "fidl_cpp", "fidl_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.hardware.sysmem",
    srcs = glob(["*.fidl"], allow_empty = True),
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2",
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_cpp(
    name = "fuchsia.hardware.sysmem_cpp",
    library = ":fuchsia.hardware.sysmem",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_cpp",
    ],
)

fidl_bind_library_cpp(
    name = "fuchsia.hardware.sysmem_bindlib_cpp_gen",
    library = ":fuchsia.hardware.sysmem",
)

genrule(
    name = "fuchsia.hardware.sysmem_bindlib_hdr",
    srcs = [":fuchsia.hardware.sysmem_bindlib_cpp_gen"],
    outs = ["bind/fuchsia/hardware/sysmem/cpp/bind.h"],
    cmd = "cp $< $@",
)

cc_library(
    name = "fuchsia.hardware.sysmem_bindlib_cpp",
    hdrs = [":fuchsia.hardware.sysmem_bindlib_hdr"],
    strip_include_prefix = "/src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.sysmem",
)
