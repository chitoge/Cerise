# Bazel integration for this imported target. Generated FIDL library
# + C++ bindings for the zxio/fdio dependency closure.
load("//build/fidl:fidl.bzl", "fidl_cpp", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.posix.socket",
    srcs = glob(["*.fidl"], allow_empty = True),
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fuchsia.net",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fuchsia.net.resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.tcp:fuchsia.net.tcp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.posix:fuchsia.posix",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.unknown:fuchsia.unknown",
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_cpp(
    name = "fuchsia.posix.socket_cpp",
    library = ":fuchsia.posix.socket",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fuchsia.net_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.tcp:fuchsia.net.tcp_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.posix:fuchsia.posix_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.unknown:fuchsia.unknown_cpp",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)

# Rust binding, real production dep of netstack3's
# common_deps (//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust in
# BUILD.gn).
fidl_rust(
    name = "fuchsia.posix.socket_rs",
    library = ":fuchsia.posix.socket",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_posix_socket",
    srcs = [":fuchsia.posix.socket_rs"],
    crate_name = "fidl_fuchsia_posix_socket",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fidl_fuchsia_net_interfaces",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fidl_fuchsia_net_resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.tcp:fidl_fuchsia_net_tcp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.posix:fidl_fuchsia_posix",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.unknown:fidl_fuchsia_unknown",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)

# netstack3's own bindings/socket.rs and socket/stream.rs
# use ProviderRequest::StreamSocketWithOptions/DatagramSocketWithOptions and
# StreamSocketRequest::SetMark/GetMark/GetCookie - all @available(added=HEAD) in
# posix_socket.fidl, absent at this library's shared level-30 IR. Cannot bump the
# shared `fuchsia.posix.socket`/`_cpp`/`fidl_fuchsia_posix_socket` targets: real,
# confirmed boot-critical consumers are zxio/fdio, but ONLY via the `_cpp` binding
# (grepped - neither uses the Rust one) - so the plain Rust target has no other
# real consumer either, yet we still leave it byte-for-byte untouched and add a
# separate parallel target, same established precedent as fuchsia.net_head /
# fuchsia.net.tcp_head, for consistency and to avoid ever needing to reason about
# whether a future Rust consumer might pick up the plain target unexpectedly.
fidl_library(
    name = "fuchsia.posix.socket_head",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fuchsia.net",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fuchsia.net.resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.tcp:fuchsia.net.tcp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.posix:fuchsia.posix",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.unknown:fuchsia.unknown",
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_rust(
    name = "fuchsia.posix.socket_head_rs",
    library = ":fuchsia.posix.socket_head",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_posix_socket_head",
    srcs = [":fuchsia.posix.socket_head_rs"],
    crate_name = "fidl_fuchsia_posix_socket",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net_head",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fidl_fuchsia_net_interfaces",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fidl_fuchsia_net_resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.tcp:fidl_fuchsia_net_tcp_head",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.posix:fidl_fuchsia_posix",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.unknown:fidl_fuchsia_unknown",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
