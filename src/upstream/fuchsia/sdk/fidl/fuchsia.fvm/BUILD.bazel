# @available(added=HEAD) at the library level - matches this project's established
# fix pattern for HEAD-gated FIDL. Real path in upstream is
# src/storage/fvm/fidl/fuchsia.fvm; staged under sdk/fidl here to match this
# project's convention of keeping all FIDL libraries under one root, same as
# fuchsia.fxfs/fuchsia.fs.startup before it.
load("//build/fidl:fidl.bzl", "fidl_cpp", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.fvm",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_cpp(
    name = "fuchsia.fvm_cpp",
    library = ":fuchsia.fvm",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)

fidl_rust(
    name = "fuchsia.fvm_rs",
    library = ":fuchsia.fvm",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_fvm",
    srcs = [":fuchsia.fvm_rs"],
    crate_name = "fidl_fuchsia_fvm",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
