# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# the whole library is @available(added=HEAD)
# in its real source -- no level-30 version to preserve. Direct bump is safe:
# only fuchsia.net.sockets (also vendored alongside this)
# references this target at all.
fidl_library(
    name = "fuchsia.net.udp",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
    ],
)

fidl_rust(
    name = "fuchsia.net.udp_rs",
    library = ":fuchsia.net.udp",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_net_udp",
    srcs = [":fuchsia.net.udp_rs"],
    crate_name = "fidl_fuchsia_net_udp",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
