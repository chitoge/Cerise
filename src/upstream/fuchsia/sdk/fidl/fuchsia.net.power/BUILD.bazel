# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# bumped to HEAD directly - netstack3's WakeGroupProvider FIDL usage needs
# WakeGroupProviderRequestStream (@available(added=HEAD)); no C++ or other Rust
# consumer of this library exists (grepped both bindings).
fidl_library(
    name = "fuchsia.net.power",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fuchsia.net.resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.power.system:fuchsia.power.system",
    ],
)

fidl_rust(
    name = "fuchsia.net.power_rs",
    library = ":fuchsia.net.power",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_net_power",
    srcs = [":fuchsia.net.power_rs"],
    crate_name = "fidl_fuchsia_net_power",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.resources:fidl_fuchsia_net_resources",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.power.system:fidl_fuchsia_power_system",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
