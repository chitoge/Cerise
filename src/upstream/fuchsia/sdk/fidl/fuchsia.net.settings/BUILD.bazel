# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.net.settings",
    srcs = glob(["*.fidl"], allow_empty = True),
    # settings.fidl declares the whole library `@available(added=HEAD)` — at the
    # default level 30 fidlc drops every declaration. No other real consumer
    # besides netstack3-bindings exists for this library, so it's safe to compile
    # the whole thing at HEAD directly rather than a parallel target.
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin",
    ],
)

fidl_rust(
    name = "fuchsia.net.settings_rs",
    library = ":fuchsia.net.settings",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_net_settings",
    srcs = [":fuchsia.net.settings_rs"],
    crate_name = "fidl_fuchsia_net_settings",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
        # netstack3 imports the HEAD instance of interfaces.admin throughout;
        # fuchsia.net.settings composes interfaces.admin.Configuration in its own
        # API, so its Rust codegen must link the SAME instance (same rationale
        # as fuchsia.net.root's identical swap).
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces.admin:fidl_fuchsia_net_interfaces_admin_head",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
