# Bazel integration for this imported target. Generated FIDL library
# + Rust bindings for the netstack3-bindings dependency closure.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# bumped to HEAD -- fuchsia.ebpf
# is wholly @available(added=HEAD)-gated in real upstream FIDL, and its only two
# consumers in this tree are fuchsia.net.filter (also bumped to HEAD in this
# same pass) and fuchsia.net.debug (itself wholly HEAD-gated, no consumers of
# its own). Safe by construction: nothing at level 30 could resolve this
# library either way.
fidl_library(
    name = "fuchsia.ebpf",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_rust(
    name = "fuchsia.ebpf_rs",
    library = ":fuchsia.ebpf",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_ebpf",
    srcs = [":fuchsia.ebpf_rs"],
    crate_name = "fidl_fuchsia_ebpf",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)

# "_rust_flex" pure re-export -- see
# fuchsia.net's `flex_fuchsia_net` target comment for the full rationale.
genrule(
    name = "flex_fuchsia_ebpf_rs_gen",
    outs = ["flex_fuchsia_ebpf.rs"],
    cmd = "printf 'pub use fidl_fuchsia_ebpf::*;\\n' > $(OUTS)",
    tags = ["manual"],
)

rust_library(
    name = "flex_fuchsia_ebpf",
    srcs = [":flex_fuchsia_ebpf_rs_gen"],
    crate_name = "flex_fuchsia_ebpf",
    edition = "2024",
    tags = ["manual"],
    deps = [":fidl_fuchsia_ebpf"],
)
