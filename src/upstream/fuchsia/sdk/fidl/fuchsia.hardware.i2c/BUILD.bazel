# Authored locally for Cerise. board/lib/acpi: i2c_cpp + i2c_bindlib_cpp.
load("//build/fidl:fidl.bzl", "fidl_bind_library_cpp", "fidl_cpp", "fidl_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

fidl_library(name = "fuchsia.hardware.i2c", srcs = glob(["*.fidl"], allow_empty = True), tags = ["manual"], deps = ["//src/upstream/fuchsia/zircon/vdso:zx"])
fidl_cpp(name = "fuchsia.hardware.i2c_cpp", library = ":fuchsia.hardware.i2c", tags = ["manual"], deps = ["//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",])
fidl_bind_library_cpp(name = "fuchsia.hardware.i2c_bindlib_cpp_gen", library = ":fuchsia.hardware.i2c")
genrule(name = "i2c_bindlib_cpp_hdr", srcs = [":fuchsia.hardware.i2c_bindlib_cpp_gen"], outs = ["bind/fuchsia/hardware/i2c/cpp/bind.h"], cmd = "cp $< $@")
cc_library(name = "fuchsia.hardware.i2c_bindlib_cpp", hdrs = [":i2c_bindlib_cpp_hdr"], strip_include_prefix = "/src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.i2c")
