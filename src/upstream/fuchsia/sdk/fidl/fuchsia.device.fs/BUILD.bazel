load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/fidl:fidl.bzl", "fidl_cpp", "fidl_hlcpp", "fidl_library", "fidl_rust")

package(default_visibility = ["//visibility:public"])
fidl_library(
    name = "fuchsia.device.fs",
    srcs = glob(["*.fidl"], allow_empty = True),
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io",
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)
fidl_cpp(
    name = "fuchsia.device.fs_cpp",
    library = ":fuchsia.device.fs",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)
fidl_hlcpp(
    name = "fuchsia.device.fs_hlcpp",
    library = ":fuchsia.device.fs",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/lib/fidl/hlcpp:hlcpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_hlcpp",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)

fidl_rust(
    name = "fuchsia.device.fs_rs",
    library = ":fuchsia.device.fs",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_device_fs",
    srcs = [":fuchsia.device.fs_rs"],
    crate_name = "fidl_fuchsia_device_fs",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fidl_fuchsia_io",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
