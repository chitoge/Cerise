library fuchsia.driver.registrar;

using fuchsia.url;
using zx;

/// A service for dynamically registering drivers at runtime.
@discoverable
open protocol DriverRegistrar {
    flexible Register(struct {
        driver_url fuchsia.url.Url;
    }) -> () error zx.Status;
};
