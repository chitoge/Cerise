# Authored locally for Cerise. board/lib/acpi: spi_bindlib_cpp; spi.businfo dep.
load("//build/fidl:fidl.bzl", "fidl_bind_library_cpp", "fidl_cpp", "fidl_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

fidl_library(name = "fuchsia.hardware.spi", srcs = glob(["*.fidl"], allow_empty = True), tags = ["manual"], available = "fuchsia:HEAD", deps = ["//src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.sharedmemory:fuchsia.hardware.sharedmemory", "//src/upstream/fuchsia/zircon/vdso:zx"])
fidl_cpp(name = "fuchsia.hardware.spi_cpp", library = ":fuchsia.hardware.spi", tags = ["manual"], deps = ["//src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.sharedmemory:fuchsia.hardware.sharedmemory_cpp", "//src/upstream/fuchsia/sdk/lib/fidl/cpp:natural",
        "//src/upstream/fuchsia/sdk/lib/fidl/cpp/wire:wire",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",])
fidl_bind_library_cpp(name = "fuchsia.hardware.spi_bindlib_cpp_gen", library = ":fuchsia.hardware.spi")
genrule(name = "spi_bindlib_cpp_hdr", srcs = [":fuchsia.hardware.spi_bindlib_cpp_gen"], outs = ["bind/fuchsia/hardware/spi/cpp/bind.h"], cmd = "cp $< $@")
cc_library(name = "fuchsia.hardware.spi_bindlib_cpp", hdrs = [":spi_bindlib_cpp_hdr"], strip_include_prefix = "/src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.spi")
