# trace ulib headers. Compiled implementation deferred (driver_runtime
# uses -DNTRACE so trace macros are no-ops; only declarations needed at build).
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/zircon/system/ulib/trace-engine:headers",
        "//src/upstream/fuchsia/zircon/system/public:public",
        "//src/upstream/fuchsia/sdk/lib/async:async",
        "//src/upstream/fuchsia/sdk/lib/async:async-cpp",
        "//sdk/lib/fit:fit",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)
