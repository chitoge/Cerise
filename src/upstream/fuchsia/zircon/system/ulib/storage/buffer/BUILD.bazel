# Vendored for Cerise fshost Phase 1. Real upstream
# zircon/system/ulib/storage/buffer, adapted from its own real BUILD.bazel with
# target paths rewritten to this project's convention.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "buffer",
    srcs = [
        "array_buffer.cc",
        "block_buffer.cc",
        "blocking_ring_buffer.cc",
        "owned_vmoid.cc",
        "resizeable_vmo_buffer.cc",
        "ring_buffer.cc",
        "vmo_buffer.cc",
    ],
    hdrs = [
        "include/storage/buffer/array_buffer.h",
        "include/storage/buffer/block_buffer.h",
        "include/storage/buffer/block_buffer_view.h",
        "include/storage/buffer/blocking_ring_buffer.h",
        "include/storage/buffer/owned_vmoid.h",
        "include/storage/buffer/resizeable_vmo_buffer.h",
        "include/storage/buffer/ring_buffer.h",
        "include/storage/buffer/vmo_buffer.h",
        "include/storage/buffer/vmoid_registry.h",
    ],
    includes = ["include"],
    copts = ["-Isrc/upstream/fuchsia"],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
        "//src/upstream/fuchsia/sdk/lib/fdio:fdio",
        "//src/upstream/fuchsia/zircon/system/ulib/fzl",
        "//src/upstream/fuchsia/zircon/system/ulib/storage/operation",
        "//src/upstream/fuchsia/zircon/system/ulib/zx",
        "//src/upstream/fuchsia/zircon/third_party/ulib/safemath",
    ],
)
