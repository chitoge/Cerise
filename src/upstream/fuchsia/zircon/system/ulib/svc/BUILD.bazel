# Cerise BUILD (authored locally). zircon svc::Outgoing — a vfs-backed outgoing dir
# helper (lib/svc/outgoing.h). Used (vestigially) by board/lib/acpi's device.h.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "svc",
    srcs = ["outgoing.cc"],
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//src/upstream/fuchsia/sdk/lib/async:async",
        "//src/upstream/fuchsia/sdk/lib/fdio:fdio",
        "//src/upstream/fuchsia/src/storage/lib/vfs/cpp:cpp",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
    ],
)
