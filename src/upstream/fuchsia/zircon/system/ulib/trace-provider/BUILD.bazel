load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Cerise: -DNTRACE matches this project's established convention for every other
# trace/trace-engine consumer (network-device, driver_runtime) — tracing macros compile
# to no-ops, but the provider registration/session machinery itself is real, vendored,
# unmodified upstream source (gracefully no-ops at runtime when no trace-manager service
# is present, which is real, designed Fuchsia behavior, not something faked here).
cc_library(
    name = "trace-provider",
    srcs = [
        "export.h",
        "fdio_connect.cc",
        "handler.cc",
        "provider_impl.cc",
        "provider_impl.h",
        "provider_with_fdio.cc",
        "session.cc",
        "session.h",
        "start.cc",
        "utils.cc",
        "utils.h",
    ],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    copts = [
        "-DNTRACE",
        "-Isrc/upstream/fuchsia",
    ],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_cpp",
        "//src/upstream/fuchsia/sdk/lib/async-loop:async-loop-cpp",
        "//src/upstream/fuchsia/sdk/lib/async-loop:async-loop-default",
        "//src/upstream/fuchsia/sdk/lib/fdio",
        "//src/upstream/fuchsia/zircon/system/ulib/sync",
        "//src/upstream/fuchsia/zircon/system/ulib/trace:headers",
        "//src/upstream/fuchsia/zircon/system/ulib/trace-engine",
    ],
)
