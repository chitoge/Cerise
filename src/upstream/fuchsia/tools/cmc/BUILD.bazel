# Cerise BUILD for cmc (the component manifest compiler), authored locally; upstream is GN.
# Mirrors upstream tools/cmc/BUILD.gn lib+binary split. Host tool (exec config) — no
# FUCHSIA_API_LEVEL rustc_flags (host binaries don't take target api-level flags).
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cmc_lib",
    srcs = [
        "src/compile.rs",
        "src/debug_print_cm.rs",
        "src/format.rs",
        "src/include.rs",
        "src/lib.rs",
        "src/merge.rs",
        "src/opts.rs",
        "src/reference.rs",
        "src/util.rs",
    ],
    crate_name = "cmc",
    edition = "2024",
    # reference.rs has #[cfg(fuchsia_api_level_*)] gates against cm_rust's surface;
    # the whole dep closure (cm_rust/cml/cm_types) is compiled at HEAD, so cmc_lib
    # must match HEAD or the ComponentManifest::Cm match is non-exhaustive.
    rustc_flags = FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS,
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.decl:fidl_fuchsia_component_decl",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.data:fidl_fuchsia_data",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/tempfile-ext:tempfile-ext",
        "//src/upstream/fuchsia/src/sys/lib/cm_rust:cm_rust",
        "//src/upstream/fuchsia/src/sys/lib/cm_types:cm_types",
        "//src/upstream/fuchsia/tools/lib/cml:cml",
        "//src/upstream/fuchsia/tools/lib/reference_doc:reference_doc",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:serde_json",
        "@crates//:serde_json5",
        "@crates//:strsim",
        "@crates//:tempfile",
    ],
)

rust_binary(
    name = "cmc",
    srcs = ["src/main.rs"],
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":cmc_lib",
        "@crates//:clap",
    ],
)
