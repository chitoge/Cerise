# Vendored for Cerise (Phase 2 logging: Archivist). measure-tape hlcpp backend:
# emits the HLCPP measuring-tape module. Not used by Cerise (we only generate
# the Rust binding), but main.go imports it, so it is built as part of the tool.
# Upstream: //tools/fidl/measure-tape/src/hlcpp.
load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "hlcpp",
    srcs = ["hlcpp.go"],
    importpath = "go.fuchsia.dev/fuchsia/tools/fidl/measure-tape/src/hlcpp",
    deps = [
        "//src/upstream/fuchsia/tools/fidl/lib/fidlgen:fidlgen",
        "//src/upstream/fuchsia/tools/fidl/measure-tape/src/measurer:measurer",
        "//src/upstream/fuchsia/tools/fidl/measure-tape/src/utils:utils",
    ],
)
