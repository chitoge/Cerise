load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fuchsia-zbi-abi",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_zbi_abi",
    edition = "2024",
    # upstream declares zbi_zither.rust dep but marks it unused — omit it.
    rustc_flags = ["-Aunused-crate-dependencies"],
    proc_macro_deps = ["@crates//:num-derive"],
    deps = [
        "@crates//:num-traits",
        "@crates//:zerocopy",
    ],
)
