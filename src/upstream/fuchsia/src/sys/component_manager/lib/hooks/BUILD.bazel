        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/lib/fuchsia-sync:fuchsia-sync",
        "//src/upstream/fuchsia/src/sys/component_manager/lib/errors:errors",
        "//src/upstream/fuchsia/src/sys/lib/cm_types:cm_types",
        "//src/upstream/fuchsia/src/sys/lib/moniker:moniker",
        "//src/upstream/fuchsia/src/sys/lib/runtime_capabilities:runtime_capabilities",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:log",
