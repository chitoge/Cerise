        "//src/upstream/fuchsia/src/sys/lib/component_id_index:component_id_index",
        "//src/upstream/fuchsia/src/sys/lib/moniker:moniker",
        "//src/upstream/fuchsia/src/sys/lib/routing:routing",
        "//src/upstream/fuchsia/src/sys/lib/runtime_capabilities:runtime_capabilities",
        "@crates//:anyhow",
        "@crates//:thiserror",
