    name = "ring-buffer",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ring_buffer",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "//src/upstream/fuchsia/src/lib/fuchsia-runtime:fuchsia-runtime",
        "@crates//:futures",
        "@crates//:thiserror",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/upstream/fuchsia/sdk/rust/zx:zx",
        ],
        "//conditions:default": [],
    }),
