load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Non-test target only ("for-testing" feature/data_for_testing.rs not vendored -
# fshost's real production binary never enables that feature).
rust_library(
    name = "vmo_backed",
    srcs = [
        "src/data.rs",
        "src/lib.rs",
    ],
    crate_name = "vmo_backed_block_server",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.storage.block:fidl_fuchsia_storage_block",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/storage/lib/block_server:block_server",
        "//src/upstream/fuchsia/src/storage/lib/fs_management/rust:fs_management",
        "//src/upstream/fuchsia/src/lib/fuchsia-async",
        "@crates//:anyhow",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
