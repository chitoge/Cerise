# Unmodified upstream fxfs_macros: proc-macros for src/serialized_types (fxfs's core
# on-disk versioned-struct machinery). Required for fxfs to compile, not optional.
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "fxfs_macros",
    srcs = ["macros.rs"],
    crate_name = "fxfs_macros",
    edition = "2024",
    deps = [
        "@crates//:proc-macro2",
        "@crates//:quote",
        "@crates//:syn",
    ],
)
