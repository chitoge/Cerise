# fshost gate, final piece: the real `fxfs` server component binary.
# Unmodified upstream `src/main.rs` — a thin wrapper around `fxfs_platform::component::
# Component` (already vendored, Phase 3), which is where the real Vnode/fuchsia.io
# serving + format/mount/fsck entrypoint logic lives. `fshost` dynamically spawns this
# component to actually mount a discovered Fxfs volume.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:fuchsia_platform.bzl", "fuchsia_stripped")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "fxfs_bin",
    srcs = ["src/main.rs"],
    crate_name = "fxfs_bin",
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_HEAD_RUSTC_FLAGS + [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/runtime/rust:fuchsia-inspect-runtime",
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/upstream/fuchsia/src/lib/fuchsia:fuchsia",
        "//src/upstream/fuchsia/src/lib/fuchsia-runtime:fuchsia-runtime",
        "//src/upstream/fuchsia/src/lib/trace/rust/trace-provider:trace-provider",
        "//src/upstream/fuchsia/src/storage/fxfs:fxfs",
        "//src/upstream/fuchsia/src/storage/fxfs/platform:platform",
        "@crates//:anyhow",
    ],
)

fuchsia_stripped(
    name = "fxfs_bin_stripped.fuchsia",
    src = ":fxfs_bin",
)
