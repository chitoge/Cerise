# Vendored for Cerise fshost Phase 1. Real upstream src/storage/fvm
# (Fuchsia Volume Manager) — a direct, non-test dependency of
# src/storage/lib/fs_management/cpp (confirmed via its real BUILD.gn), not an
# optional standalone tool. `client.cc`/`client.h` is upstream's own separate
# `source_set("client")` — kept as its own target here too, since it has a
# narrower dep surface than the full library.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "client",
    srcs = ["client.cc"],
    hdrs = ["client.h"],
    copts = ["-Isrc/upstream/fuchsia"],
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/storage/lib/block_client/cpp:interface",
        "//src/upstream/fuchsia/zircon/system/public:public",
    ],
)

cc_library(
    name = "fvm",
    srcs = [
        "format.cc",
        "fvm.cc",
        "fvm_check.cc",
        "metadata.cc",
        "metadata_buffer.cc",
        "sparse_reader.cc",
        "vmo_metadata_buffer.cc",
    ],
    hdrs = [
        "format.h",
        "fvm.h",
        "fvm_check.h",
        "fvm_sparse.h",
        "metadata.h",
        "metadata_buffer.h",
        "sparse_reader.h",
        "vmo_metadata_buffer.h",
    ],
    copts = ["-Isrc/upstream/fuchsia"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fit",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
        "//src/upstream/fuchsia/sdk/lib/stdcompat",
        "//src/upstream/fuchsia/src/lib/digest",
        "//src/upstream/fuchsia/src/lib/uuid",
        "//src/upstream/fuchsia/src/storage/gpt",
        "//src/upstream/fuchsia/src/storage/lib/block_client/cpp:cpp",
        "//src/upstream/fuchsia/zircon/system/ulib/fbl",
        "//src/upstream/fuchsia/zircon/system/ulib/fzl",
        "//src/upstream/fuchsia/zircon/system/ulib/range",
        "//src/upstream/fuchsia/zircon/system/ulib/sync",
        "//src/upstream/fuchsia/zircon/system/ulib/zx",
        "//src/upstream/fuchsia/zircon/third_party/ulib/lz4",
        "//src/upstream/fuchsia/zircon/third_party/ulib/safemath",
    ],
)
