# fshost: real upstream fshost (src/storage/fshost) - filesystem lifecycle
# manager. exports_files preserved from real upstream (assembly .cml shards);
# structured-config + binary targets authored locally (Cerise addition, not
# upstream - upstream builds this via GN's fuchsia_structured_config_rust_lib +
# rustc_binary).
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//build:structured_config.bzl", "fuchsia_structured_config_rust_lib_from_cm")
load("//build/fidl:fidl.bzl", "fidl_cpp", "fidl_library", "fidl_rust")
load("//bazel:fuchsia_platform.bzl", "fuchsia_stripped")

exports_files(
    [
        "meta/fshost.bootstrap_shard.cml",
        "meta/fshost.root_shard.cml",
        "meta/base_fshost.cml",
        "meta/config.cml",
        "meta/fxblob_fshost_base.shard.cml",
        "meta/non_gpt_fshost.shard.cml",
        "meta/gpt_fshost.shard.cml",
        "meta/fvm_fshost.cml",
        "meta/fvm_fshost_base.shard.cml",
        "meta/eng_fshost.cml",
        "meta/non_eng_fshost.cml",
        "meta/recovery_fshost.cml",
        "meta/non_recovery_fshost.cml",
        "meta/core_fshost.cml",
        "meta/block_relay_child.shard.cml",
        "meta/fxblob_fshost.cml",
        "meta/provision_fxfs_fshost.shard.cml",
    ],
)

# fshost_config: the REAL structured-config client crate, generated by configc
# from the compiled fshost realm manifest (//src/cerise/realms:fshost_manifest,
# whose `config: {}` schema this crate's checksum is derived from — the former
# parallel meta/fshost_for_config_lib.cml schema copy is retired). main.rs calls
# Config::take_from_startup_handle() for real: the values arrive in the
# ComponentConfigVmo populated from the staged meta/fshost.cvf (
# burn-down of the fshost config literal).
fuchsia_structured_config_rust_lib_from_cm(
    name = "fshost_config_rust",
    cm = "//src/cerise/realms:fshost_manifest",
    crate_name = "fshost_config",
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

fidl_library(
    name = "fuchsia.fshost.fxfsprovisioner",
    srcs = ["src/fxfsprovisioner.fidl"],
    available = "fuchsia:HEAD",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io",
        "//src/upstream/fuchsia/zircon/vdso:zx",
    ],
)

fidl_rust(
    name = "fuchsia.fshost.fxfsprovisioner_rs",
    library = ":fuchsia.fshost.fxfsprovisioner",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_fshost_fxfsprovisioner",
    srcs = [":fuchsia.fshost.fxfsprovisioner_rs"],
    crate_name = "fidl_fuchsia_fshost_fxfsprovisioner",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fidl_fuchsia_io",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)

# Real upstream fshost binary. main.rs calls
# `fshost_config::Config::take_from_startup_handle()` for real (the former
# literal-Config patch was burned down in):
# the values arrive in the ComponentConfigVmo component_manager populates from
# the staged meta/fshost.cvf, whose data lives in //bundles:config_defaults.bzl.
rust_binary(
    name = "fshost",
    srcs = [
        "src/config.rs",
        "src/crypt.rs",
        "src/crypt/fxfs.rs",
        "src/device.rs",
        "src/device/constants.rs",
        "src/environment.rs",
        "src/environment/fvm_container.rs",
        "src/environment/fxfs_container.rs",
        "src/environment/publisher.rs",
        "src/fxblob.rs",
        "src/inspect.rs",
        "src/main.rs",
        "src/manager.rs",
        "src/matcher.rs",
        "src/matcher/config_matcher.rs",
        "src/ramdisk.rs",
        "src/recovery.rs",
        "src/service.rs",
        "src/watcher.rs",
    ],
    edition = "2024",
    # fshost is a plain CFv2 ELF binary needing a full link (crt startup, libzircon) — the
    # same --sysroot mechanism every other Cerise-authored rust_binary (nvme_probe,
    # netdev_probe, ahci_probe) uses; without it the linker falls back to the exec
    # platform's libc/crt and fails with "cannot open Scrt1.o"/"unable to find -lzircon".
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    rustc_flags = [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        ":fidl_fuchsia_fshost_fxfsprovisioner",
        ":fshost_config_rust",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.fvm:fidl_fuchsia_fvm",
        "//src/upstream/fuchsia/src/storage/fshost/config:config",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.boot:fidl_fuchsia_boot",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component:fidl_fuchsia_component",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.decl:fidl_fuchsia_component_decl",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.device:fidl_fuchsia_device",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.framework:fidl_fuchsia_driver_framework",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.token:fidl_fuchsia_driver_token",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.feedback:fidl_fuchsia_feedback",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.fshost:fidl_fuchsia_fshost",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.block.volume:fidl_fuchsia_hardware_block_volume",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fidl_fuchsia_io",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.process.lifecycle:fidl_fuchsia_process_lifecycle",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.storage.block:fidl_fuchsia_storage_block",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.storage.partitions:fidl_fuchsia_storage_partitions",
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/runtime/rust:fuchsia-inspect-runtime",
        "//src/upstream/fuchsia/src/lib/fdio/rust:fdio",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/fuchsia:fuchsia",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "//src/upstream/fuchsia/src/lib/fuchsia-component:fuchsia-component",
        "//src/upstream/fuchsia/src/lib/fuchsia-fs:fuchsia-fs",
        "//src/upstream/fuchsia/src/lib/fuchsia-runtime:fuchsia-runtime",
        "//src/upstream/fuchsia/src/storage/crypt/policy:crypt_policy",
        "//src/upstream/fuchsia/src/storage/crypt/zxcrypt:zxcrypt_crypt",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.fs.startup:fidl_fuchsia_fs_startup",
        "//src/upstream/fuchsia/src/storage/lib/key-bag:key-bag",
        "//src/upstream/fuchsia/src/storage/lib/pseudo_fs:pseudo_fs_static",
        "//src/upstream/fuchsia/src/storage/lib/vfs/rust:vfs_static",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.fxfs:fidl_fuchsia_fxfs",
        "//src/upstream/fuchsia/src/storage/lib/block_server/vmo_backed:vmo_backed",
        "//src/upstream/fuchsia/src/storage/lib/fs_management/rust:fs_management",
        "//src/upstream/fuchsia/src/sys/pkg/fidl/fuchsia.update.verify:fidl_fuchsia_update_verify",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:itertools",
        "@crates//:log",
        "@crates//:scopeguard",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:uuid",
        "@crates//:zerocopy",
        "@crates//:zstd",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)

fuchsia_stripped(
    name = "fshost_stripped.fuchsia",
    src = ":fshost",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
