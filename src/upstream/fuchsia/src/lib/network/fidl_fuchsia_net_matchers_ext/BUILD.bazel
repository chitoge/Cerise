# Bazel integration for this imported target. netstack3-bindings
# dependency: real fidl_fuchsia_net_matchers_ext (BUILD.gn target
# "fidl_fuchsia_net_matchers_ext", non-fdomain instantiation only -- Cerise has
# no remote-FDomain use case, "_fdomain" sibling target intentionally not vendored).
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fidl_fuchsia_net_matchers_ext",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    crate_name = "fidl_fuchsia_net_matchers_ext",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net_common",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.interfaces:fidl_fuchsia_net_interfaces_common",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.matchers:fidl_fuchsia_net_matchers_common",
        "//src/upstream/fuchsia/src/connectivity/lib/net-types:net-types",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/network/fidl_fuchsia_net_ext:fidl_fuchsia_net_ext",
        "//src/upstream/fuchsia/src/lib/network/fidl_fuchsia_net_interfaces_ext:fidl_fuchsia_net_interfaces_ext",
        "@crates//:thiserror",
    ],
)
