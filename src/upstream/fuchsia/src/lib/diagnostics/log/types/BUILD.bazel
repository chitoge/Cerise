load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "diagnostics_log_types",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "diagnostics_log_types",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
    tags = ["manual"],
    deps = [
        # API level >= 27: use fuchsia.diagnostics.types
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.diagnostics.types:fidl_fuchsia_diagnostics_types",
        "@crates//:log",
        "@crates//:thiserror",
    ],
)

# Phase 1 logging (Archivist import): serde-enabled variant of the log types
# (upstream GN target `:types-serde`, crate `diagnostics_log_types_serde`).
# Its crate root is src/serde_lib.rs, which re-exports Severity and provides
# serde (de)serializers. Required by diagnostics-data (which does
# `pub use diagnostics_log_types_serde::Severity`). Additive: does not change
# the base `:diagnostics_log_types` target above.
rust_library(
    name = "diagnostics_log_types_serde",
    srcs = [
        "src/serde_ext.rs",
        "src/serde_lib.rs",
    ],
    crate_name = "diagnostics_log_types_serde",
    crate_root = "src/serde_lib.rs",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
    tags = ["manual"],
    deps = [
        ":diagnostics_log_types",
        "@crates//:serde",
    ],
)
