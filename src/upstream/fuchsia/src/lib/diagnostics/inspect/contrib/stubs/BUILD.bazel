    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/upstream/fuchsia/src/lib/fuchsia-sync",
        "@crates//:anyhow",
        "@crates//:flyweights",
        "@crates//:futures",
        "@crates//:log",
    ],
)
