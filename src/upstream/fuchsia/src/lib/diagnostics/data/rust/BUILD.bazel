# Authored locally for Cerise (Phase 1 logging: Archivist import).
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# diagnostics_data: the diagnostics schema (logs + inspect data) shared by
# Archivist, diagnostics-reader, and any ArchiveAccessor client.
#
# Upstream depends on the domain-object-free FIDL bindings
# fuchsia.diagnostics_rust_common / fuchsia.inspect_rust_common. Following the
# tree's established `_common` precedent (see fuchsia.net's BUILD.bazel, where
# the `_common` crate is a `pub use <full>::*` re-export), we alias the full
# bindings to those crate names here, since the full binding is a superset that
# exposes every `_common` symbol this crate uses (DataType, Selector,
# DEFAULT_TREE_NAME).
rust_library(
    name = "diagnostics_data",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "diagnostics_data",
    edition = "2024",
    tags = ["manual"],
    aliases = {
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.diagnostics:fidl_fuchsia_diagnostics": "fidl_fuchsia_diagnostics_common",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.inspect:fidl_fuchsia_inspect": "fidl_fuchsia_inspect_common",
        "//src/upstream/fuchsia/src/lib/diagnostics/selectors:diagnostics_selectors": "selectors",
    },
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.diagnostics:fidl_fuchsia_diagnostics",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.inspect:fidl_fuchsia_inspect",
        "//src/upstream/fuchsia/src/lib/diagnostics/hierarchy/rust:diagnostics_hierarchy",
        "//src/upstream/fuchsia/src/lib/diagnostics/log/types:diagnostics_log_types_serde",
        "//src/upstream/fuchsia/src/lib/diagnostics/selectors:diagnostics_selectors",
        "//src/upstream/fuchsia/src/sys/lib/moniker:moniker",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:flyweights",
        "@crates//:itertools",
        "@crates//:serde",
        "@crates//:termion",
        "@crates//:thiserror",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/upstream/fuchsia/sdk/fidl/fuchsia.logger:fidl_fuchsia_logger",
            "//src/upstream/fuchsia/sdk/rust/zx:zx",
        ],
        "//conditions:default": [],
    }),
)
