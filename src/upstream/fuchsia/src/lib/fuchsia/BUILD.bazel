load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fuchsia",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
    tags = ["manual"],
    proc_macro_deps = [
        "//src/upstream/fuchsia/src/lib/fuchsia/macro:fuchsia_macro",
    ],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.diagnostics.types:fidl_fuchsia_diagnostics_types",
        "//src/upstream/fuchsia/src/lib/diagnostics/log/rust:diagnostics_log",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "@crates//:argh",
        "@crates//:libc",
        "@crates//:log",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/upstream/fuchsia/sdk/lib/scheduler/rust:fuchsia_scheduler",
            "//src/upstream/fuchsia/src/lib/diagnostics/fuchsia-async-inspect:fuchsia-async-inspect",
        ],
        "//conditions:default": [],
    }),
)
