# Authored locally for Cerise. fidl_next: umbrella crate
# that re-exports fidl_next_bind, fidl_next_codec, and fidl_next_protocol.
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fidl_next",
    srcs = ["src/lib.rs"],
    crate_name = "fidl_next",
    edition = "2024",
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust_next/fidl_next_bind:fidl_next_bind",
        "//src/upstream/fuchsia/src/lib/fidl/rust_next/fidl_next_codec:fidl_next_codec",
        "//src/upstream/fuchsia/src/lib/fidl/rust_next/fidl_next_protocol:fidl_next_protocol",
    ],
)
