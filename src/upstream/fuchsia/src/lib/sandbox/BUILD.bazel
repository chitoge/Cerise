# Authored locally for Cerise.
# sandbox: type-safe wrappers for fuchsia.component.sandbox FIDL APIs.
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sandbox",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "sandbox",
    edition = "2024",
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.sandbox:fidl_fuchsia_component_sandbox",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fidl_fuchsia_io",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/fuchsia-component:fuchsia-component",
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "@crates//:thiserror",
    ],
)
