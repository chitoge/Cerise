# Bazel integration for this imported target.
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_proc_macro")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "from-enum-derive",
    srcs = ["src/macro.rs"],
    crate_name = "from_enum_derive",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "@crates//:darling",
        "@crates//:proc-macro2",
        "@crates//:quote",
        "@crates//:syn",
    ],
)

rust_library(
    name = "from-enum",
    srcs = ["src/lib.rs"],
    crate_name = "from_enum",
    edition = "2024",
    tags = ["manual"],
    proc_macro_deps = [":from-enum-derive"],
    deps = [],
)
