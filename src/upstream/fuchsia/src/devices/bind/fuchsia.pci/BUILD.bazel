# Authored locally for Cerise. board/lib/acpi: fuchsia.pci_cpp.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/fidl:fidl.bzl", "bind_library_cpp")

package(default_visibility = ["//visibility:public"])

exports_files(["fuchsia.pci.bind"])

bind_library_cpp(name = "fuchsia.pci_cpp_gen", src = "fuchsia.pci.bind")
genrule(name = "fuchsia.pci_cpp_hdr", srcs = [":fuchsia.pci_cpp_gen"], outs = ["bind/fuchsia/pci/cpp/bind.h"], cmd = "cp $< $@")
cc_library(name = "fuchsia.pci_cpp", hdrs = [":fuchsia.pci_cpp_hdr"], strip_include_prefix = "/src/upstream/fuchsia/src/devices/bind/fuchsia.pci")
