# Authored locally for Cerise. Base bind library; fuchsia_cpp.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/fidl:fidl.bzl", "bind_library_cpp")

package(default_visibility = ["//visibility:public"])

bind_library_cpp(name = "fuchsia_cpp_gen", src = "fuchsia.bind")
genrule(name = "fuchsia_cpp_hdr", srcs = [":fuchsia_cpp_gen"], outs = ["bind/fuchsia/cpp/bind.h"], cmd = "cp $< $@")
cc_library(name = "fuchsia_cpp", hdrs = [":fuchsia_cpp_hdr"], strip_include_prefix = "/src/upstream/fuchsia/src/devices/bind/fuchsia")
