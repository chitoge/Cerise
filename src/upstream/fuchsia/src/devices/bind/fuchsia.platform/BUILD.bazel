load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/fidl:fidl.bzl", "bind_library_cpp")
package(default_visibility = ["//visibility:public"])

exports_files(["fuchsia.platform.bind"])

bind_library_cpp(
    name = "fuchsia.platform_cpp_gen",
    src = "fuchsia.platform.bind",
)
genrule(
    name = "platform_cpp_hdr",
    srcs = [":fuchsia.platform_cpp_gen"],
    outs = ["bind/fuchsia/platform/cpp/bind.h"],
    cmd = "cp $< $@",
)
cc_library(
    name = "fuchsia.platform_cpp",
    hdrs = [":platform_cpp_hdr"],
    strip_include_prefix = "/src/upstream/fuchsia/src/devices/bind/fuchsia.platform",
)
