# Authored locally for Cerise.
# bind: Fuchsia driver bind rule compiler and interpreter. The test module (used by
# bindc's compile/debug/test commands) is restored now that valico is vendored.
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "bind",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bind",
    edition = "2021",
    compile_data = glob(["*.json"]),
    proc_macro_deps = [
        "@crates//:num-derive",
    ],
    deps = [
        "@crates//:bitfield",
        "@crates//:byteorder",
        "@crates//:nom",
        "@crates//:nom_locate",
        "@crates//:num-traits",
        "@crates//:regex-lite",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:valico",
    ],
)
