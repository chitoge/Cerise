# Cerise BUILD for src/devices/lib/iommu (authored locally; upstream is GN).
# The x86 IOMMU helper used by the ACPI board driver (board/lib/acpi) to construct BTIs
# from ACPI DMAR tables. Sources use repo-relative quote includes
# ("src/devices/lib/iommu/..."), exposed via strip_include_prefix like the acpica OSL.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "iommu-x86",
    srcs = ["iommu-x86.cc"],
    hdrs = [
        "iommu-x86.h",
        "iommu.h",
    ],
    strip_include_prefix = "/src/upstream/fuchsia",
    deps = [
        "//sdk/lib/fit:fit",
        "//src/upstream/fuchsia/sdk/lib/stdcompat:stdcompat",
        "//src/upstream/fuchsia/src/lib/ddk:ddk",
        "//src/upstream/fuchsia/third_party/acpica-migrating/src:acpica",
        "//src/upstream/fuchsia/zircon/system/ulib/fbl:fbl",
        "//src/upstream/fuchsia/zircon/system/ulib/zx:headers",
        "//src/upstream/fuchsia/zircon/system/public:public",
    ],
)
