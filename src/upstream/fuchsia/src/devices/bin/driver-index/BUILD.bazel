# Authored locally for Cerise.
# driver_index: matches device nodes to drivers using bind rules.
# Divergences: rkyv stripped (no fast-boot escrow); BlobId→Hash alias;
#   boot/base resolver connections conditioned on non-empty driver lists;
#   driver test realm code path removed.
#
# ONE binary since the config burn-down: the boot-driver list is BOARD
# DATA delivered in meta/driver_index.cvf (cerise_board.boot_drivers -> product
# rule -> configc), so the historical per-boot-driver-list binary variants
# (acpi/pci/match, each linking a stub config crate with a compile-time vec![]
# behind crate features) are gone along with the stub crate itself.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")
load("//build:structured_config.bzl", "fuchsia_structured_config_rust_lib_from_cm")

package(default_visibility = ["//visibility:public"])

# driver_index_config: the REAL structured-config client crate, generated by
# configc from the compiled driver_index realm manifest (whose `config: {}`
# schema this crate's checksum is derived from). Config::take_from_startup_handle()
# reads the ComponentConfigVmo populated from the staged meta/driver_index.cvf
# and fails loud (checksum mismatch / missing-handle panic) if delivery breaks.
fuchsia_structured_config_rust_lib_from_cm(
    name = "driver_index_config",
    cm = "//src/cerise/realms:driver_index_acpi_manifest",
    crate_name = "driver_index_config",
    tags = ["manual"],
)

rust_binary(
    name = "driver_index",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/test_common.rs"],
    ),
    crate_name = "driver_index",
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS + [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    deps = [
        ":driver_index_config",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.decl:fidl_fuchsia_component_decl",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.resolution:fidl_fuchsia_component_resolution",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.component.sandbox:fidl_fuchsia_component_sandbox",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.data:fidl_fuchsia_data",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.development:fidl_fuchsia_driver_development",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.framework:fidl_fuchsia_driver_framework",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.index:fidl_fuchsia_driver_index",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.registrar:fidl_fuchsia_driver_registrar",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.process.lifecycle:fidl_fuchsia_process_lifecycle",
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/devices/lib/bind:bind",
        "//src/upstream/fuchsia/src/lib/detect-stall:detect-stall",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/fuchsia:fuchsia",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "//src/upstream/fuchsia/src/lib/fuchsia-component:fuchsia-component",
        "//src/upstream/fuchsia/src/lib/fuchsia-runtime:fuchsia-runtime",
        "//src/upstream/fuchsia/src/lib/fuchsia-sync:fuchsia-sync",
        "//src/upstream/fuchsia/src/lib/sandbox:sandbox",
        "//src/upstream/fuchsia/src/sys/lib/cm_rust:cm_rust",
        "//src/upstream/fuchsia/src/sys/lib/cm_types:cm_types",
        "//src/upstream/fuchsia/src/sys/lib/mem_util:mem_util",
        "//src/upstream/fuchsia/src/sys/pkg/lib/fuchsia-hash:fuchsia-hash",
        "//src/upstream/fuchsia/src/sys/pkg/lib/fuchsia-pkg:fuchsia-pkg",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:log",
        "@crates//:rand",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
