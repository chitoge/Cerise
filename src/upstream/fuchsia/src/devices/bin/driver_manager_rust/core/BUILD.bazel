load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "driver_start_gate",
    srcs = ["src/start_coordination.rs"],
    crate_name = "driver_start_gate",
    compile_data = ["src/driver_runner.rs"],
    edition = "2024",
    deps = ["@crates//:futures"],
)

rust_test(
    name = "driver_start_gate_test",
    size = "small",
    crate = ":driver_start_gate",
    edition = "2024",
)

rust_library(
    name = "driver_manager_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "driver_manager_core",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
