load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "driver_manager_removal_deadline",
    srcs = ["src/removal_deadline.rs"],
    crate_name = "driver_manager_removal_deadline",
    edition = "2024",
)

rust_library(
    name = "driver_manager_shutdown",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "driver_manager_shutdown",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
    tags = ["manual"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.diagnostics:fidl_fuchsia_diagnostics",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.kernel:fidl_fuchsia_kernel",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.process.lifecycle:fidl_fuchsia_process_lifecycle",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.system.state:fidl_fuchsia_system_state",
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/devices/bin/driver_manager_rust/driver_host:driver_manager_driver_host",
        "//src/upstream/fuchsia/src/devices/bin/driver_manager_rust/types:driver_manager_types",
        "//src/upstream/fuchsia/src/devices/lib/mexec_boot:mexec_boot",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "//src/upstream/fuchsia/src/lib/fuchsia-component:fuchsia-component",
        "//src/upstream/fuchsia/src/lib/fuchsia-runtime:fuchsia-runtime",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:log",
        "@crates//:rand",
    ],
)

rust_test(
    name = "driver_manager_removal_deadline_test",
    size = "small",
    crate = ":driver_manager_removal_deadline",
    edition = "2024",
)
