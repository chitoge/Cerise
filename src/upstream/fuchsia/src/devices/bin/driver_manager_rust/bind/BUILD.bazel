load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build:fuchsia_rust_api_level.bzl", "FUCHSIA_API_LEVEL_30_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "driver_manager_bind",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "driver_manager_bind",
    edition = "2024",
    rustc_flags = FUCHSIA_API_LEVEL_30_RUSTC_FLAGS,
    tags = ["manual"],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    deps = [
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.development:fidl_fuchsia_driver_development",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.framework:fidl_fuchsia_driver_framework",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.driver.index:fidl_fuchsia_driver_index",
        "//src/upstream/fuchsia/sdk/rust/zx:zx",
        "//src/upstream/fuchsia/src/devices/bin/driver_manager_rust/node:driver_manager_node",
        "//src/upstream/fuchsia/src/devices/bin/driver_manager_rust/types:driver_manager_types",
        "//src/upstream/fuchsia/src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "//src/upstream/fuchsia/src/lib/fuchsia-async:fuchsia-async",
        "@crates//:futures",
        "@crates//:log",
    ],
)
