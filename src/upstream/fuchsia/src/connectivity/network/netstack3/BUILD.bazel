        "src/bindings/util/result_ext.rs",
        "src/bindings/util/scope_ext.rs",
        "src/bindings/waker.rs",
        "src/main.rs",
    ],
    crate_root = "src/main.rs",
    edition = "2024",
    # Plain CFv2 ELF binary needing a full link (crt startup, libzircon) - same
    # --sysroot mechanism every other Cerise-authored rust_binary uses (fshost,
    # nvme_probe, netdev_probe, ahci_probe); without it the linker falls back to
    # the exec platform's libc/crt and fails with "cannot open Scrt1.o"/"unable to
    # find -lzircon".
    compile_data = ["//src/cerise/sysroot:fuchsia_link_sysroot"],
    rustc_flags = [
        "-Clink-arg=--sysroot=$(location //src/cerise/sysroot:fuchsia_link_sysroot)",
        "-Clink-arg=-lc++",
    ],
    tags = ["manual"],
    # netdevice_worker.rs interoperates directly with fuchsia.hardware.network's
    # MacAddressingProxy (a real, wide, boot-critical consumer of PLAIN
    # fuchsia.net -- network-device, virtio-net, e1000 all depend on it, so its
    # own codegen cannot be bumped to HEAD). Every other file in this binary uses
    # the HEAD instance (crate name `fidl_fuchsia_net`, per the _ext crates'
    # needs) -- give netdevice_worker.rs's plain-instance need a distinct name
    # via `aliases` rather than forcing one file's type through the wrong
    # instance (rules_rust precedent: vfs/rust's fuchsia.io_head aliasing).
    aliases = {
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net": "fidl_fuchsia_net_plain",
    },
    proc_macro_deps = [
        "@crates//:derivative",
    ],
    deps = [
        ":ns3_config_rust",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net",
        "//src/upstream/fuchsia/src/connectivity/network/netstack3/core:netstack3-core",
        "//src/upstream/fuchsia/src/connectivity/network/netstack3/fidl:fidl_fuchsia_netstack_persistence",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.ebpf:fidl_fuchsia_ebpf",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.hardware.network:fidl_fuchsia_hardware_network",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.io:fidl_fuchsia_io",
        # netstack3 uses fidl_fuchsia_net_ext/interfaces_ext/etc. throughout,
        # all built on the HEAD-compiled fuchsia.net instance (fidl_fuchsia_net_head)
        # - use the same instance directly here for internal consistency (avoids
        # "two different versions of crate fidl_fuchsia_net" type mismatches).
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net:fidl_fuchsia_net_head",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.debug:fidl_fuchsia_net_debug",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.dhcp:fidl_fuchsia_net_dhcp",
