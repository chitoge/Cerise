# netstack3: real upstream netstack3-bindings (src/connectivity/network/netstack3) -
# the real Fuchsia TCP/IP stack binary, driving the already-vendored netstack3-core
# (see core/BUILD.bazel). Structured-config + binary target authored locally
# (Cerise addition, not upstream - upstream builds this via GN's
# fuchsia_structured_config_rust_lib + network_unified_binary), mirroring the exact
# pattern already established for storage/fshost/BUILD.bazel.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:structured_config.bzl", "fuchsia_structured_config_rust_lib_from_cm")
load("//bazel:fuchsia_platform.bzl", "fuchsia_stripped")

package(default_visibility = ["//visibility:public"])

# ns3_config: the REAL structured-config client crate, generated by configc from
# the compiled netstack3 realm manifest (//src/cerise/realms:netstack3_manifest,
# whose `config: {}` schema this crate's checksum is derived from — the former
# parallel meta/netstack3_for_config_lib.cml schema copy is retired). main.rs
# calls Config::take_from_startup_handle() for real: the values arrive in the
# ComponentConfigVmo populated from the staged meta/netstack3.cvf (
# burn-down of the literal).
fuchsia_structured_config_rust_lib_from_cm(
    name = "ns3_config_rust",
    cm = "//src/cerise/realms:netstack3_manifest",
    crate_name = "ns3_config",
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

rust_binary(
    name = "netstack3",
    srcs = [
        "src/bindings.rs",
        "src/bindings/bpf.rs",
        "src/bindings/counters.rs",
