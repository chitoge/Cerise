        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.matchers:fidl_fuchsia_net_matchers",
        "//src/upstream/fuchsia/sdk/fidl/fuchsia.net.multicast.admin:fidl_fuchsia_net_multicast_admin",
