# Authored locally for Cerise. netstack3's own local FIDL
# library (fuchsia.netstack.persistence — opaque-IID secret-key persistence
# state), @available(added=HEAD) (this project's #1 recurring porting trap;
# `available = "fuchsia:HEAD"` matches the established fix pattern). Rust
# binding only — netstack3-bindings only needs `fidl:fuchsia.netstack.persistence_rust`.
load("//build/fidl:fidl.bzl", "fidl_library", "fidl_rust")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

fidl_library(
    name = "fuchsia.netstack.persistence",
    srcs = ["state.fidl"],
    available = "fuchsia:HEAD",
    tags = ["manual"],
)

fidl_rust(
    name = "fuchsia.netstack.persistence_rs",
    library = ":fuchsia.netstack.persistence",
    tags = ["manual"],
)

rust_library(
    name = "fidl_fuchsia_netstack_persistence",
    srcs = [":fuchsia.netstack.persistence_rs"],
    crate_name = "fidl_fuchsia_netstack_persistence",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//src/upstream/fuchsia/src/lib/fidl/rust/fidl:fidl",
        "@crates//:bitflags",
        "@crates//:futures",
        "//src/upstream/fuchsia/sdk/rust/zx-status:zx-status",
        "//src/upstream/fuchsia/sdk/rust/zx-types:zx-types",
    ] + select({
        "@platforms//os:fuchsia": ["//src/upstream/fuchsia/sdk/rust/zx:zx"],
        "//conditions:default": [],
    }),
)
