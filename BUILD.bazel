# cc_library aggregator for kernel ambient headers.
# The stdlib-resolution closure is now in the toolchain only (8 paths, see toolchain/ambient-includes.json).
# All component headers are evicted from the toolchain and provided here via CcInfo:
#   - hdrs: makes header files available as compile action inputs
#   - includes: registers the search paths in CcInfo (replaces toolchain -isystem)
# deps = ["//:kernel_cc_headers"] in kernel component BUILD files gets both.
cc_library(
    name = "kernel_cc_headers",
    hdrs = [
        "//zircon/system/public:headers",
        "//zircon/kernel/include:headers",
    ] + select({
        "@platforms//cpu:aarch64": [
            "//zircon/kernel/arch/arm64/include:headers",
            "//zircon/kernel/lib/arch/arm64/include:headers",
        ],
        "//conditions:default": [
            "//zircon/kernel/arch/x86/include:headers",
            "//zircon/kernel/lib/arch/x86/include:headers",
        ],
    }) + [
        "//zircon/kernel/lib/arch/include:headers",
        "//zircon/kernel/lib/heap/include:headers",
        "//zircon/kernel/lib/ktl:headers",
        "//zircon/kernel/lib/libc:headers",
        "//zircon/kernel/vm:header_files",
        "//zircon/kernel/vm/phys:headers",
        "//zircon/kernel/phys/lib/memalloc:range_headers",
        "//zircon/kernel/phys/include:all_headers",
        "//zircon/system/ulib/lazy_init:headers",
        "//zircon/kernel/lib/stall:headers",
        "//zircon/kernel/lib/kconcurrent:headers",
        "//zircon/system/ulib/concurrent:headers",
        "//src/lib/lockdep:headers",
        "//zircon/kernel/lib/power-management:headers",
        ":kernel_object_headers",
        ":zx_include_headers",
        "//zircon/system/ulib/ffl:headers",
        "//sdk/lib/fit:headers",
        "//sdk/lib/stdcompat:headers",
        "//sdk/lib/zbi-format:headers",
        "//zircon/kernel/lib/sched:headers",
        "//zircon/system/ulib/affine:headers",
        "//zircon/system/ulib/bitmap:headers",
        "//zircon/system/ulib/fbl:headers",
        "//zircon/system/ulib/page_tables:headers",
        "//zircon/system/ulib/pretty:headers",
        "//zircon/system/ulib/hwreg:headers",
        "//zircon/system/ulib/ram-crashlog:headers",
        "//zircon/system/ulib/zircon-internal:headers",
        "//zircon/kernel/lib/backtrace:headers",
        "//zircon/kernel/lib/btree:headers",
        "//zircon/kernel/lib/object_cache:headers",
        "//zircon/kernel/lib/page:header_files",
        "//zircon/kernel/lib/lockup_detector:headers",
        "//zircon/kernel/lib/page-map:headers",
        "//zircon/kernel/lib/acpi_lite:header_files",
        "//zircon/kernel/lib/percpu_writer:headers",
        "//zircon/kernel/lib/spsc_buffer:headers",
        "//zircon/kernel/lib/suspend_wakeup_timer:headers",
        "//zircon/kernel/lib/thread_sampler:headers",
        "//zircon/kernel/lib/wake-vector:headers",
        ":kernel_libfbl_headers",
        "//zircon/kernel/hypervisor:header_files",
        "//zircon/kernel/dev/interrupt:headers",
        "//zircon/kernel/dev/pdev:headers",
        "//zircon/kernel/dev/pdev/power:headers",
    ] + select({
        "@platforms//cpu:aarch64": ["//zircon/kernel/arch/arm64:arch_phys_headers"],
        "//conditions:default": [":kernel_platform_pc_headers"],
    }) + [
        ":kernel_lib_ambient_headers",
        ":elfldltl_headers",
        "//src/lib/zbitl:headers",
        "//zircon/kernel/phys/lib/memalloc:headers",
        "//zircon/system/ulib/uart:headers",
        "//zircon/system/ulib/mmio-ptr:headers",
    ],
    # CcInfo includes: all paths evicted from kernel_c_stdlib_flags.
    # These replace the toolchain -isystem entries for non-stdlib component headers.
    includes = [
        # stdlib closure (also in toolchain for -isystem; duplicated here so
        # deps on :kernel_cc_headers alone are sufficient without toolchain context)
        "zircon/system/public",
        "zircon/kernel/include",
    ] + select({
        "@platforms//cpu:aarch64": [
            "zircon/kernel/arch/arm64/include",
            "zircon/kernel/lib/arch/arm64/include",
        ],
        "//conditions:default": [
            "zircon/kernel/arch/x86/include",
            "zircon/kernel/arch/x86/page_tables/include",
            "zircon/kernel/lib/arch/x86/include",
        ],
    }) + [
        "zircon/kernel/lib/arch/include",
        "zircon/kernel/lib/heap/include",
        "zircon/kernel/lib/heap/cmpctmalloc/include",
        "zircon/kernel/lib/ktl/include",
        "zircon/kernel/lib/libc/include",
        # Component includes evicted from toolchain
        "zircon/kernel/vm/include",
        "zircon/kernel/vm/phys/include",
        "zircon/kernel/phys/lib/memalloc/include",
        "zircon/kernel/phys/include",
    ] + select({
        "@platforms//cpu:aarch64": ["zircon/kernel/arch/arm64/phys/include"],
        "//conditions:default": ["zircon/kernel/arch/x86/phys/include"],
    }) + [
