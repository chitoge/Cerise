# Host-compatible cc_library for EFI headers (<efi/types.h>, <efi/boot-services.h>, etc.).
# Used by host-side EFI unit tests. Root package owns guids.c and the efi/include glob,
# so we define this here to avoid creating a BUILD.bazel package boundary in lib/efi/.
cc_library(
    name = "efi_headers",
    hdrs = glob(["zircon/kernel/lib/efi/include/**/*.h"]),
    includes = ["zircon/kernel/lib/efi/include"],
    deps = ["//zircon/system/public:public"],
    visibility = ["//visibility:public"],
)

# EFI GUID constants (compiled from C; works under any toolchain).
cc_library(
    name = "efi_lib",
    srcs = ["zircon/kernel/lib/efi/guids.c"],
    deps = [":efi_headers"],
    alwayslink = True,
    visibility = ["//visibility:public"],
)

# Host-compatible cc_library for lib/zx/result.h and related zx types.
# Used by host-side tests that include <lib/zx/result.h>.
cc_library(
    name = "zx_result_headers",
    hdrs = glob(["zircon/system/ulib/zx/include/**/*.h"]),
    includes = ["zircon/system/ulib/zx/include"],
    deps = [
        "//sdk/lib/fit:fit",
        "//sdk/lib/stdcompat:stdcompat",
        "//zircon/system/public:public",
    ],
    visibility = ["//visibility:public"],
)

