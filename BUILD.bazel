# Host (build-time) zstd static library: full compress + decompress, built from
# the vendored //third_party/zstd sources. Mirrors the GN `zstd` static_library
# in third_party/zstd/BUILD.gn (sources + defines), minus ZSTD_MULTITHREAD (this
# build-time tool is single-threaded, so it needs no pthread and threading.c /
# pool.c compile to no-ops). Consumed by //tools/zstd:zstd_cli. NOTE: this target
# lives in the root package (not a new third_party/zstd/BUILD.bazel) on purpose —
# a BUILD file there would carve third_party/zstd into its own package and break
# the `third_party/zstd/**/*` globs above (userboot_payload_support_snapshot).
cc_library(
    name = "zstd_host",
    srcs = [
        # common
        "third_party/zstd/src/lib/common/debug.c",
        "third_party/zstd/src/lib/common/entropy_common.c",
        "third_party/zstd/src/lib/common/error_private.c",
        "third_party/zstd/src/lib/common/fse_decompress.c",
        "third_party/zstd/src/lib/common/pool.c",
        "third_party/zstd/src/lib/common/threading.c",
        "third_party/zstd/src/lib/common/xxhash.c",
        "third_party/zstd/src/lib/common/zstd_common.c",
        # compress
        "third_party/zstd/src/lib/compress/fse_compress.c",
        "third_party/zstd/src/lib/compress/hist.c",
        "third_party/zstd/src/lib/compress/huf_compress.c",
        "third_party/zstd/src/lib/compress/zstd_compress.c",
        "third_party/zstd/src/lib/compress/zstd_compress_literals.c",
        "third_party/zstd/src/lib/compress/zstd_compress_sequences.c",
        "third_party/zstd/src/lib/compress/zstd_compress_superblock.c",
        "third_party/zstd/src/lib/compress/zstd_double_fast.c",
        "third_party/zstd/src/lib/compress/zstd_fast.c",
        "third_party/zstd/src/lib/compress/zstd_lazy.c",
        "third_party/zstd/src/lib/compress/zstd_ldm.c",
        "third_party/zstd/src/lib/compress/zstd_opt.c",
        "third_party/zstd/src/lib/compress/zstdmt_compress.c",
        # dictBuilder (kept to mirror the GN `zstd` target's proven source set)
        "third_party/zstd/src/lib/dictBuilder/cover.c",
        "third_party/zstd/src/lib/dictBuilder/divsufsort.c",
        "third_party/zstd/src/lib/dictBuilder/fastcover.c",
        "third_party/zstd/src/lib/dictBuilder/zdict.c",
        # decompress
        "third_party/zstd/src/lib/decompress/huf_decompress.c",
        "third_party/zstd/src/lib/decompress/huf_decompress_amd64.S",
        "third_party/zstd/src/lib/decompress/zstd_ddict.c",
        "third_party/zstd/src/lib/decompress/zstd_decompress.c",
        "third_party/zstd/src/lib/decompress/zstd_decompress_block.c",
    ],
    hdrs = glob([
        "third_party/zstd/include/**/*.h",
        "third_party/zstd/src/lib/**/*.h",
    ], allow_empty = True),
    copts = [
        "-Wno-implicit-fallthrough",
        "-Wno-conversion",
        "-Wno-unused-but-set-variable",
        "-Wno-unknown-warning-option",
    ],
    defines = [
        "XXH_NAMESPACE=ZSTD_",
        "ZDICTLIB_VISIBILITY=",
        "ZSTDERRORLIB_VISIBILITY=",
        "ZSTDLIB_HIDDEN=",
        "ZSTDLIB_VISIBILITY=",
        "ZSTDLIB_VISIBLE=",
    ],
    includes = [
        "third_party/zstd/include",
        "third_party/zstd/src/lib",
        "third_party/zstd/src/lib/common",
        "third_party/zstd/src/lib/compress",
        "third_party/zstd/src/lib/decompress",
        "third_party/zstd/src/lib/dictBuilder",
    ],
    visibility = ["//visibility:public"],
)

