# Exec-platform CC toolchain for x86_64 Linux exec → x86_64 Linux target.
# Registered before @llvm_toolchains//:all so it takes priority for exec→exec
# builds (e.g. rust_binary_without_process_wrapper, fidlc on x86_64 workers).
#
# stdlib: hermetic libc++ + libc++abi headers via cxxstdlib_headers_include_search_paths,
# hermetic Linux kernel headers and glibc headers from @llvm//toolchain/args/linux.
# -nostdlibinc (hermetic_compile_flags) blocks all system stdlib include paths.
# static_link_cpp_runtimes enabled with hermetic libc++.a (same as reference linux_x86_64 toolchain).
# exec_cpp_runtime_input_dep cc_args carries @llvm//runtimes:static_runtime_lib as a data dep so
# that the .a files are included as Bazel action inputs for ALL link actions — including
# rules_rust's rust_binary_without_process_wrapper, which does not propagate cc_toolchain
# static_runtime_lib files on its own.
# exec_exec_link_libs provides -lpthread -ldl via SYSTEM glibc (no hermetic glibc -L dir),
# keeping the exec binary ABI compatible with the remote workers' system glibc.
# The hermetic @llvm//toolchain/args/linux:default_libs adds a -L<hermetic-glibc-dir> path
# that makes the linker resolve libpthread/libdl against the hermetic glibc 2.25+ stubs,
# embedding GLIBC_2.25 version requirements that the remote workers cannot satisfy.
# Stage1 select returns :none for static/dynamic runtimes, breaking the with_cfg.bzl build cycle.

# Carries the hermetic static C++ runtime as a data dep so that Bazel includes
# the .a files as action inputs for every exec-platform link action.
# rules_rust's rust_binary_without_process_wrapper invokes the CC linker but
# does not propagate cc_toolchain.static_runtime_lib as action inputs, causing
# the link to fail on a cold remote cache.  Adding the runtime here via
# cc_args.data ensures it is always listed as an input regardless of rule type.
cc_args(
    name = "exec_cpp_runtime_input_dep",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [],
    data = ["@llvm//runtimes:static_runtime_lib"],
)

# Provides -ldl/-lpthread via system glibc (no hermetic -L prefix).
# Using @llvm//toolchain/args/linux:default_libs here would add the hermetic
# glibc library search directory, making exec binaries reference GLIBC_2.25+
# symbols that are absent on the remote workers.
cc_args(
    name = "exec_link_libs",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-Wl,--push-state",
        "-Wl,--as-needed",
        "-lpthread",
        "-ldl",
        "-Wl,--pop-state",
    ],
)

cc_args(
    name = "exec_x86_64_target_triple",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-target",
        "x86_64-linux-gnu",
    ],
)

cc_args(
    name = "exec_x86_64_fuse_lld",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-fuse-ld=lld"],
)

# Opt-in host C++20 standard for the exec/host toolchain. Host-side
# cc_library/cc_test targets that need C++20 (e.g. the acpi_lite/fbl host gtest
# variants) request it with `features = ["host_cxx20"]` instead of carrying a
# per-target -std copt, which the no_policy_in_build guardrail forbids in
# component BUILD files (`features` is not a forbidden policy attr).
#
# Modelled as a feature so it expands after the legacy `default_compile_flags`
# feature's -std=c++17 and therefore wins (clang honors the final -std). It is
# listed in `known_features` but NOT `enabled_features`, so it is OFF by
# default: LLVM-as-a-build-tool (needs C++17), the from-source libcxx runtime
# (sets its own C++23) and other host tools keep their working standard, and
# only targets that explicitly opt in are affected. The zircon environment
# toolchains carry their own -std via the lang.*_cxx_std features.
cc_args(
    name = "exec_x86_64_cxx_std_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_compile_actions"],
    args = ["-std=c++20"],
)

cc_feature(
    name = "exec_x86_64_cxx_std",
    feature_name = "host_cxx20",
    args = [":exec_x86_64_cxx_std_args"],
)

cc_tool(
    name = "exec_clangxx",
    src = ":linux_x86_64/bin/clang++.prebuilt",
    data = [
        ":linux_x86_64/bin/llvm.prebuilt",
        ":linux_x86_64/bin/ld.lld.prebuilt",
        ":linux_x86_64/clang_builtin_resource_dir",
    ],
    allowlist_include_directories = [":linux_x86_64/clang_builtin_resource_dir"],
)

cc_tool_map(
    name = "exec_x86_64_tool_map",
    tools = {
        "@rules_cc//cc/toolchains/actions:assembly_actions": ":kernel_clang",
        "@rules_cc//cc/toolchains/actions:c_compile": ":kernel_clang",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions": ":kernel_clangxx",
        "@rules_cc//cc/toolchains/actions:link_actions": ":exec_clangxx",
        "@rules_cc//cc/toolchains/actions:cpp_link_static_library": ":kernel_llvm_ar",
        "@rules_cc//cc/toolchains/actions:objcopy_embed_data": ":kernel_llvm_objcopy",
        "@rules_cc//cc/toolchains/actions:strip": ":kernel_llvm_strip",
    },
)

cc_toolchain(
    name = "exec_x86_64_cc_toolchain",
    # Stage1 omits cxxstdlib/glibc/kernel header args to avoid conflicts when building
    # the libc++ runtime itself (which provides its own deps on those headers).
    # Mirrors the reference linux_x86_64 toolchain's stage-aware args select.
    args = select({
        "@llvm//toolchain:runtimes_stage1": [
            ":exec_x86_64_target_triple",
            ":exec_x86_64_fuse_lld",
            "@zr_llvm_toolchain_minimal_linux_amd64//:compile_resource_dir",
            "@llvm//toolchain/args:no_absolute_paths_for_builtins",
            "@llvm//toolchain/args:module_map",
            "@llvm//toolchain/args:hermetic_compile_flags",
        ],
        "@llvm//toolchain:runtimes_stage1_hosted": [
            ":exec_x86_64_target_triple",
            ":exec_x86_64_fuse_lld",
            "@zr_llvm_toolchain_minimal_linux_amd64//:compile_resource_dir",
            "@llvm//toolchain/args:no_absolute_paths_for_builtins",
            "@llvm//toolchain/args:module_map",
            "@llvm//toolchain/args:hermetic_compile_flags",
        ],
        # runtimes_none = runtime_stage:stage0, which cc_runtime_stage0_static_library
        # uses for libcxx.static/libcxxabi.static/libunwind.static. Omit
        # cxxstdlib_headers_include_search_paths here: that arg adds
        # libcxx_headers_include_search_directory as a -isystem path, which
        # intercepts #include_next <string.h>/<errno.h> before glibc when
        # libcxx source is already on the user -I path via cc_library deps.
        "@llvm//toolchain:runtimes_none": [
            ":exec_x86_64_target_triple",
            ":exec_x86_64_fuse_lld",
            "@zr_llvm_toolchain_minimal_linux_amd64//:compile_resource_dir",
            "@llvm//toolchain/args:no_absolute_paths_for_builtins",
            "@llvm//toolchain/args:module_map",
            "@llvm//toolchain/args:hermetic_compile_flags",
            "@llvm//toolchain/args/linux:kernel_headers_include_search_paths",
            "@llvm//toolchain/args/linux:glibc_headers_include_search_paths",
        ],
        "//conditions:default": [
            ":exec_x86_64_target_triple",
            ":exec_x86_64_fuse_lld",
            "@zr_llvm_toolchain_minimal_linux_amd64//:compile_resource_dir",
            "@llvm//toolchain/args:no_absolute_paths_for_builtins",
            "@llvm//toolchain/args:module_map",
            "@llvm//toolchain/args:hermetic_compile_flags",
            "@llvm//toolchain/args:cxxstdlib_headers_include_search_paths",
            "@llvm//toolchain/args/linux:kernel_headers_include_search_paths",
            "@llvm//toolchain/args/linux:glibc_headers_include_search_paths",
            ":exec_link_libs",
            ":exec_cpp_runtime_input_dep",
        ],
    }),
    known_features = select({
        "@llvm//toolchain:runtimes_stage1": [
            "@llvm//toolchain/features:archive_param_file",
            "@llvm//toolchain/features:prefer_pic_for_opt_binaries",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
            ":exec_x86_64_cxx_std",
        ],
        "@llvm//toolchain:runtimes_stage1_hosted": [
            "@llvm//toolchain/features:archive_param_file",
            "@llvm//toolchain/features:prefer_pic_for_opt_binaries",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
            ":exec_x86_64_cxx_std",
        ],
        "//conditions:default": [
            "@llvm//toolchain/features/legacy:all_legacy_builtin_features",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
            "@llvm//toolchain/features:static_link_cpp_runtimes",
            "@llvm//toolchain/features/runtime_library_search_directories:feature",
            ":exec_x86_64_cxx_std",
        ],
    }),
    enabled_features = select({
        "@llvm//toolchain:runtimes_stage1": [
            "@llvm//toolchain/features:prefer_pic_for_opt_binaries",
            "@llvm//toolchain/features:archive_param_file",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
        ],
        "@llvm//toolchain:runtimes_stage1_hosted": [
            "@llvm//toolchain/features:prefer_pic_for_opt_binaries",
            "@llvm//toolchain/features:archive_param_file",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
        ],
        "//conditions:default": [
            "@llvm//toolchain/features/legacy:all_legacy_builtin_features",
            "@llvm//toolchain/features/legacy:experimental_replace_legacy_action_config_features",
            "@llvm//toolchain/features:static_link_cpp_runtimes",
            "@llvm//toolchain/features/runtime_library_search_directories:feature",
        ],
    }),
    tool_map = ":exec_x86_64_tool_map",
    module_map = ":zircon_module_map",
    static_runtime_lib = select({
        "@llvm//toolchain:runtimes_none": "@llvm//runtimes:none",
        "@llvm//toolchain:runtimes_stage1": "@llvm//runtimes:none",
        "@llvm//toolchain:runtimes_stage1_hosted": "@llvm//runtimes:none",
        "//conditions:default": "@llvm//runtimes:static_runtime_lib",
    }),
    dynamic_runtime_lib = select({
        "@llvm//toolchain:runtimes_none": "@llvm//runtimes:none",
        "@llvm//toolchain:runtimes_stage1": "@llvm//runtimes:none",
        "@llvm//toolchain:runtimes_stage1_hosted": "@llvm//runtimes:none",
        "//conditions:default": "@llvm//runtimes:dynamic_runtime_lib",
    }),
    supports_header_parsing = True,
    supports_param_files = True,
    compiler = "clang",
)

