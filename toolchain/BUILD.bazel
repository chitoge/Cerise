# arm64 kernel cc_args (N-ary arch table; x64 cc_args above are unchanged)

cc_args(
    name = "kernel_arm64_target_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["--target=aarch64-unknown-elf"],
)

cc_args(
    name = "kernel_arm64_freestanding_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-ffreestanding",
        "-fno-builtin",
        "-fno-stack-protector",
        "-mgeneral-regs-only",
        # -mstrict-align (SCTLR.A-independent, EL1): the arm64 kernel's early boot
        # code (start.S -> PhysMain and the LK init path) executes with the MMU
        # OFF, where all memory is Device-nGnRnE and every unaligned access faults
        # regardless of SCTLR_ELx.A. Without this, clang emits unaligned
        # halfword/word accesses (legal on Normal memory) that alignment-fault
        # before the kernel enables its page tables. Upstream Zircon compiles the
        # arm64 kernel with -mstrict-align for exactly this reason. This flag has
        # no x64 counterpart — x86 permits unaligned access even with paging off.
        "-mstrict-align",
    ],
)

cc_args(
    name = "kernel_arm64_abi_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fdata-sections",
        "-ffunction-sections",
        "-fPIE",
        "-fvisibility=hidden",
        "-mcmodel=small",
        "-fasynchronous-unwind-tables",
        "-ffixed-x18",
        "-fsanitize=shadow-call-stack",
        # arm64 kernel ABI: integer-only register use (no FP/SIMD in kernel mode),
        # x20 reserved for percpu pointer, TPIDR_EL1 for thread pointer.
        "-mgeneral-regs-only",
        "-ffixed-x20",
        "-mtp=el1",
    ],
)

cc_args(
    name = "kernel_arm64_define_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
