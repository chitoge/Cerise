            "-DZIRCON_TOOLCHAIN",
            "-D_KERNEL",
            "-DARCH_ARM64",
            "-DSMP_MAX_CPUS=16",
            "-DDEBUG_PRINT_LEVEL=2",
            "-DLK_DEBUGLEVEL=2",
            "-DFUCHSIA_UNSUPPORTED_ALLOW_SYSCALLS_NEXT_ON_HOST",
            "-DLIB_ARCH_PAGING_CONFIGURATION=\"4k-48bit\"",
            "-DWITH_FRAME_POINTERS=1",
            "-DJTRACE_TARGET_BUFFER_SIZE=0",
            "-DLZ4_STATIC_LINKING_ONLY",
            "-DLZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION",
            "-DEXPERIMENTAL_CONTINUOUS_PER_VMO_ATTRIBUTION_ENABLED=0",
