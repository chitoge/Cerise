# kernel_c_stdlib_flags contains ONLY the stdlib-resolution closure.
# Every entry is justified in toolchain/ambient-includes.json.
# All non-stdlib component includes are evicted to //:kernel_cc_headers CcInfo deps.
cc_args(
    name = "kernel_c_stdlib_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile_actions",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
        "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
        "@rules_cc//cc/toolchains/actions:preprocess_assemble",
    ],
    args = [
        "-nostdlibinc",
        "-no-canonical-prefixes",
        "-isystem",
        "zircon/system/public",
        "-isystem",
        "zircon/kernel/include",
        "-isystem",
        "zircon/kernel/arch/x86/include",
        "-isystem",
        "zircon/kernel/lib/arch/x86/include",
        "-isystem",
        "zircon/kernel/lib/arch/include",
        "-isystem",
        "zircon/kernel/lib/heap/include",
        "-isystem",
        "zircon/kernel/lib/ktl/include",
        "-isystem",
        "zircon/kernel/lib/libc/include",
    ],
    data = [
        "//zircon/system/public:headers",
        "//zircon/kernel/include:headers",
        "//zircon/kernel/arch/x86/include:headers",
        "//zircon/kernel/lib/arch/x86/include:headers",
        "//zircon/kernel/lib/arch/include:headers",
        "//zircon/kernel/lib/heap/include:headers",
        "//zircon/kernel/lib/ktl:headers",
        "//zircon/kernel/lib/libc:headers",
    ],
)

