    name = "arm64_phys_common_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-ffreestanding",
        "-fno-builtin",
        "-fno-stack-protector",
        "-mgeneral-regs-only",
        # -mstrict-align: phys (physload/physboot) runs with the MMU OFF, where
        # memory is Device-nGnRnE and unaligned accesses alignment-fault
        # regardless of SCTLR_ELx.A. Without this, clang emits an unaligned
        # `sturh` in physload's early C path that faulted at physload PC
        # 0x48067d28 (FAR 0x480fb07d) before any UART output. Upstream Zircon
        # builds arm64 phys with -mstrict-align.
        "-mstrict-align",
    ],
)

cc_args(
    name = "arm64_phys_codemodel_flags",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        # tiny code model: all code/data within ±1MB, no GOT/PLT needed.
        # Must come AFTER phys_abi_flags (which has -mcmodel=small) so it wins.
        # Phys binaries are small boot stubs (<512KB), safe and avoids GOT entries
        # that would violate the phys.ld assertion (SIZEOF(.got) <= 32).
        "-mcmodel=tiny",
    ],
)

