load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True) + [
        "//zircon/tools/zither/backends/c:source_snapshot",
        "//zircon/tools/zither/backends/kernel:source_snapshot",
        "//zircon/tools/zither/cmd/kernel_only:source_snapshot",
    ],
)

go_library(
    name = "zither",
    srcs = [
        "c_family.go",
        "names.go",
        "readme.go",
        "zither_ir.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/zircon/tools/zither",
    deps = [
        "//tools/fidl/lib/fidlgen",
        "//tools/fidl/lib/fidlgen_cpp",
    ],
)