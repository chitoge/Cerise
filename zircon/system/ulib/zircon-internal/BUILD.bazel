load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "headers",
    srcs = glob(
        [
            "include/**/*.h",
            "include/**/*.inc",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "zircon-internal",
    hdrs = [":headers"],
    includes = ["include"],
    deps = [
        "//zircon/system/public:public",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
