load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

cc_library(
    name = "concurrent",
    srcs = [":sources"],
    hdrs = [":headers"],
    includes = ["include"],
    deps = [
        "//sdk/lib/stdcompat:stdcompat",
        "//sdk/lib/zircon-assert:zircon_assert",
        "//zircon/system/public:public",
    ],
)

filegroup(
    name = "sources",
    srcs = ["copy.cc"],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
