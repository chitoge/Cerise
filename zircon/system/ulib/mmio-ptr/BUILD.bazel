load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mmio-ptr",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
