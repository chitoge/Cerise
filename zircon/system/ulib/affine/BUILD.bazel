load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

cc_library(
    name = "affine",
    srcs = [
        "ratio.cc",
        "transform.cc",
    ],
    hdrs = [":headers"],
    includes = ["include"],
    alwayslink = True,
    deps = ["//sdk/lib/zircon-assert:zircon_assert"],
)

filegroup(
    name = "sources",
    srcs = [
        "ratio.cc",
        "transform.cc",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
