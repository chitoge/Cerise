package(default_visibility = ["//visibility:public"])

exports_files(["include/lib/cksum.h"])

filegroup(
    name = "crc32_source",
    srcs = [
        "crc32.c",
        "crc32.h",
        "zutil.h",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)

cc_library(
    name = "cksum",
    srcs = [
        "adler32.c",
        "crc16.c",
        "crc32.c",
        "crc32.h",
        "zutil.h",
    ],
    hdrs = [
        "include/lib/cksum.h",
    ],
    deps = [
        "//zircon/system/public:public",
    ],
    includes = [
        "include",
    ],
)
