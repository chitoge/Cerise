load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "object",
    srcs = [
        "buffer_chain.cc",
        "bus_transaction_initiator_dispatcher.cc",
        "channel_dispatcher.cc",
        "clock_dispatcher.cc",
        "counter_dispatcher.cc",
        "diagnostics.cc",
        "dispatcher.cc",
        "event_dispatcher.cc",
        "event_pair_dispatcher.cc",
        "exception.cc",
        "exception_dispatcher.cc",
        "exceptionate.cc",
        "executor.cc",
        "fifo_dispatcher.cc",
        "futex_context.cc",
        "handle.cc",
        "handle_table.cc",
        "interrupt_dispatcher.cc",
        "interrupt_event_dispatcher.cc",
        "io_buffer_dispatcher.cc",
        "io_buffer_shared_region_dispatcher.cc",
        "iommu_dispatcher.cc",
        "job_dispatcher.cc",
        "job_policy.cc",
        "log_dispatcher.cc",
        "mbuf.cc",
        "memory_watchdog.cc",
        "message_packet.cc",
        "msi_dispatcher.cc",
        "msi_interrupt_dispatcher.cc",
        "pager_dispatcher.cc",
        "pager_proxy.cc",
        "pci_device_dispatcher.cc",
        "pci_interrupt_dispatcher.cc",
        "pinned_memory_token_dispatcher.cc",
        "port_dispatcher.cc",
        "process_dispatcher.cc",
        "profile_dispatcher.cc",
        "resource.cc",
        "resource_dispatcher.cc",
        "root_job_observer.cc",
        "sampler_dispatcher.cc",
        "singleton.cc",
        "socket_dispatcher.cc",
        "stream_dispatcher.cc",
        "suspend_token_dispatcher.cc",
        "thread_dispatcher.cc",
        "timer_dispatcher.cc",
        "user_handles.cc",
        "virtual_interrupt_dispatcher.cc",
        "vm_address_region_dispatcher.cc",
        "vm_object_dispatcher.cc",
        "wait_signal_observer.cc",
    ] + select({
        # guest_dispatcher.cc and vcpu_dispatcher.cc depend on arch/hypervisor.h.
        # When hypervisor is disabled, use stubs that satisfy the linker references
        # from object_info.cc without pulling in the arch hypervisor implementation.
        "//config:hypervisor_enabled": [
            "guest_dispatcher.cc",
            "vcpu_dispatcher.cc",
        ],
        "//conditions:default": [
            "hypervisor_dispatcher_stubs.cc",
        ],
    }),
    defines = [
        "CHANNEL_MESSAGE_BODY_TRACING_ENABLED=0",
        "FUTEX_BLOCK_TRACING_ENABLED=0",
    ],
    alwayslink = True,
    deps = [
        "//sdk/lib/iob:iob",
        "//zircon/kernel/dev/iommu/stub:iommu_stub",
    ] + select({
        "@platforms//cpu:aarch64": ["//zircon/kernel/dev/iommu/arm_smmu:arm_smmu"],
        "//conditions:default": [],
    }) + [
        "//zircon/system/ulib/mmio-ptr:mmio-ptr",
        "//zircon/system/ulib/region-alloc:region-alloc",
        "//:kernel_cc_headers",
    ],
)

