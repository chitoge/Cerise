load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "phys",
    hdrs = ["include/vm/phys/arena.h"],
    includes = ["include"],

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "headers",
    srcs = [
        "include/vm/phys/arena.h",
        "//zircon/kernel/phys/lib/memalloc:range_headers",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)