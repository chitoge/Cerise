load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "unittest",
    srcs = [
        "console.cc",
        "unittest.cc",
        "user_memory.cc",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)

cc_library(
    name = "user_memory_tests",
    testonly = True,
    tags = ["manual"],
    srcs = ["user_memory_tests.cc"],
    alwayslink = True,
    deps = [
        ":unittest",
        "//:kernel_cc_headers",
    ],
)
