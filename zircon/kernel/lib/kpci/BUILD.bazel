load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kpci",
    srcs = ["pio.cc"],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "sources",
    srcs = ["pio.cc"],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
