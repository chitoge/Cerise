load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "io",
    srcs = [
        "console.cc",
        "framebuffer-console.cc",
        # The renderer, shared verbatim with physboot rather than forked; see
        # framebuffer-console.cc.  It depends on nothing specific to either
        # stage, so the two get one font and one blitter between them.
        "//zircon/kernel/phys:framebuffer-console.cc",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "//zircon/kernel/lib/debuglog",
        "//zircon/kernel/lib/persistent-debuglog",
        "//:kernel_cc_headers",
    ],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "sources",
    srcs = [
        "console.cc",
        "framebuffer-console.cc",
        "//zircon/kernel/phys:framebuffer-console.cc",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
