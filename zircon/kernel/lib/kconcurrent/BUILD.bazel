load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kconcurrent",
    srcs = [
        "chainlock_transaction.cc",
        "seqlock.cc",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "//zircon/system/ulib/concurrent:concurrent",
        "//src/lib/lockdep:lockdep",
        "//tools/fidl:compat_headers",
        "//:kernel_cc_headers",
    ],
)


filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "sources",
    srcs = [
        "chainlock_transaction.cc",
        "seqlock.cc",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
