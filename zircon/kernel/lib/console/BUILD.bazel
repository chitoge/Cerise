load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "console",
    srcs = ["console.cc"],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    copts = ['-DBOOT_TEST_SUCCESS_STRING=\\"BOOT_TEST_SUCCESS:userspace-started\\"'],
    alwayslink = True,

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "sources",
    srcs = ["console.cc"],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
