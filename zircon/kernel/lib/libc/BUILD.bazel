filegroup(
    name = "headers",
    srcs = glob([
        "include/**/*.h",
        "include-after/**/*.h",
    ], allow_empty = True),
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
