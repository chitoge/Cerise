load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "crypto",
    srcs = [
        "entropy_pool.cc",
        "global_prng.cc",
        "prng.cc",
        "entropy/collector.cc",
        "entropy/hw_rng_collector.cc",
        "entropy/jitterentropy_collector.cc",
        "entropy/quality_test.cc",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "@boringssl//:kernel_crypto",
        "//sdk/lib/fit:fit",
        "//zircon/kernel/dev/hw_rng:hw_rng",
        "//zircon/kernel/lib/boot-options:boot_options",
        "//zircon/system/ulib/explicit-memory:explicit-memory",
        "//:kernel_cc_headers",
    ],
)

cc_library(
    name = "physboot_crypto",
    srcs = [":physboot_sources"],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "@boringssl//:kernel_crypto",
        "//:kernel_cc_headers",
        "//zircon/system/ulib/explicit-memory:explicit-memory",
        "//build/phys:phys_include_overrides",
    ],
)

filegroup(
    name = "runtime_sources",
    srcs = [
        "boringssl/incs-and-stubs.cc",
        "entropy/collector.cc",
        "entropy/hw_rng_collector.cc",
        "entropy/jitterentropy_collector.cc",
        "entropy/quality_test.cc",
        "entropy_pool.cc",
        "global_prng.cc",
        "prng.cc",
    ],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "physboot_sources",
    srcs = [
        "boringssl/bazel_incs_stubs.cc",
        "entropy_pool.cc",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
