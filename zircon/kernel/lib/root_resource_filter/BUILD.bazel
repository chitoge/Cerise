load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "root_resource_filter",
    srcs = ["root_resource_filter.cc"],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "//zircon/system/ulib/region-alloc:region-alloc",
        "//:kernel_cc_headers",
    ],
)

filegroup(
    name = "sources",
    srcs = ["root_resource_filter.cc"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
