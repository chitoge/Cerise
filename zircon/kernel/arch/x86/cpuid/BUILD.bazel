load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],

    deps = ["//:kernel_cc_headers"],
)

cc_library(
    name = "cpuid",
    srcs = ["cpuid.cc"],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    alwayslink = True,

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "cpuid_source",
    srcs = ["cpuid.cc"],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
