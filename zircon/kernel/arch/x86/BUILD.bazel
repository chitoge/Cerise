# Bazel-native phys cc_library targets for x86 arch phys code.

_X86_PHYS_COMMON_DEPS = [
    "//build/phys:phys_include_overrides",
    "//:kernel_cc_headers",
    "//src/lib/zbitl:phys_zbitl",
    "//zircon/kernel/phys/lib/memalloc:memalloc",
    "//zircon/kernel/lib/boot-options:phys_boot_options",
    "//zircon/system/ulib/uart:uart",
    "//zircon/kernel/lib/page:headers",
    "//zircon/system/ulib/explicit-memory:explicit-memory",
    "//:phys_elfldltl",
    "//:symbolizer_markup_headers",
    # Extra headers for code-patches.cc
    "//zircon/kernel/lib/arch/include:headers_cc",
    "//zircon/kernel/lib/arch/x86:arch_x86_headers",
    "//zircon/kernel/arch/x86/user-copy:user_copy_headers",
    "//zircon/kernel/arch/x86:retpoline_headers",
    "//zircon/kernel/lib/libc:cstring_arch_x86_headers",
    "//zircon/system/ulib/hwreg:hwreg",
]

# physload: uses phys_common_lib (full physload sources including address-space.cc)
_X86_PHYS_LIB_DEPS = _X86_PHYS_COMMON_DEPS + [
    "//zircon/kernel/phys:phys_common_lib",
]

# physboot module: uses physboot_phys_lib (no address-space.cc, no gArchPhysInfo conflict)
_X86_PHYSBOOT_LIB_DEPS = _X86_PHYS_COMMON_DEPS + [
    "//zircon/kernel/phys:physboot_phys_lib",
]

# boot shim: uses phys_boot_shim_lib (boot-shim source subset, not physload sources)
_X86_BOOT_SHIM_LIB_DEPS = _X86_PHYS_COMMON_DEPS + [
    "//zircon/kernel/phys:phys_boot_shim_lib",
]

_X86_PHYS_PRIVATE_HDRS = glob([
    "phys/*.h",
    "phys/boot-shim/*.h",
], allow_empty = True)

cc_library(
    name = "x86_phys_common_lib",
    srcs = [
        ":physload_cxx_sources",
        ":physload_asm_sources",
    ],
    hdrs = _X86_PHYS_PRIVATE_HDRS,
    includes = ["phys"],
    alwayslink = True,
    deps = _X86_PHYS_LIB_DEPS,
)

# physload module variant: excludes gdt.cc and arch-physload.cc (not needed in modules)
cc_library(
    name = "x86_physboot_base_lib",
    srcs = [
        ":physboot_x86_base_cxx_sources",
        ":physload_asm_sources",
    ],
    hdrs = _X86_PHYS_PRIVATE_HDRS,
    includes = ["phys"],
    alwayslink = True,
    deps = _X86_PHYSBOOT_LIB_DEPS,
)

cc_library(
    name = "x86_physboot_extra_lib",
    srcs = [
        ":physboot_extra_cxx_sources",
    ],
    hdrs = _X86_PHYS_PRIVATE_HDRS,
    includes = ["phys"],
    alwayslink = True,
    deps = _X86_PHYSBOOT_LIB_DEPS,
)

cc_library(
    name = "x86_boot_shim_lib",
    srcs = [
        ":boot_shim_cxx_sources",
        ":boot_shim_asm_sources",
        ":physload_asm_sources",
    ],
    hdrs = _X86_PHYS_PRIVATE_HDRS,
    includes = ["phys"],
    copts = ['-DBI=""'],
    alwayslink = True,
    deps = _X86_BOOT_SHIM_LIB_DEPS + [
        "//build/phys:boot_shim_asm_headers",
    ],
)

cc_library(
    name = "x86_boot_shim_x86_32_lib",
    srcs = [
        ":boot_shim_x86_32_cxx_sources",
        ":boot_shim_x86_32_asm_sources",
    ],
    hdrs = _X86_PHYS_PRIVATE_HDRS,
    includes = ["phys"],
    copts = ['-DBI=""'],
    alwayslink = True,
    deps = _X86_BOOT_SHIM_LIB_DEPS + [
        "//build/phys:boot_shim_asm_headers",
    ],
)

# x86-64 ZBI boot trampoline for the EFI environment.
# Clears RSP/RBP and jumps to the kernel entry point.
cc_library(
    name = "arch_boot_zbi_efi",
    srcs = ["phys/arch-boot-zbi-64.cc"],
    deps = [
        "//:kernel_cc_headers",
        "//src/lib/zbitl:zbitl",
    ],
    alwayslink = True,
)
