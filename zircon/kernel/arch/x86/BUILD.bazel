genrule(
    name = "linuxboot64_header_ikconfig",
    srcs = [
        "phys/linuxboot64-header.S",
        "phys/ikconfig.gz",
    ],
    outs = ["linuxboot64-header.ikconfig.S"],
    cmd = """
gz=$(location phys/ikconfig.gz)
src=$(location phys/linuxboot64-header.S)
out=$@
# Replace .incbin IKCONFIG_FILE with .byte hex values from ikconfig.gz
bytes=$$(python3 -c "
import sys
with open('$$gz', 'rb') as f:
    data = f.read()
print('.byte ' + ', '.join('0x%02x' % b for b in data))
")
sed 's|.incbin IKCONFIG_FILE|'"$$bytes"'|g' "$$src" > "$$out"
""",
)

filegroup(
