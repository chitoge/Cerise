    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "//zircon/kernel/dev/interrupt/gic/common:gic_common",
        "//zircon/kernel/lib/kpci:kpci",
        "//zircon/kernel/lib/pow2_range_allocator:pow2_range_allocator",
        "//zircon/kernel/dev/pcie",
        "//zircon/system/ulib/region-alloc:region-alloc",
        "//:kernel_cc_headers",
