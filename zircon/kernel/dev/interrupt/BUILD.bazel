load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

cc_library(
    name = "interrupt",
    hdrs = [":headers"],
    includes = ["include"],

    deps = ["//:kernel_cc_headers"],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
