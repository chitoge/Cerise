load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "iommu_stub",
    srcs = [
        "stub_bti.cc",
        "stub_iommu.cc",
        "stub_pmt.cc",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    deps = ["//zircon/kernel/dev/iommu:iommu",
        "//:kernel_cc_headers",
],
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "sources",
    srcs = [
        "stub_bti.cc",
        "stub_iommu.cc",
        "stub_pmt.cc",
    ],
)

filegroup(
    name = "source_snapshot",
    srcs = glob(["**/*"], allow_empty = True),
)
