# The BUILD file of every package build/checks/arch-neutral-set.txt declares
# arch-neutral. This list is NOT trusted by the check: layer_string_test.py
# re-reads arch-neutral-set.txt and fails if any package named there is missing
# from these inputs, so the scan set cannot be narrowed silently. (Narrowing it
# to files the check could only skip is exactly how the previous version came to
# read zero bytes while reporting "4 file(s) scanned".)
filegroup(
    name = "arch_neutral_build_files",
    srcs = [
        "//zircon/kernel/dev/interrupt:BUILD.bazel",
        "//zircon/kernel/dev/iommu:BUILD.bazel",
        "//zircon/kernel/dev/iommu/stub:BUILD.bazel",
        "//zircon/kernel/dev/pdev/power:BUILD.bazel",
        "//zircon/kernel/hypervisor:BUILD.bazel",
        "//zircon/kernel/lib/acpi_lite:BUILD.bazel",
        "//zircon/kernel/lib/backtrace:BUILD.bazel",
        "//zircon/kernel/lib/btree:BUILD.bazel",
        "//zircon/kernel/lib/kconcurrent:BUILD.bazel",
        "//zircon/kernel/lib/kpci:BUILD.bazel",
        "//zircon/kernel/lib/ktrace:BUILD.bazel",
        "//zircon/kernel/lib/lockup_detector:BUILD.bazel",
        "//zircon/kernel/lib/object_cache:BUILD.bazel",
        "//zircon/kernel/lib/page-map:BUILD.bazel",
        "//zircon/kernel/lib/percpu_writer:BUILD.bazel",
        "//zircon/kernel/lib/power-management:BUILD.bazel",
        "//zircon/kernel/lib/sched:BUILD.bazel",
        "//zircon/kernel/lib/spsc_buffer:BUILD.bazel",
        "//zircon/kernel/lib/stall:BUILD.bazel",
        "//zircon/kernel/lib/suspend_wakeup_timer:BUILD.bazel",
        "//zircon/kernel/lib/thread_sampler:BUILD.bazel",
        "//zircon/kernel/lib/wake-vector:BUILD.bazel",
        "//zircon/kernel/phys/lib/memalloc:BUILD.bazel",
        "//zircon/kernel/vm/phys:BUILD.bazel",
        "//zircon/system/ulib/affine:BUILD.bazel",
        "//zircon/system/ulib/bitmap:BUILD.bazel",
        "//zircon/system/ulib/concurrent:BUILD.bazel",
        "//zircon/system/ulib/fbl:BUILD.bazel",
        "//zircon/system/ulib/ffl:BUILD.bazel",
        "//zircon/system/ulib/hwreg:BUILD.bazel",
        "//zircon/system/ulib/page_tables:BUILD.bazel",
        "//zircon/system/ulib/ram-crashlog:BUILD.bazel",
    ],
)

sh_test(
    name = "layer_string_test",
    size = "small",
    srcs = ["layer_string_test_runner.sh"],
    args = [
        "--neutral-set",
        "$(rootpath :arch-neutral-set.txt)",
        # Expands to all 32 BUILD files; sh_test args are whitespace-split, which
        # is what makes one $(rootpaths ...) entry work here.
        "$(rootpaths :arch_neutral_build_files)",
    ],
    data = [
        "layer_string_test.py",
        ":arch-neutral-set.txt",
        ":arch_neutral_build_files",
    ],
)

