# ---------------------------------------------------------------------------
# Convenience target: run all active checks.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# runtime ABI symbol check.
# Asserts the historically-holed runtime symbols stay defined+exported in the
# TARGET-built libraries: setjmp/longjmp family in libc.so; the exception ABI
# (__cxa_throw/.../__gxx_personality_v0/_Unwind_*) and a REAL (nonzero-size)
# __cxa_demangle in libc++.so. Uses the prebuilt llvm-nm on the
# fuchsia-transitioned artifacts, so a silent unwiring can never regress.
# ---------------------------------------------------------------------------
fuchsia_artifact(
    name = "runtime_abi_libc_so.fuchsia",
    src = "//src/upstream/fuchsia/zircon/third_party/ulib/musl:libc_so",
)

fuchsia_artifact(
    name = "runtime_abi_libcxx_so.fuchsia",
    src = "//src/cerise/runtime:libc++.so",
)

sh_test(
    name = "runtime_abi_symbols_test",
    size = "small",
    srcs = ["runtime_abi_symbols_test.sh"],
    args = [
        "$(rootpath //toolchain:linux_x86_64/bin/llvm-nm.prebuilt)",
        "$(rootpaths :runtime_abi_libc_so.fuchsia)",
        "$(rootpaths :runtime_abi_libcxx_so.fuchsia)",
    ],
    data = [
        ":runtime_abi_libc_so.fuchsia",
        ":runtime_abi_libcxx_so.fuchsia",
        "//toolchain:linux_x86_64/bin/llvm-nm.prebuilt",
    ],
)

test_suite(
    name = "all",
    tests = [
        ":layer_string_self_test",
        ":layer_string_test",
        ":no_policy_in_build_self_test",
        ":no_policy_in_build_test",
        ":layering_negative_probe_self_test",
        ":layering_negative_probe",
        ":flag_manifest_golden_self_test",
        ":flag_manifest_golden_test",
        ":flag_manifest_golden_x64_phys_test",
        ":flag_manifest_golden_x86_32_phys_test",
        ":flag_manifest_golden_x64_efi_test",
        ":flag_manifest_golden_x64_user_test",
        ":flag_manifest_golden_rust_x64_user_test",
        ":no_genrule_in_image_self_test",
        ":no_genrule_in_image_test",
        ":hermeticity_self_test",
        ":hermeticity_test",
        ":sdk_visibility_self_test",
        ":sdk_visibility_test",
        ":toolchain_ambient_include_self_test",
        ":toolchain_ambient_include_test",
        ":arch_separation_proof_self_test",
        ":arch_separation_proof_test",
        ":github_actions_pin_self_test",
        ":github_actions_pin_test",
        ":runtime_abi_symbols_test",
        # Build-time CFv2 capability-routing + least-privilege checker.
        # Positive gate over the six real products + a non-vacuous negative gate.
        "//src/cerise/tools/route_check:route_check_test",
        "//src/cerise/tools/route_check:route_check_negative_test",
        # qemu_boot_test must parse marker contracts as JSON and emit escaped JSON reports.
