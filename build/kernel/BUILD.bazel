    "//src/lib/zbitl:zbitl",
    ":kernel_s4_stubs",
    "//:kernel_cc_headers",
] + _UTEST_KERNEL_TEST_LIBS

zircon_kernel(
    name = "vmzircon_utest",
    testonly = True,
    entry = "kZirconAbiSpec",
    linker_scripts = [
        "//:kernel_linker_script",
        ":x64_boot_cpuid_markers.ld",
    ],
    deps = _UTEST_KERNEL_DEPS,
)

kernel_image(
    name = "vmzircon_utest_image",
    testonly = True,
    kernel = ":vmzircon_utest",
)

kernel_package(
    name = "vmzircon_utest_package",
    testonly = True,
    kernel_image = ":vmzircon_utest_image",
    user_copy_patches = ":vmzircon_user_copy_patches",
    version_string = ":vmzircon_version_string",
    package_dir = "vmzircon_utest_package",
)

# Kernel storage ZBI for the unit-test kernel. Mirrors :kernel_storage_zbi but
# (1) packages :vmzircon_utest_package and (2) uses a cmdline that runs the
# in-kernel unit tests at boot and DROPS userboot.next-is-test=true.
genrule(
    name = "kernel_storage_utest_zbi",
    testonly = True,
    srcs = [
        ":vmzircon_utest_package",
        "//build/phys:physboot",
        "//build/vdso:userboot",
        "//build/vdso:libzircon",
        "//examples/userboot-smoke:userboot-smoke",
    ],
    outs = ["kernel_storage_utest.zbi"],
    cmd = " && ".join([
        "set -e",
        "manifest=$(RULEDIR)/kernel_storage_utest.manifest",
        ": > $$manifest",
        "for f in $(locations :vmzircon_utest_package); do case $$f in *image.elf) orig_image=$$f;; esac; done",
        "patched_image=$(RULEDIR)/kernel_utest_image_interp.elf",
        "python3 $(location //tools/zbi:set_elf_interp.py) --input $$orig_image --interp-from $(location //build/phys:physboot) --output $$patched_image",
        "for f in $(locations :vmzircon_utest_package); do d=$${f#*vmzircon_utest_package/}; case $$d in zircon/vmzircon/image.elf) printf '%s=%s\\n' \"$$d\" \"$$patched_image\" >> $$manifest;; *) printf '%s=%s\\n' \"$$d\" \"$$f\" >> $$manifest;; esac; done",
        "printf 'physboot=%s\\n' '$(location //build/phys:physboot)' >> $$manifest",
        "printf 'zircon/userboot=%s\\n' '$(location //build/vdso:userboot)' >> $$manifest",
        "for f in $(locations //build/vdso:libzircon); do case \"$$f\" in *.so) printf 'zircon/vdso=%s\\n' \"$$f\" >> $$manifest ;; esac; done",
        "bootfs=$(RULEDIR)/kernel_utest_bootfs.manifest",
        "printf 'bin/userboot-smoke=%s\\n' '$(location //examples/userboot-smoke:userboot-smoke)' > $$bootfs",
        "python3 $(location //tools/zbi:simple_zbi.py) --output $@ --cmdline 'kernel.serial=legacy kernel.enable-serial-syscalls=output-only kernel.phys.next=physboot kernel.select=zircon kernel.select.userboot=userboot userboot.next=bin/userboot-smoke kernel.shell.script=ut+all;boot-test-success kernel.wallclock=pit' --storage-kernel-manifest $$manifest --storage-bootfs-manifest $$bootfs",
    ]),
    tools = [
        "//tools/zbi:set_elf_interp.py",
        "//tools/zbi:simple_zbi.py",
    ],
)
