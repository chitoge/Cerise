# ═══════════════════════════════════════════════════════════════════════════════
# ON-TARGET KERNEL UNIT-TEST KERNEL (tests/zircon boot gate) — added block.
#
# Zircon's own in-kernel unit tests register via `UNITTEST_START_TESTCASE`
# (alwayslink, compiled INTO the kernel ELF), driven at runtime by the `ut`
# kernel-shell command. The stock `vmzircon` deliberately links NONE of the
# `*_tests` libraries (e.g. //zircon/kernel/lib/fbl:fbl compiles only arena.cc;
# fbl_tests is a separate testonly/manual lib), so `ut all` on the stock kernel
# runs zero cases. This kernel links the same closure PLUS a curated set of
# QEMU-safe kernel unit-test suites, so `ut all` runs real Zircon kernel tests.
#
# The deps list mirrors `vmzircon` above (kept a duplicate on purpose: the stock
# production kernel target stays byte-identical, and any drift is visible here).
# testonly=True throughout because the *_tests libs are testonly.
#
# Boot contract (see tests/zircon): the kernel_storage cmdline runs
#   kernel.shell.script=ut+all;boot-test-success
# `ut all` returns -1 on any failure (sets lastresult); `boot-test-success` then
# prints BOOT_TEST_SUCCESS:userspace-started ONLY when lastresult==0. The stock
# `userboot.next-is-test=true` is intentionally DROPPED here so that marker can
# only originate from a green `ut all`, never from userboot-smoke's clean exit.
# ═══════════════════════════════════════════════════════════════════════════════

_UTEST_KERNEL_TEST_LIBS = [
    # Curated kernel unit-test suites that use the in-kernel UNITTEST harness
    # (UNITTEST_START_TESTCASE, run by `ut`) and link cleanly into the kernel.
    # NOTE: only libs whose tests use the kernel harness belong here — e.g.
    # //zircon/kernel/lib/btree:btree_kernel_tests is a HOST-style test (includes
    # <malloc.h>) and does NOT compile against the kernel toolchain, so it is
    # intentionally excluded.
    "//zircon/kernel/lib/fbl:fbl_tests",
    "//zircon/kernel/lib/cbuf:cbuf_tests",
    "//zircon/kernel/lib/debuglog:debuglog_tests",
    "//zircon/kernel/vm/unittests:vm_snapshot_unittests",
]

