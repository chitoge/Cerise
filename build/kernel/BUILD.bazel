# ─── kernel storage ZBI assembled from Bazel-native chain ─────────────

genrule(
    name = "kernel_storage_zbi",
    srcs = [
        ":vmzircon_package",
        "//build/phys:physboot",
        "//build/vdso:userboot",
        "//build/vdso:libzircon",
        "//examples/userboot-smoke:userboot-smoke",
    ],
    outs = ["kernel_storage.zbi"],
    cmd = " && ".join([
        "set -e",
        "manifest=$(RULEDIR)/kernel_storage.manifest",
        ": > $$manifest",
        # Patch the kernel image.elf PT_INTERP with physboot's build ID.
        "for f in $(locations :vmzircon_package); do case $$f in *image.elf) orig_image=$$f;; esac; done",
        "patched_image=$(RULEDIR)/kernel_image_interp.elf",
        "python3 $(location //tools/zbi:set_elf_interp.py) --input $$orig_image --interp-from $(location //build/phys:physboot) --output $$patched_image",
        # Build manifest: use patched image.elf; copy other package files verbatim.
        "for f in $(locations :vmzircon_package); do d=$${f#*vmzircon_package/}; case $$d in zircon/vmzircon/image.elf) printf '%s=%s\\n' \"$$d\" \"$$patched_image\" >> $$manifest;; *) printf '%s=%s\\n' \"$$d\" \"$$f\" >> $$manifest;; esac; done",
        "printf 'physboot=%s\\n' '$(location //build/phys:physboot)' >> $$manifest",
        "printf 'zircon/userboot=%s\\n' '$(location //build/vdso:userboot)' >> $$manifest",
        # libzircon produces .so + header files; filter for the .so
        "for f in $(locations //build/vdso:libzircon); do case \"$$f\" in *.so) printf 'zircon/vdso=%s\\n' \"$$f\" >> $$manifest ;; esac; done",
        "bootfs=$(RULEDIR)/kernel_bootfs.manifest",
        "printf 'bin/userboot-smoke=%s\\n' '$(location //examples/userboot-smoke:userboot-smoke)' > $$bootfs",
        # kernel.wallclock=pit is the shared base default and stays here: every
        # x86 product that does not override it has qualified on the PIT
        # wallclock, and this ZBI is the default kernel storage for all of them.
        # A board that must not use PIT overrides this with a later CMDLINE item
        # (last-wins), e.g. //boards/hp-elitedesk-800-g3 appends
        # kernel.wallclock=auto because PIT starves that unit's AP timers. Do
        # NOT drop the pin from here to fix one board -- that silently reclocks
        # every other metal product.
        "python3 $(location //tools/zbi:simple_zbi.py) --output $@ --cmdline 'kernel.serial=legacy kernel.enable-serial-syscalls=output-only kernel.phys.next=physboot kernel.select=zircon kernel.select.userboot=userboot userboot.next=bin/userboot-smoke userboot.next-is-test=true kernel.wallclock=pit' --storage-kernel-manifest $$manifest --storage-bootfs-manifest $$bootfs",
    ]),
    tools = [
        "//tools/zbi:set_elf_interp.py",
        "//tools/zbi:simple_zbi.py",
    ],
)

cerise_architecture_artifact(
    name = "kernel_storage_zbi_artifact",
    src = ":kernel_storage_zbi",
    arch = "x86_64",
    kind = "kernel_storage",
)

