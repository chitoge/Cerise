"""Repository rule that unpacks OVMF UEFI firmware from a Debian .deb.

Cerise declares QEMU firmware as a pinned Bazel input —
no silent PATH/`/usr/share/ovmf` lookup. The upstream artifact is a Debian
`.deb`, which is an `ar(1)` archive wrapping `data.tar.xz`. Bazel's native
repository_ctx.extract supports tar/tar.xz/zip but NOT `ar`, so the first stage
shells out to `ar` (disclosed fallback per the spike brief); the second stage
uses the native tar.xz extractor.

Exports the split 4M firmware blobs:
  @ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd
  @ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd
"""

_BUILD_CONTENT = """# Generated by //bazel:ovmf.bzl — do not edit.
package(default_visibility = ["//visibility:public"])

exports_files([
    "usr/share/OVMF/OVMF_CODE_4M.fd",
    "usr/share/OVMF/OVMF_VARS_4M.fd",
])
"""

def _ovmf_repository_impl(rctx):
    rctx.download(
        url = rctx.attr.urls,
        output = "ovmf.deb",
        sha256 = rctx.attr.sha256,
    )

    # Stage 1: unpack the .deb (ar archive) to recover data.tar.xz. Native
    # extract does not understand `ar`, so shell out (disclosed fallback).
    ar_result = rctx.execute(["ar", "x", "ovmf.deb", "data.tar.xz"])
    if ar_result.return_code != 0:
        fail("ar extraction of OVMF .deb failed (rc=%d):\n%s" % (
            ar_result.return_code,
            ar_result.stderr,
        ))
    if not rctx.path("data.tar.xz").exists:
        fail("OVMF .deb did not contain data.tar.xz")

    # Stage 2: data.tar.xz is natively supported. This lands
    # usr/share/OVMF/OVMF_{CODE,VARS}_4M.fd in the repo root.
    rctx.extract(archive = "data.tar.xz")

    for blob in ["usr/share/OVMF/OVMF_CODE_4M.fd", "usr/share/OVMF/OVMF_VARS_4M.fd"]:
        if not rctx.path(blob).exists:
            fail("expected firmware blob %r missing after OVMF extraction" % blob)

    rctx.file("BUILD.bazel", _BUILD_CONTENT, executable = False)

ovmf_repository = repository_rule(
    implementation = _ovmf_repository_impl,
    doc = "Unpacks OVMF_CODE_4M.fd / OVMF_VARS_4M.fd from a Debian OVMF .deb.",
    attrs = {
        "urls": attr.string_list(
            mandatory = True,
            doc = "Mirror URLs for the OVMF .deb.",
        ),
        "sha256": attr.string(
            mandatory = True,
            doc = "Expected SHA-256 of the .deb.",
        ),
    },
)
