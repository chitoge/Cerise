    alias(
        name = _bundle_artifact,
        actual = "//bundles/artifacts:%s" % _bundle_artifact,
    )
    for _bundle_artifact in [
        "compat_so.fuchsia",
        "libc_so_dhxhost_pkg.fuchsia",
        "libcxx_so_dhxhost_pkg.fuchsia",
        "libfdio_so_dhxhost_pkg.fuchsia",
        "component_manager_stripped.fuchsia",
        "cerise_logsink_stripped.fuchsia",
    ]
]

