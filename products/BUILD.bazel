# ===========================================================================
# Products: board + bundles + product config through the
# cerise_product rule. This is now the ONLY product layer — the duplicated
# linear zircon_system() proof-gate product list it re-expressed has been
# retired. zircon_system() itself remains above only for the
# kernel-only smoke images (x64-smoke, arm64-*), which have no board/bundles.
#
# The root realm is a first-class cerise_product attr (root_realm = <label>),
# staged internally at pkg/root/meta/root.cm; it may not appear in
# product_bootfs. The realm .cml is authored in //src/cerise/realms and
# compiled by cmc (cerise_component), owning the root topology per §4.
# ===========================================================================

# qemu-x64-net: board qemu-x64 + component_framework + driver_framework + netstack3.
# The qemu-x64 board carries the full block-driver stack (nvme/ahci/display); in the
# net product those are harmless unbound drivers (no nvme_probe/ahci_probe client and
# display is dormant without a VGA device). netstack3.cm starts cleanly + exposes its
# protocols; the discovery/HTTP-echo proof rides qemu-x64-fileserver.
cerise_product(
    name = "qemu-x64-net",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_netstack3_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:netstack3_probe",
        "//bundles:network_uplink",
    ],
)

# qemu-x64-net-e1000e: identical composition to qemu-x64-net (same board, realm,
# bundles), but exercised under a DIFFERENT QEMU command line — validation/
# run-qemu.sh attaches ONLY the e1000e NIC (82574L, `-device e1000e`) with the
# hostfwd, and NO virtio-net device. With no virtio-net PCI device present the
# virtio_net driver never binds, so the e1000e driver publishes the sole
# /dev/class/network entry and netstack3_probe (which picks the first-enumerated
# instance) drives DHCP DORA over the e1000e's real descriptor rings. Reusing the
# qemu-x64 board's NIC-neutral network-device capability keeps the external
# connectivity contract satisfied while its e1000 implementation handles the NIC.
cerise_product(
    name = "qemu-x64-net-e1000e",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_netstack3_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:netstack3_probe",
        "//bundles:network_uplink",
    ],
)

# qemu-x64-storage: board qemu-x64 + component_framework + driver_framework +
# storage_fxfs — the fshost gate (fshost owns the disk lifecycle). The board's
# fshost owns the disk lifecycle and fshost_probe checks its automatic mount
# path. Consumed by //validation:fshost-boot + fshost-persistence.
cerise_product(
    name = "qemu-x64-storage",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_fshost_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:network_device_probe",
        "//bundles:storage_fxfs",
        "//bundles:storage_fxfs_fshost_probe",
    ],
)

# qemu-x64-pci: board qemu-x64 + component_framework + driver_framework + direct storage,
# with the BASE root realm (root_dfv2acpi) — nvme_probe/ahci_probe + fxfs_probe as the
# active terminal probes (the hand-driven Fxfs format+mount+write+remount+read flagship
# mount path). This product explicitly selects the direct block validation clients.
# This is the cerise re-expression
# of the retired legacy x64-pci kitchen-sink proof product; it has no dedicated boot gate
# (its markers were folded into the storage/fileserver gates) — its correctness is the
# bootfs equivalence with qemu-x64-storage's shared driver foundation. Bootable by hand via
# validation/run-qemu.sh qemu-x64-pci.
cerise_product(
    name = "qemu-x64-pci",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:network_device_probe",
        "//bundles:storage_fxfs_core",
        "//bundles:storage_fxfs_block_probes",
    ],
)

# qemu-x64-pkg: the packages foundation. Same board + bundles as
# qemu-x64-storage (component_framework + driver_framework + storage_fxfs), but the root
# realm is root_dfv2acpi_pkg — the terminal consumer is pkg_probe (not fshost_probe):
# after fshost auto-mounts, pkg_probe ingests a REAL Fuchsia package (meta.far + content
# blobs, built by cerise_package) into fshost's fxfs "blob" volume via
# fuchsia.fxfs/BlobCreator, then resolves it with the vendored package_directory crate
# (meta/package + the .cm + a content blob read back, merkle-verified). This realm
# uses no storage validation client; the board's display remains dormant.
# The demo package's blobs are staged into pkg_probe's OWN package (read from /pkg).
# Consumed by //validation:pkg-boot.
cerise_product(
    name = "qemu-x64-pkg",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_pkg_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:network_device_probe",
        "//bundles:storage_fxfs",
    ],
    product_bootfs = {
        # pkg_probe: the packages-foundation terminal consumer (replaces fshost_probe here).
        "pkg/pkg_probe/meta/pkg_probe.cm": "//src/cerise/realms:pkg_probe_manifest",
        "pkg/pkg_probe/bin/pkg_probe": "//src/cerise/pkg_probe:pkg_probe_stripped.fuchsia",
        "pkg/pkg_probe/lib/ld.so.1": ":libc_so_pkg_probe_pkg.fuchsia",
        "pkg/pkg_probe/lib/libm.so": ":libm_so_pkg_probe_pkg.fuchsia",
        "pkg/pkg_probe/lib/libc++.so.1": ":libcxx_so_pkg_probe_pkg.fuchsia",
        # The demonstration package's blobs (meta.far + 4 content blobs + ingest manifest),
        # staged into pkg_probe's OWN package so it reads them from /pkg and ingests them into the
        # fxfs "blob" volume. Blob order (cerise_package sorts by package path): blob_0 bin/pkg_hello,
        # blob_1 lib/ld.so.1, blob_2 lib/libc++.so.1, blob_3 lib/libm.so.
        "pkg/pkg_probe/blobs/meta.far": "//src/cerise/pkg_hello:pkg_hello_meta_far",
        "pkg/pkg_probe/blobs/manifest.json": "//src/cerise/pkg_hello:pkg_hello_manifest_json",
        "pkg/pkg_probe/blobs/blob_0": "//src/cerise/pkg_hello:pkg_hello_blob_0",
        "pkg/pkg_probe/blobs/blob_1": "//src/cerise/pkg_hello:pkg_hello_blob_1",
        "pkg/pkg_probe/blobs/blob_2": "//src/cerise/pkg_hello:pkg_hello_blob_2",
