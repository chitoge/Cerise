# cf-sz5-shutdown: THE SAME orderly-shutdown product, paired with //boards/cf-sz5.
#
# WHY IT EXISTS — it is a SAFETY HARNESS, not a feature. //boards/cf-sz5 indexes
# the e1000 driver, and on that machine the I219-LM it binds is also the path
# Intel AMT rides on (see //boards/cf-sz5 for the full story). Exercising a
# driver change against that NIC on the real unit therefore risks taking out the
# only remote console AND the only remote power control at the same time, which
# costs a physical trip to the laptop.
#
# cf-sz5-firstlight — the other product on this board — starts component_manager
# and NEVER TERMINATES, so a boot that kills AMT strands the machine running
# Cerise with no way back. This product terminates on its own instead:
# shutdown_trigger waits for driver enumeration to quiesce (so e1000 HAS bound
# and logged) and then drives the real poweroff chain. Because BootNext is
# one-shot, the machine then falls back to the previous OS, which is reachable
# over SSH. So even the worst case — the change makes AMT worse, not better —
# leaves a recoverable machine.
#
# It carries the driver_framework bundle but NOT netstack3, so it proves bind /
# manageability-state / MAC and nothing about DHCP. That is the point: it is the
# cheap, reversible first step, and cf-sz5-firstlight is the second.
#
# No QEMU gate: OVMF has no UART at 0xf0a0 and no I219 (//validation:shutdown-boot
# already gates the shutdown chain itself on the qemu-x64 board). Deployment
# artifact — copy the .zbi to the unit's ESP as \bootx64.zbi and one-shot
# BootNext the `cerise` entry.
cerise_product(
    name = "cf-sz5-shutdown",
    board = "//boards/cf-sz5",
    root_realm = "//src/cerise/realms:root_dfv2acpi_shutdown_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
    ],
    product_bootfs = {
        "pkg/driver_manager_rust_dfv2platbus/meta/driver_manager_rust_dfv2acpi_shutdown.cm": "//src/cerise/realms:driver_manager_rust_dfv2acpi_shutdown_manifest",
        "pkg/shutdown_shim/meta/shutdown_shim.cm": "//src/cerise/realms:shutdown_shim_manifest",
        "pkg/shutdown_trigger/meta/shutdown_trigger.cm": "//src/cerise/shutdown_trigger:shutdown_trigger_manifest",
        "pkg/shutdown_trigger/bin/shutdown_trigger": "//src/cerise/shutdown_trigger:shutdown_trigger_bin_stripped.fuchsia",
        "pkg/shutdown_trigger/lib/ld.so.1": ":libc_so_shutdown_trigger_pkg.fuchsia",
        "pkg/shutdown_trigger/lib/libm.so": ":libm_so_shutdown_trigger_pkg.fuchsia",
        "pkg/shutdown_trigger/lib/libc++.so.1": ":libcxx_so_shutdown_trigger_pkg.fuchsia",
    },
)

# -----------------------------------------------------------------------------
# OS-self-OTA products (//validation:ota-update-boot). Same driver base as
# qemu-x64-shutdown (for the statecontrol reboot chain) PLUS netstack3 (for the
# HTTP fetch); NO storage_fxfs (its fxfs_provisioner would format the ESP). The
# ota_updater is the sole disk writer. Two products from ONE binary, differing
# only by the staged /pkg/data/ota-config.json: qemu-x64-ota is the v1 factory
# image (apply=true — it fetches + stages v2), qemu-x64-ota-v2 is the update
# target (apply=false — it only success-commits). qemu-x64-ota-v2's ZBI is the
# gate's host-served download payload.
fuchsia_stripped(
    name = "libc_so_ota_updater_pkg.fuchsia",
    src = "//src/upstream/fuchsia/zircon/third_party/ulib/musl:libc_so",
)

