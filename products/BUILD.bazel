# board's kernel cmdline: `kernel.serial=ioport,0xf0a0,19` (the AMT
# Serial-over-LAN 16550A) in place of hw-x64's `kernel.serial=legacy` (COM1 at
# 0x3f8, which does not exist on a CF-SZ5). Everything else — realm, bundles,
# drivers, storage posture — is byte-for-byte the hw-x64 first-light image.
#
# WHY IT IS A SEPARATE PRODUCT: hw-x64-firstlight backs the green QEMU gate
# //validation:firstlight-uefi-boot, whose OVMF machine has COM1 and no UART at
# 0xf0a0. Retargeting hw-x64's cmdline in place would have silenced that gate.
#
# STORAGE POSTURE is inherited unchanged and matters here more than anywhere
# else: this product is booted on a laptop whose internal SATA disk holds a live
# Ubuntu install. The console realm never starts fshost/fxfs_provisioner, so the
# AHCI driver enumerates the disk and NOTHING WRITES TO IT.
#
# QEMU gate: //validation:cf-sz5-uefi-boot (an OVMF machine given a real
# isa-serial at 0xf0a0 IRQ 19, so the cmdline is exercised, not assumed).
cerise_product(
    name = "cf-sz5-firstlight",
    board = "//boards/cf-sz5",
    bundles = FIRSTLIGHT_BUNDLES,
    root_realm = "//src/cerise/realms:root_dfv2acpi_console_manifest",
    product_bootfs = FIRSTLIGHT_PRODUCT_BOOTFS,
)

