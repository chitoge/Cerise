    name = "qemu-x64-ota-v2",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_ota_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:network_uplink",
    ],
    product_bootfs = {
        "pkg/driver_manager_rust_dfv2platbus/meta/driver_manager_rust_dfv2acpi_shutdown.cm": "//src/cerise/realms:driver_manager_rust_dfv2acpi_shutdown_manifest",
        "pkg/shutdown_shim/meta/shutdown_shim.cm": "//src/cerise/realms:shutdown_shim_manifest",
        "pkg/ota_updater/meta/ota_updater.cm": "//src/cerise/ota_updater:ota_updater_manifest",
        "pkg/ota_updater/bin/ota_updater": "//src/cerise/ota_updater:ota_updater_bin_stripped.fuchsia",
        "pkg/ota_updater/lib/ld.so.1": ":libc_so_ota_updater_pkg.fuchsia",
        "pkg/ota_updater/lib/libm.so": ":libm_so_ota_updater_pkg.fuchsia",
        "pkg/ota_updater/lib/libc++.so.1": ":libcxx_so_ota_updater_pkg.fuchsia",
        # v2 update-target config: version 2, do NOT apply (only success-commit).
        "pkg/ota_updater/data/ota-config.json": "//src/cerise/ota_updater:data/ota-config-v2.json",
        # Staged even though apply=false and this image therefore never verifies
        # anything: the two OTA products must have the SAME trust posture, or the
        # image an update installs would be one that could not itself update.
        "pkg/ota_updater/keys/ota_image_pub.ed25519": "//src/cerise/ota_updater:ota_image_pubkey",
    },
)

# ---------------------------------------------------------------------------------------------
# qemu-x64-store-push — the appliance that RECEIVES a pushed guest image and writes it to the
# raw guest-image GPT partition.
#
# The driver base + netstack3 + guest_store_receiver, and nothing else. The receiver is the
# SOLE disk writer in this product: no fshost, no provisioner, no file server, no probes. That
# is load-bearing rather than minimal-by-taste — the refusal gates claim "a refused push wrote
# nothing to this disk", and a product carrying a second writer would make that a claim about
# the product instead of about the receiver.
#
# The public key it checks pushed manifests against is staged here. The receiver REFUSES every
# push without one (fail closed, unlike pkg_resolver's safe degradation), so this entry is
# load-bearing and not decorative. What a signature made with it establishes is stated in
# build/keys/README.md and nowhere is it described as establishing authenticity.
# ---------------------------------------------------------------------------------------------
fuchsia_stripped(
    name = "libc_so_guest_store_pkg.fuchsia",
    src = "//src/upstream/fuchsia/zircon/third_party/ulib/musl:libc_so",
)

fuchsia_stripped(
    name = "libcxx_so_guest_store_pkg.fuchsia",
    src = "//src/cerise/runtime:libc++.so",
)

cerise_product(
    name = "qemu-x64-store-push",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_store_push_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:network_uplink",
    ],
    product_bootfs = {
        "pkg/guest_store_receiver/meta/guest_store_receiver.cm": "//src/cerise/guest_store_receiver:guest_store_receiver_manifest",
        "pkg/guest_store_receiver/bin/guest_store_receiver": "//src/cerise/guest_store_receiver:guest_store_receiver_bin_stripped.fuchsia",
        # ld.so.1 and libc++.so.1 only. Measured with `readelf -d` on the built binary:
        # DT_NEEDED is libzircon.so (the vDSO, which needs no staging), libc.so and
        # libc++.so.1. No libm.so, because nothing links -lm, and no libfdio.so, because
        # real fdio is statically linked.
        "pkg/guest_store_receiver/lib/ld.so.1": ":libc_so_guest_store_pkg.fuchsia",
        "pkg/guest_store_receiver/lib/libc++.so.1": ":libcxx_so_guest_store_pkg.fuchsia",
        "pkg/guest_store_receiver/keys/guest_store_pub.ed25519": "//src/cerise/guest_store_receiver:guest_store_pubkey",
    },
)

