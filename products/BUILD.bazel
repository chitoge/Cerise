# Baseline smoke product: kernel + userboot-smoke, no extras.
zircon_system(
    name = "x64-smoke",
)

# cf-sz5-smoke: minimal bring-up probe for the Panasonic CF-SZ5 (//boards/cf-sz5).
# x64-smoke (kernel + userboot-smoke, no drivers, no userspace stack) carrying
# the board's console cmdline, so it exercises the console and nothing else. At
# ~8 MB against the ~60 MB first-light image it also separates "the console is
# wrong" from "the ESP load is slow or failing".
#
# It inherits x64-smoke's `userboot.next-is-test=true`, so on success userboot
# prints CERISE-SMOKE-OK and then calls
# zx_system_powerctl(ZX_SYSTEM_POWERCTL_SHUTDOWN)
# (zircon/kernel/lib/userabi/userboot/start.cc HandleTermination).
#
# MEASURED ON THE REAL UNIT (2026-07-25), and worth recording because the
# obvious interpretation is wrong: powering off is NOT a reliable out-of-band
# "it booted" signal here. Booting this image left the machine On and it fell
# back to the previous OS ~20s later than a plain reboot, and a variant built
# with `userboot.next-is-test=false` (which exits instead of shutting down)
# behaved the SAME. Both endings are a machine that stops running Cerise, so on
# this box neither distinguishes "kernel ran and finished" from "loader gave up".
# The image that actually discriminates is the first-light one: it starts
# component_manager and never terminates, so the machine simply never returns to
# the fallback OS — which is what was observed, twice, for >4 minutes each.
zircon_system(
    name = "cf-sz5-smoke",
    cmdline = ["kernel.serial=ioport,0xf0a0,0"],
)

# post-mortem gate product (//validation:crashlog-boot). x64-smoke plus:
#   * a ZBI_TYPE_NVRAM persistent-RAM region so the PC platform binds
#     MappedCrashlog (ram-crashlog) instead of the no-op crashlog. Placed at
#     0x40000000 (1 GiB) — the MIDDLE of the 2 GiB guest the harness boots — so
#     it is clear of BOTH the low kernel decompression AND the high data-ZBI
#     reload that a `-kernel` warm reboot performs; the kernel carves it out
#     (memalloc::Type::kNvram) so it is never used for general allocation, and
#     QEMU DRAM contents survive `system_reset`, so a stowed crashlog persists.
#   * kernel.cerise-test-crashlog=true: the self-terminating recovery-gated
#     trigger (zircon/kernel/platform/pc/platform.cc cerise_crashlog_test_hook) —
#     panic on the cold boot, print the recovered crashlog on the warm boot.
# Test-only; never referenced by a real product.
zircon_system(
    name = "x64-crashlog",
    cmdline = ["kernel.cerise-test-crashlog=true"],
    nvram = ["0x40000000,0x20000"],
)

# VMM host: boots the native cerise userspace VMM (src/cerise/vmm) as the initial
# process. cerise_rt extracts the SYSTEM resource from the bootstrap message so the
# VMM's guest_create succeeds; it then launches its embedded guest blob. Requires a
# host that exposes hardware virtualization (VMX) to the guest; on a platform
# without it the VMM takes its guest_create-failure path.
# Stage the VMM binary under //platforms:x64-user (Cerise static-PIE userspace).
cerise_artifact(
    name = "cerise-vmm.staged",
    src = "//src/cerise/vmm:cerise-vmm",
)

zircon_system(
    name = "x64-vmm",
    cmdline = ["userboot.next=bin/cerise-vmm"],
    extra_bootfs = {"bin/cerise-vmm": ":cerise-vmm.staged"},
)

# Arm64 smoke product — qemu-system-aarch64 -M virt (GICv2/v3, PL011, PSCI).
# No userboot/vdso: first-boot acceptance uses kernel-level serial markers only.
# QEMU arm64 virt DRAM: 0x40000000 base, 0x80000000 length (2GB), type=RAM(1).
zircon_system(
    name = "arm64-smoke",
    physload = "//build/phys:arm64-physload",
    kernel_storage = "//build/kernel:arm64_kernel_storage_zbi",
    mem_config = ["0x40000000,0x80000000,1"],
)

# arm64 userspace boot demo — hello-arm64 as initial process.
zircon_system(
    name = "arm64-hello",
    physload = "//build/phys:arm64-physload",
    kernel_storage = "//build/kernel:arm64_kernel_storage_zbi",
    mem_config = ["0x40000000,0x80000000,1"],
    cmdline = ["userboot.next=bin/hello-arm64", "kernel.enable-serial-syscalls=output-only"],
    extra_bootfs = {"bin/hello-arm64": "//examples/hello-arm64:hello_arm64_bin"},
)

