# ---------------------------------------------------------------------------
# runtime (PCI-enum gate) — STAGING product.
#
# This runtime product extends the driver framework by STAGING the two real drivers
# (board/drivers/x86 + bus/drivers/pci) into bootfs as driver packages: each gets
# its compiled manifest (.cm), its loadable .so (cc_shared_library; the driver_host
# provides symbols at dlopen, so no per-package runtime libs), and its bind bytecode
# (.bindbc) at the CML-referenced meta/bind/ path.
#
# NOTE: this only STAGES the artifacts + proves the ZBI assembles. Actually loading
# and enumerating them requires driver-index real config + driver_host dynamic
# loading (the compat-shim dlopen path) — the next runtime step. No PCI-enum marker
# is asserted yet.
# This was once an unstripped fuchsia_artifact and shipped a
# 162 MB .so with 91.5 MB of .symtab/.strtab, the single biggest strippable win.
# Now fuchsia_stripped like every other staged ELF (--strip-all keeps .dynsym, so
# compat's /pkg/driver read + the loader dlopen are unchanged). The board-owned
# artifact aliases below keep the historical product labels available.

alias(
    name = "platform_bus_x86_so.fuchsia",
    actual = "//boards/x64-artifacts:platform_bus_x86_so.fuchsia",
)

