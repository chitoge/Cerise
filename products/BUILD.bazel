# The trust-root negative control: the same product with the public key NOT staged, and
# nothing else changed.
#
# It exists because "the receiver fails closed without a key" is otherwise a claim that only
# a host unit test makes. On a live machine, a component that could not find its key might
# equally well proceed — the code that would tell them apart is one `Option` — so the product
# that omits it is what turns the host test's `NoPubkey` into an observed refusal on a real
# push over a real socket.
cerise_product(
    name = "qemu-x64-store-push-nokey",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_store_push_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:network_uplink",
    ],
    product_bootfs = {
        "pkg/guest_store_receiver/meta/guest_store_receiver.cm": "//src/cerise/guest_store_receiver:guest_store_receiver_manifest",
        "pkg/guest_store_receiver/bin/guest_store_receiver": "//src/cerise/guest_store_receiver:guest_store_receiver_bin_stripped.fuchsia",
        "pkg/guest_store_receiver/lib/ld.so.1": ":libc_so_guest_store_pkg.fuchsia",
        "pkg/guest_store_receiver/lib/libc++.so.1": ":libcxx_so_guest_store_pkg.fuchsia",
        # No keys/ entry. That is the variable.
    },
)
