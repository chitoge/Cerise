fuchsia_stripped(
    name = "libcxx_so_ota_updater_pkg.fuchsia",
    src = "//src/cerise/runtime:libc++.so",
)

cerise_product(
    name = "qemu-x64-ota",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_ota_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:network_uplink",
    ],
    product_bootfs = {
        "pkg/driver_manager_rust_dfv2platbus/meta/driver_manager_rust_dfv2acpi_shutdown.cm": "//src/cerise/realms:driver_manager_rust_dfv2acpi_shutdown_manifest",
        "pkg/shutdown_shim/meta/shutdown_shim.cm": "//src/cerise/realms:shutdown_shim_manifest",
        "pkg/ota_updater/meta/ota_updater.cm": "//src/cerise/ota_updater:ota_updater_manifest",
        "pkg/ota_updater/bin/ota_updater": "//src/cerise/ota_updater:ota_updater_bin_stripped.fuchsia",
        "pkg/ota_updater/lib/ld.so.1": ":libc_so_ota_updater_pkg.fuchsia",
        "pkg/ota_updater/lib/libm.so": ":libm_so_ota_updater_pkg.fuchsia",
        "pkg/ota_updater/lib/libc++.so.1": ":libcxx_so_ota_updater_pkg.fuchsia",
        # v1 factory config: version 1, apply the update.
        "pkg/ota_updater/data/ota-config.json": "//src/cerise/ota_updater:data/ota-config-v1.json",
        # The OTA trust root: the ed25519 PUBLIC key the updater verifies the fetched
