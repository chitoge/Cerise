# qemu-x64-pkg-update: packages — UPDATABLE packages over the network. Same board
# as qemu-x64-pkg plus netstack3 and network_uplink (for the network stack and
# a board-provided external interface). The root
# realm is root_dfv2acpi_pkg_update: pkg_fetcher ingests the BASE package v1, launches it from the
# bootfs BASE index, then DOWNLOADS v2 over the network from the host, merkle-verifies + installs it,
# registers it in the PERSISTENT dynamic index on the fxfs data volume, and launches v2 from the
# dynamic index (which shadows base). On reboot the index + blobs persist -> v2 resolves with no
# re-fetch. Only v1's blobs ship in the image (as the fetcher's ingest source + the resolver's base
# index); v2's artifacts are the gate's host-served download payload. Consumed by
# //validation:pkg-update-boot.
cerise_product(
    name = "qemu-x64-pkg-update",
    board = "//boards/qemu-x64",
    root_realm = "//src/cerise/realms:root_dfv2acpi_pkg_update_manifest",
    bundles = [
        "//bundles:component_framework",
        "//bundles:driver_framework",
        "//bundles:netstack3",
        "//bundles:network_uplink",
        "//bundles:storage_fxfs",
    ],
    product_bootfs = {
        # pkg_fetcher: the update driver (replaces pkg_probe here).
        "pkg/pkg_fetcher/meta/pkg_fetcher.cm": "//src/cerise/realms:pkg_fetcher_manifest",
        "pkg/pkg_fetcher/bin/pkg_fetcher": "//src/cerise/pkg_fetcher:pkg_fetcher_stripped.fuchsia",
        "pkg/pkg_fetcher/lib/ld.so.1": ":libc_so_pkg_fetcher_pkg.fuchsia",
        "pkg/pkg_fetcher/lib/libm.so": ":libm_so_pkg_fetcher_pkg.fuchsia",
        "pkg/pkg_fetcher/lib/libc++.so.1": ":libcxx_so_pkg_fetcher_pkg.fuchsia",
        # (signed index): the ed25519 PUBLIC key the fetcher verifies downloaded signed entries
        # against (fail-fast) before merging them into the persistent dynamic index.
        "pkg/pkg_fetcher/keys/pkg_index_pub.ed25519": "//src/cerise/pkg_hello_update:pkg_index_pubkey_fetcher",
        # The BASE package (v1) blobs + ingest manifest, staged into pkg_fetcher's OWN package so it
        # reads them from /pkg and ingests them into the fxfs "blob" volume. Blob order (sorted by
        # package path): blob_0 bin/pkg_hello, blob_1 lib/ld.so.1, blob_2 lib/libc++.so.1, blob_3
        # lib/libm.so. v2 is NOT staged — it comes over the network.
        "pkg/pkg_fetcher/blobs/meta.far": "//src/cerise/pkg_hello_update:pkg_hello_v1_meta_far",
        "pkg/pkg_fetcher/blobs/manifest.json": "//src/cerise/pkg_hello_update:pkg_hello_v1_manifest_json",
        "pkg/pkg_fetcher/blobs/blob_0": "//src/cerise/pkg_hello_update:pkg_hello_v1_blob_0",
        "pkg/pkg_fetcher/blobs/blob_1": "//src/cerise/pkg_hello_update:pkg_hello_v1_blob_1",
        "pkg/pkg_fetcher/blobs/blob_2": "//src/cerise/pkg_hello_update:pkg_hello_v1_blob_2",
        "pkg/pkg_fetcher/blobs/blob_3": "//src/cerise/pkg_hello_update:pkg_hello_v1_blob_3",
        # pkg_resolver: its BASE index is v1's ingest manifest (pkg_hello -> v1 merkle). The dynamic
        # index (written by pkg_fetcher onto the data volume) shadows this at resolve time.
        "pkg/pkg_resolver/meta/pkg_resolver.cm": "//src/cerise/realms:pkg_resolver_manifest",
        "pkg/pkg_resolver/bin/pkg_resolver": "//src/cerise/pkg_resolver:pkg_resolver_stripped.fuchsia",
        "pkg/pkg_resolver/lib/ld.so.1": ":libc_so_pkg_resolver_pkg.fuchsia",
        "pkg/pkg_resolver/lib/libm.so": ":libm_so_pkg_resolver_pkg.fuchsia",
        "pkg/pkg_resolver/lib/libc++.so.1": ":libcxx_so_pkg_resolver_pkg.fuchsia",
        "pkg/pkg_resolver/index/manifest.json": "//src/cerise/pkg_hello_update:pkg_hello_v1_index_json",
        # (signed index): the ed25519 PUBLIC key the resolver verifies dynamic-index entries
        # against at load — the trust boundary that honors ONLY signer-blessed entries.
        "pkg/pkg_resolver/keys/pkg_index_pub.ed25519": "//src/cerise/pkg_hello_update:pkg_index_pubkey_resolver",
    },
)

