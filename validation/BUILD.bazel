# the .build-id debug-symbol store for the x64-smoke boot.
# Collects the UNSTRIPPED ELFs of every module a smoke boot's symbolizer markup
# references — physload, physboot, the kernel (vmzircon) and the vDSO (libzircon)
# — into a .build-id/xx/rest.debug tree. //src/cerise/tools/symbolize and gdb's
# `set debug-file-directory` resolve boot backtraces against this store. Richer
# products extend `binaries` with their fuchsia_stripped userspace/driver targets
# (which expose CeriseUnstrippedInfo).
cerise_debug_symbols(
    name = "x64-smoke.build-id",
    binaries = [
        "//build/phys:physload",
        "//build/phys:physboot",
        "//build/kernel:vmzircon",
        "//build/vdso:libzircon",
    ],
)

# post-mortem: the .build-id store for the crash-handler gate. Collects the
# UNSTRIPPED ELFs of the crasher (whose fault PC the gate symbolizes) and the
# crash_handler, so //src/cerise/tools/symbolize resolves the markup crash_handler
# emits into named crasher frames.
cerise_debug_symbols(
    name = "crash-handler.build-id",
    binaries = [
        "//src/cerise/crasher:crasher_bin_stripped.fuchsia",
        "//src/cerise/crash_handler:crash_handler_bin_stripped.fuchsia",
    ],
)

# (debugging): store AUTO-DISCOVERY for a RICH product. Instead
# of a hand-maintained `binaries` list, `product =` runs an aspect over the whole
# qemu-x64-console dep graph and collects the unstripped ELF of every staged
# userspace component/driver/shared-lib (every CeriseUnstrippedInfo target). The
# kernel/phys/vdso ELF targets are NOT in the product graph (only their assembled
# ZBIs are), so they stay in the explicit `binaries` list — the two compose. This
# is the follow-up ("the product's ProductBundleInfo keeps only staged Files,
# not the providers, so it wants an aspect"). See bazel/debug_symbols.bzl.
cerise_debug_symbols(
    name = "qemu-x64-console.build-id",
    product = "//products:qemu-x64-console",
    binaries = [
        "//build/phys:physload",
        "//build/phys:physboot",
        "//build/kernel:vmzircon",
        "//build/vdso:libzircon",
    ],
)

# proof: a NORMAL opt component (no per-target debug flags) symbolizes to a real
# function name + file:line from its unstripped store copy — the #40 `<no symbols>`
# caveat is closed by the global fuchsia-transition/toolchain debug info. Structural
# (no boot): picks a function PC in each crash-handler-store ELF and runs
# llvm-symbolizer. crash_handler never carried the crasher's old special flags.
sh_test(
    name = "normal_symbolization_test",
    size = "small",
    srcs = ["normal_symbolization_test_runner.sh"],
    args = [
        "--store=$(rootpath :crash-handler.build-id)",
        # Prebuilt minimal-toolchain tools (NOT //toolchain:llvm_nm, which aliases the
        # from-SOURCE @llvm-project//llvm:llvm-nm — an hours-long build).
        "--nm=$(rootpath @zr_llvm_toolchain_minimal_linux_amd64//:bin/llvm-nm)",
        "--symbolizer=$(rootpath @zr_llvm_toolchain_minimal_linux_amd64//:bin/llvm-symbolizer)",
    ],
    data = [
        "normal_symbolization_test.py",
        ":crash-handler.build-id",
        "@zr_llvm_toolchain_minimal_linux_amd64//:bin/llvm-nm",
        "@zr_llvm_toolchain_minimal_linux_amd64//:bin/llvm-symbolizer",
    ],
)

# coverage: every ELF staged into the RICH qemu-x64-console bootfs has its
# build-id present in the aspect-built store (the real promise: an auto-discovered
# store covers a product that stages drivers/components, not just 4 smoke modules).
# Passes --zstd-tool (the console bootfs is zstd-compressed) and a raised
# --min-entries floor.
sh_test(
    name = "build_id_store_test_console",
    size = "medium",
    srcs = ["build_id_store_test_runner.sh"],
    args = [
        "--store=$(rootpath :qemu-x64-console.build-id)",
        "--zbi=$(rootpath //products:qemu-x64-console)",
        "--readelf=$(rootpath //toolchain:llvm_readelf)",
        "--bootfs-diff=$(rootpath //assembly/tools:bootfs_diff.py)",
        "--zstd-tool=$(rootpath //tools/zstd:zstd_cli)",
        "--min-entries=10",
    ],
    data = [
        "build_id_store_test.py",
        ":qemu-x64-console.build-id",
        "//products:qemu-x64-console",
        "//toolchain:llvm_readelf",
        "//assembly/tools:bootfs_diff.py",
        "//tools/zstd:zstd_cli",
    ],
)

# Store-coverage + integrity gate: asserts every collected .debug ELF actually
# carries the build-id its store path claims, and that the modules a smoke boot
# symbolizes are all present. Reuses bootfs_diff.py's STORAGE_BOOTFS parser to
# enforce the design invariant "every staged bootfs ELF's build-id is in the
# store" against the x64-smoke ZBI. Stdlib-only python via an sh_test runner
# (this tree has no rules_python), matching build/checks/*_test convention.
sh_test(
    name = "build_id_store_test",
    size = "small",
    srcs = ["build_id_store_test_runner.sh"],
    args = [
        "--store=$(rootpath :x64-smoke.build-id)",
        "--zbi=$(rootpath //products:x64-smoke)",
        "--readelf=$(rootpath //toolchain:llvm_readelf)",
        "--bootfs-diff=$(rootpath //assembly/tools:bootfs_diff.py)",
    ],
    data = [
        "build_id_store_test.py",
        ":x64-smoke.build-id",
        "//products:x64-smoke",
        "//toolchain:llvm_readelf",
        "//assembly/tools:bootfs_diff.py",
    ],
)

# ZBI size: structural gate that every ELF staged into a
# product bootfs is stripped of its non-allocated symbol table. Parses the actual
# STORAGE_BOOTFS of the flagship qemu-x64-console ZBI (which stages libc.so/
# libc++.so.1/the libm stub/platform-bus-x86.so — the ELFs that previously shipped
# with a .symtab) and fails on any staged ELF carrying SHT_SYMTAB, except the
# `bin/userboot*` Zircon-toolchain payload (allowlisted). Reuses bootfs_diff.py's
# parser; stdlib-only python via an sh_test runner.
sh_test(
    name = "no_unstripped_bootfs_elf_test",
    size = "medium",
    srcs = ["no_unstripped_bootfs_elf_test_runner.sh"],
    args = [
        "--zbi=$(rootpath //products:qemu-x64-console)",
        "--bootfs-diff=$(rootpath //assembly/tools:bootfs_diff.py)",
        # qemu-x64-console ships a zstd-compressed STORAGE_BOOTFS;
        # decompress it so the staged ELFs are actually scanned, not skipped.
        "--zstd-tool=$(rootpath //tools/zstd:zstd_cli)",
    ],
    data = [
        "no_unstripped_bootfs_elf_test.py",
        "//products:qemu-x64-console",
        "//assembly/tools:bootfs_diff.py",
        "//tools/zstd:zstd_cli",
    ],
)

# ZBI size (the ".dynstr diet"): structural gate that every
# leaf DFv2 driver .so staged into a product bootfs exports ONLY
# __fuchsia_driver_registration__ (its version-script surface) and has not
# regressed to export-everything (-rdynamic/--export-dynamic), which is what
# re-inflates .dynstr into the tens of MB. Parses the actual STORAGE_BOOTFS of
# the flagship qemu-x64-console ZBI (reusing bootfs_diff.py's parser); asserts a
# symbol invariant, not a byte threshold. platform-bus.so (the deferred 30.9 MB
# --export-dynamic prize) and compat.so (curated DFv1 ABI) are allowlisted.
sh_test(
    name = "driver_export_surface_test",
    size = "medium",
    srcs = ["driver_export_surface_test_runner.sh"],
    args = [
        "--zbi=$(rootpath //products:qemu-x64-console)",
        "--bootfs-diff=$(rootpath //assembly/tools:bootfs_diff.py)",
        # qemu-x64-console ships a zstd-compressed STORAGE_BOOTFS;
        # decompress it so the staged driver .so's are actually scanned.
        "--zstd-tool=$(rootpath //tools/zstd:zstd_cli)",
    ],
    data = [
        "driver_export_surface_test.py",
        "//products:qemu-x64-console",
        "//assembly/tools:bootfs_diff.py",
        "//tools/zstd:zstd_cli",
    ],
)

