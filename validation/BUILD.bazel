# -----------------------------------------------------------------------------
# OS-self-OTA UPDATE gate (//validation:ota-update-boot). Slot A = qemu-x64-ota
# (v1, apply=true); the in-OS ota_updater fetches qemu-x64-ota-v2's ZBI over HTTP
# (host server, sha256-verified), writes it to \zircon_b.zbi, flips \abr, and
# reboots; the shim then boots B = v2. Two launches on one persistent disk prove
# apply -> boot-new-slot; :ota-update-tamper-boot is the negative control (one launch,
# corrupt-signature manifest, must refuse and must not write); //validation:ota-persist-boot
# covers persistence. See ota_update_boot_test.py.

# Staged \abr: active=A, successful[A]=1 (A is the factory-good slot; B is empty).
genrule(
    name = "ota-update-abr",
    srcs = ["make_abr.py"],
    outs = ["ota_update_abr.bin"],
    cmd = "python3 $(location make_abr.py) --active A --tries-a 0 --succ-a 1 " +
          "--tries-b 0 --succ-b 0 --out $@",
)

uefi_esp_image(
    name = "ota-update-uefi-esp",
    arch = "x86_64",
    efi_binary = "//zircon/kernel/phys/boot-shim:efi-boot-shim",
    files = {
        # Slot A = the v1 factory OTA product; slot B is a placeholder the updater
        # overwrites with the fetched v2 image (the shim never boots B until then).
        "//products:qemu-x64-ota": "zircon_a.zbi",
        ":ota-truncated-zbi": "zircon_b.zbi",
        ":ota-update-abr": "abr",
    },
    # ~62 MiB per slot ZBI; 256 MiB holds both (v1 + the applied v2) + FAT + shim.
    size_mb = 256,
    volume_label = "CERISE",
)

uefi_disk_image(
    name = "ota-update-uefi-disk",
    esp = ":ota-update-uefi-esp",
    size_mb = 300,
)

# The SIGNED manifest the host serves alongside the v2 ZBI, and its corrupt-signature
# twin. Built by //src/cerise/ota_updater:ota_signer from //build/keys:signing_seed —
# the private seed exists only on the build side, and the device carries only the
# derived public key (staged into qemu-x64-ota's package by //products:BUILD.bazel).
#
# WHY THESE EXIST. The harness used to compute the manifest's sha256 from the very bytes
# it was about to serve as the image, so the manifest and image always agreed and the
# device's integrity check could not fail. There was no negative test not because nobody
# wrote one but because no bad input was CONSTRUCTIBLE. Signing at build time moves the
# authority out of the harness's reach; `--tamper` then produces an input the harness
# cannot fix, which is what :ota-update-tamper-boot serves.
genrule(
    name = "ota-v2-signed-manifest",
    srcs = [
        "//products:qemu-x64-ota-v2",
        "//build/keys:signing_seed",
    ],
    outs = ["ota_v2_manifest.json"],
    cmd = ("$(location //src/cerise/ota_updater:ota_signer) sign " +
           "--seed $(location //build/keys:signing_seed) " +
           "--image $(location //products:qemu-x64-ota-v2) --version 2 --out $@"),
    tags = ["manual"],
    tools = ["//src/cerise/ota_updater:ota_signer"],
)

genrule(
    name = "ota-v2-tampered-manifest",
    srcs = [
        "//products:qemu-x64-ota-v2",
        "//build/keys:signing_seed",
    ],
    outs = ["ota_v2_manifest_bad.json"],
    cmd = ("$(location //src/cerise/ota_updater:ota_signer) sign --tamper " +
           "--seed $(location //build/keys:signing_seed) " +
           "--image $(location //products:qemu-x64-ota-v2) --version 2 --out $@"),
    tags = ["manual"],
    tools = ["//src/cerise/ota_updater:ota_signer"],
)

sh_test(
    name = "ota-update-boot",
    srcs = ["ota_update_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath :ota-update-uefi-disk)",
        "$(rootpath ota_update_boot_test.py)",
        "$(rootpath //products:qemu-x64-ota-v2)",
        "$(rootpath :ota-v2-signed-manifest)",
    ],
    data = [
        "ota_update_boot_test.py",
        ":ota-update-uefi-disk",
        ":ota-v2-signed-manifest",
        "//products:qemu-x64-ota-v2",
        "@qemu_x86_64//:qemu-system-x86_64",
        "@qemu_x86_64_data//:data",
        "@ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd",
        "@ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd",
    ],
    tags = [
        "manual",
        "local",
        "no-remote",
        "no-remote-exec",
        "requires-network",
    ],
    timeout = "eternal",
)

# THE NEGATIVE CONTROL for :ota-update-boot's verification assertions, as a SEPARATE
# TARGET rather than a branch inside the positive gate — the //validation:marker_contract_bad
# and //src/cerise/tools/route_check:route_check_negative_test shape, where an
# independently executed run proves the checker itself turns red.
#
# It boots the SAME disk and the SAME harness, serving the SAME v2 image, and differs in
# exactly one respect: the manifest's signature has one corrupted hex character. The
# guest must emit `CERISE-OTA-IMAGE-REJECT: bad-signature`, must not emit
# CERISE-OTA-SIG-OK / CERISE-OTA-FETCH-OK / CERISE-OTA-APPLIED, and the v2 image's bytes
# must not be on the disk afterwards — checked with a probe window the positive gate
# proves does appear when an image really is written, so the byte assertion is known to
# be capable of failing.
#
# One launch, not two, so this costs less than the positive gate it guards.
sh_test(
    name = "ota-update-tamper-boot",
    srcs = ["ota_update_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath :ota-update-uefi-disk)",
        "$(rootpath ota_update_boot_test.py)",
        "$(rootpath //products:qemu-x64-ota-v2)",
        "$(rootpath :ota-v2-tampered-manifest)",
        "--tamper-manifest",
    ],
    data = [
        "ota_update_boot_test.py",
        ":ota-update-uefi-disk",
        ":ota-v2-tampered-manifest",
        "//products:qemu-x64-ota-v2",
        "@qemu_x86_64//:qemu-system-x86_64",
        "@qemu_x86_64_data//:data",
        "@ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd",
        "@ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd",
    ],
    tags = [
        "manual",
        "local",
        "no-remote",
        "no-remote-exec",
        "requires-network",
    ],
    timeout = "eternal",
)

