# -----------------------------------------------------------------------------
# Cerise status-console initial prototype live-boot proof: a driverless QEMU framebuffer.
#
# Boots //products:qemu-x64-console-spike via the DIRECT-KERNEL path with a
# `-device VGA` (QEMU stdvga) display and a QMP channel. The guest fb_spike component
# brings up the stdvga linear framebuffer with no display driver (PCI CF8/CFC + Bochs
# VBE + a physical-VMO mapping of the framebuffer BAR), paints a pattern, and emits
# CERISE-FBSPIKE-RENDERED. This test then drives QMP `screendump`, saves the PPM as an
# undeclared output, and asserts on it. This is the residual-risk gate for the whole
# console path.
#
# The pixel assertion is not "non-blank" — one stripe satisfied that, and so would a
# framebuffer the guest never wrote to but the VGA device had decorated. It is now
# EXACT: every pixel of the captured frame must equal the frame fb_spike.rs paints,
# with the mode, the colours and the geometry all reconstructed from the guest's own
# source (so the matcher cannot describe a picture nobody draws). The known-bad frames
# that satisfy the old check and fail this one are built and asserted red by
# //validation:framebuffer_assert_test.
sh_test(
    name = "console-spike-boot",
    srcs = ["console_spike_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath //build/phys:linux_x86_64_boot_shim)",
        "$(rootpath //products:qemu-x64-console-spike)",
        "$(rootpath console_spike_boot_test.py)",
        "$(rootpath //src/cerise/status_console:src/fb_spike.rs)",
    ],
    data = [
        "console_spike_boot_test.py",
        "panel_check.py",
        "@qemu_x86_64//:qemu-system-x86_64",
        "@qemu_x86_64_data//:data",
        "//build/phys:linux_x86_64_boot_shim",
        "//products:qemu-x64-console-spike",
        # The guest's own paint, parsed at test time so the expected frame cannot
        # drift from the one the spike draws.
        "//src/cerise/status_console:src/fb_spike.rs",
    ],
    tags = [
        "manual",
        "local",
        "no-remote",
        "no-remote-exec",
        "requires-network",
    ],
    timeout = "eternal",
)

