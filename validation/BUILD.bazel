# -----------------------------------------------------------------------------
# Cerise status-console storage-backed integration live-boot proof: the combined fileserver + console.
#
# Boots //products:qemu-x64-console (fileserver + status_console) via the direct-kernel
# path with an NVMe disk, a virtio-net NIC, a `-device VGA` display, and a QMP channel.
# The fileserver brings up the network (10.0.2.15) + serves gRPC; the status_console
# reads fuchsia.net.interfaces.State and paints an ESXi-style status screen. The test
# waits for CERISE-CONSOLE-RENDERED + CERISE-FILESERVER-LISTENING, drives QMP screendump,
# saves the PPM as an undeclared output, and asserts on the status screen.
#
# The pixel assertion is not "non-blank". The console reports its memory, CPU and storage
# readings as RAW values on serial, only after the paint that contained them; the harness
# validates those against things it configured itself (QEMU's -m and -smp, and the exact
# byte size of the NVMe image it created), formats the expected on-screen text itself, and
# then finds it on the framebuffer by exact full-cell glyph comparison — anchored to its
# own label, using the font parsed out of the renderer's font.rs. A metric that could not
# be read emits -UNAVAILABLE instead of -OK, and those are fail markers, so the gate
# cannot pass on a panel that had nothing to show.
sh_test(
    name = "console-boot",
    srcs = ["console_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath //build/phys:linux_x86_64_boot_shim)",
        "$(rootpath //products:qemu-x64-console)",
        "$(rootpath console_boot_test.py)",
        "$(rootpath //src/cerise/status_console:src/font.rs)",
    ],
    data = [
        "console_boot_test.py",
        "panel_check.py",
        "@qemu_x86_64//:qemu-system-x86_64",
        "@qemu_x86_64_data//:data",
        "//build/phys:linux_x86_64_boot_shim",
        "//products:qemu-x64-console",
        # The renderer's own glyph table, parsed at test time so the matcher cannot
        # drift from what the console actually draws.
        "//src/cerise/status_console:src/font.rs",
    ],
    tags = [
        "manual",
        "local",
        "no-remote",
        "no-remote-exec",
        "requires-network",
    ],
    timeout = "eternal",
)

