# -----------------------------------------------------------------------------
# OS-self-OTA A/B ROLLBACK gate (//validation:ota-rollback-boot).
#
# Proves the boot shim's A/B slot selection + rollback + \abr write-back
# PERSISTENCE, with no dependency on the in-OS updater. The ESP is a real
# protective-MBR/GPT disk (uefi_disk_image) booted under OVMF like real
# hardware, staged with a good slot A, a deliberately TRUNCATED slot B, and an
# \abr that points at B with one try. The shim spends B's try, fails to load
# the truncated \zircon_b.zbi (before ExitBootServices), and falls back
# in-process to A — rewriting \abr active=A. A second launch on the SAME disk
# boots straight to A with no fallback, proving the rollback survived on disk.
# See ota_rollback_boot_test.py for the full marker chain.

# The good slot-A image: kernel-only x64-smoke prints CERISE-SMOKE-OK.
# The broken slot-B image: the first 8 KiB of a real ZBI — a valid container
# header claiming a large length but truncated, so the shim's ZBI load fails
# (simulates an interrupted slot write) and rollback engages.
genrule(
    name = "ota-truncated-zbi",
    srcs = ["//products:x64-smoke"],
    outs = ["ota_truncated.zbi"],
    cmd = "head -c 8192 $(location //products:x64-smoke) > $@",
)

# Staged \abr: active=B, tries=[A:0,B:1], successful=[A:1,B:0] — B is the pending
# (never-committed) slot with a single try; A is the known-good fallback.
genrule(
    name = "ota-rollback-abr",
    srcs = ["make_abr.py"],
    outs = ["ota_rollback_abr.bin"],
    cmd = "python3 $(location make_abr.py) --active B --tries-a 0 --succ-a 1 " +
          "--tries-b 1 --succ-b 0 --out $@",
)

uefi_esp_image(
    name = "ota-rollback-uefi-esp",
    arch = "x86_64",
    efi_binary = "//zircon/kernel/phys/boot-shim:efi-boot-shim",
    files = {
        "//products:x64-smoke": "zircon_a.zbi",
        ":ota-truncated-zbi": "zircon_b.zbi",
        ":ota-rollback-abr": "abr",
    },
    size_mb = 128,
    volume_label = "CERISE",
)

uefi_disk_image(
    name = "ota-rollback-uefi-disk",
    esp = ":ota-rollback-uefi-esp",
    size_mb = 160,
)

sh_test(
    name = "ota-rollback-boot",
    srcs = ["ota_rollback_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath :ota-rollback-uefi-disk)",
