# -----------------------------------------------------------------------------
# Negative control: the framebuffer gates' pixel assertions, proven able to fail.
#
# //validation:console-spike-boot, :console-boot, :firstlight-uefi-boot and
# :cf-sz5-uefi-boot all assert on pixels, and all four are manual, so nothing
# automated ever exercises their checkers at all. This target builds the frames a
# WRONG implementation would produce — a mode set and one title-bar stripe, the
# pattern painted at the wrong offset or in swapped channels, a status panel with all
# its chrome and labels and none of its measured values, the right text in the wrong
# colour, a value drawn twice — and requires every one to be rejected. Several of them
# are recorded here as frames the old "not one flat colour" assertion accepted.
#
# Host-only, stdlib python, ~2s. It parses the renderer's font.rs and the spike's
# fb_spike.rs, so it also fails if either drifts away from what the gates expect.
sh_test(
    name = "framebuffer_assert_test",
    size = "small",
    srcs = ["framebuffer_assert_test_runner.sh"],
    args = [
        "--font=$(rootpath //src/cerise/status_console:src/font.rs)",
        "--fb-spike-rs=$(rootpath //src/cerise/status_console:src/fb_spike.rs)",
    ],
    data = [
        "framebuffer_assert_test.py",
        "panel_check.py",
        "//src/cerise/status_console:src/font.rs",
        "//src/cerise/status_console:src/fb_spike.rs",
    ],
    # Runs where the gates it speaks for run. panel_check.py is the module the live
    # framebuffer gates import, and it uses `from __future__ import annotations`
    # (python >= 3.7); a remote-execution image with a python older than that fails to
    # import it — measured 2026-07-26 against this developer machine's remote executor,
    # which reports `SyntaxError: future feature annotations is not defined`. Pinning
    # this to the local toolchain keeps the control running against the same
    # interpreter the gates themselves use, rather than passing or failing on a
    # property of the executor image.
    tags = [
        "local",
        "no-remote-exec",
    ],
)

# -----------------------------------------------------------------------------
# Live UEFI boot under `bazel test`, via rules_ostest.
#
# Boot chain: OVMF firmware (pflash) -> efi-boot-shim staged as the removable-
# media boot file \EFI\BOOT\BOOTX64.EFI (auto-mapped by uefi_esp_image) ->
# shim opens \bootx64.zbi from the ESP root (its DEFAULT_ZBI_FILENAME) ->
# Zircon kernel -> userboot-smoke, which writes CERISE-SMOKE-OK to the kernel
# debuglog, surfaced on the q35 legacy serial port the runner scrapes.
uefi_esp_image(
    name = "smoke-uefi-esp",
    arch = "x86_64",
    efi_binary = "//zircon/kernel/phys/boot-shim:efi-boot-shim",
    files = {
        # Volume-root filename the shim's DEFAULT_ZBI_FILENAME expects.
        "//products:x64-smoke": "bootx64.zbi",
    },
    size_mb = 64,
    volume_label = "CERISE",
)

uefi_disk_image(
    name = "smoke-uefi-disk",
    esp = ":smoke-uefi-esp",
    size_mb = 96,
)

uefi_test(
    name = "smoke-uefi-boot",
    arch = "x86_64",
    disk = ":smoke-uefi-disk",
    failure_pattern = "(panic|triple fault|KERNEL FAULT)",
    firmware = "@ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd",
    firmware_vars = "@ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd",
    # 2048 MiB matches the proven validation/run-qemu-uefi.sh invocation for this
    # exact product; a direct pinned-QEMU/OVMF boot of the same shim+ZBI reached
    # CERISE-SMOKE-OK at this size. The rules_ostest 256 MiB default is unproven
    # for a full Zircon boot.
    memory_mb = 2048,
    qemu = "@qemu_x86_64//:qemu-system-x86_64",
    require_kvm = False,
    success_pattern = "CERISE-SMOKE-OK",
    timeout_seconds = 180,
)

# (debugging): ESP-path gdb attach parity. A MANUAL debug
# variant of smoke-uefi-boot using rules_ostest's own gdb support (gdb=True +
# pause_at_start = QEMU -S freeze). Boots the SAME smoke ESP disk, holds the guest
# frozen with a gdbstub listener, and prints the attach line + a gdb-init snippet
# (symbol-file vmzircon + set debug-file-directory <store> + target remote) — the
# ESP analogue of `run-qemu.sh --gdb` (which covers the direct-kernel path). Manual
# (never in a gate); `bazel run //validation:smoke-uefi-debug`.
uefi_py_test(
    name = "smoke-uefi-debug",
    srcs = ["smoke_uefi_debug.py"],
    main = "smoke_uefi_debug.py",
    arch = "x86_64",
    disk = ":smoke-uefi-disk",
    firmware = "@ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd",
    firmware_vars = "@ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd",
    qemu = "@qemu_x86_64//:qemu-system-x86_64",
    memory_mb = 2048,
    gdb = True,
    pause_at_start = True,
    data = [
        "//build/kernel:vmzircon",
        ":x64-smoke.build-id",
    ],
    args = [
        "--kernel-elf=$(rootpath //build/kernel:vmzircon)",
        "--build-id-store=$(rootpath :x64-smoke.build-id)",
    ],
    tags = ["manual", "local"],
)

# -----------------------------------------------------------------------------
# Real-hardware first light: the full UEFI GOP framebuffer path.
#
# firstlight-uefi-disk is BOTH the QEMU-gate boot medium and the dd-able USB
# image for real hardware: protective-MBR
# GPT with the ESP carrying \EFI\BOOT\BOOTX64.EFI (efi-boot-shim) + bootx64.zbi
# (hw-x64-firstlight). The gate boots it under OVMF with `-device VGA` (OVMF
# publishes a real Graphics Output Protocol on it) and asserts, IN ORDER:
# CERISE-SHIM-GOP-FB (shim emitted ZBI_TYPE_FRAMEBUFFER) -> CERISE-GOP-DISPLAY-OK
# (gop_display bound + serving cerise.display) -> CERISE-CONSOLE-RENDERED
# (status_console painted), then QMP-screendumps and asserts what is ON the panel.
#
# The pixel assertion is not "non-blank" — the console's own title bar satisfied
# that, so the gate could pass with an empty panel under a header. It is the
# console_boot_test.py proof on the UEFI/GOP path instead of stdvga: the console
# reports its memory and CPU readings as RAW values after the paint that
# contained them, this harness validates them against the -m/-smp it chose,
# formats the expected on-screen text itself, and finds it by exact full-cell
# glyph comparison (foreground and background) anchored to its own label, using
# the font parsed out of the renderer's font.rs. Storage is deliberately not
# required: this product's realm never starts fshost and the gate attaches no
# data disk, so that metric is honestly unavailable.
# sh_test (not uefi_test): uefi_test takes a single success regex and adds no
# VGA device; this gate needs ordered markers + an extra -device + QMP.
uefi_esp_image(
    name = "firstlight-uefi-esp",
    arch = "x86_64",
    efi_binary = "//zircon/kernel/phys/boot-shim:efi-boot-shim",
    files = {
        "//products:hw-x64-firstlight": "bootx64.zbi",
    },
    size_mb = 96,
    volume_label = "CERISE",
)

uefi_disk_image(
    name = "firstlight-uefi-disk",
    esp = ":firstlight-uefi-esp",
    size_mb = 128,
)

sh_test(
    name = "firstlight-uefi-boot",
    srcs = ["firstlight_boot.sh"],
    args = [
        "$(rootpath @qemu_x86_64//:qemu-system-x86_64)",
        "$(rootpath :firstlight-uefi-disk)",
        "$(rootpath firstlight_boot_test.py)",
        "$(rootpath //src/cerise/status_console:src/font.rs)",
    ],
    data = [
        "firstlight_boot_test.py",
        "panel_check.py",
        # The renderer's own glyph table, parsed at test time so the matcher cannot
        # drift from what the console actually draws.
        "//src/cerise/status_console:src/font.rs",
        ":firstlight-uefi-disk",
        "@qemu_x86_64//:qemu-system-x86_64",
        "@qemu_x86_64_data//:data",
        "@ovmf//:usr/share/OVMF/OVMF_CODE_4M.fd",
        "@ovmf//:usr/share/OVMF/OVMF_VARS_4M.fd",
    ],
    tags = [
        "manual",
        "local",
        "no-remote",
        "no-remote-exec",
    ],
    timeout = "eternal",
)

# -----------------------------------------------------------------------------
# CF-SZ5 first light: the same UEFI/GOP image, on the AMT Serial-over-LAN UART.
#
# cf-sz5-uefi-disk is the //products:cf-sz5-firstlight counterpart of
# firstlight-uefi-disk. Its ONLY difference is the board kernel cmdline
# `kernel.serial=ioport,0xf0a0,19` — the Panasonic CF-SZ5's AMT Serial-over-LAN
# 16550A, which is where the machine's only remote console lives (it has no
# COM1, so hw-x64's `kernel.serial=legacy` would boot it stone silent).
#
# The gate is the SAME test, run with --pio-serial, which gives QEMU a SECOND
# UART at 0xf0a0 and watches both ports. The split matters: the pre-kernel boot
# shim runs under UEFI and prints on the firmware console (COM1), while the
# kernel's UART does not exist until physboot parses the ZBI cmdline. So
# CERISE-SHIM-GOP-FB is asserted on COM1, and every KERNEL-side marker
# (physload onward, through CERISE-CONSOLE-RENDERED) is asserted on 0xf0a0.
#
# That is the point: the kernel markers have to arrive through a UART the kernel
# found only by parsing the board's cmdline. If `ioport,<base>,<irq>` were
# mis-spelled, mis-ordered (ParseConfig reads base then irq) or silently
# ignored, the kernel's output would fall back to COM1, the 0xf0a0 log would
# stay empty, and the gate fails — instead of the mistake being discovered as an
# unexplained dead machine on the far end of a network.
#
# WHY THE GATE'S IRQ IS 5 AND THE BOARD'S IS 0: QEMU's ISA bus asserts
# irqnum < ISA_NUM_IRQS (16), so the CF-SZ5's real PCI GSI 19 cannot be wired to
# an isa-serial device at all — and the kernel would panic on it anyway
# (apic_io_isa_to_global's `isa_irq < NUM_ISA_IRQS` assert; see the board file).
# The board therefore runs the UART in the kernel's polling mode (irq=0) and the
# QEMU wiring uses an ISA-legal stand-in. Both are sound because uart::ns8250
# transmits by POLLING LineStatusRegister::tx_register_empty (ns8250.h
# TxReady/Write), so console output never depends on interrupt delivery. This
# gate proves the BASE ADDRESS and the cmdline GRAMMAR — where the risk actually
# is — and deliberately does not claim to prove IRQ routing.
#
# NOTE: this rehearses the CONSOLE CONFIG, not the SOL transport. Under QEMU the
# UART at 0xf0a0 is an ordinary emulated 16550A; on the real unit the same
# register window is the ME's SOL function (PCI 00:16.3) tunnelling to amtterm.
uefi_esp_image(
    name = "cf-sz5-uefi-esp",
    arch = "x86_64",
    efi_binary = "//zircon/kernel/phys/boot-shim:efi-boot-shim",
    files = {
        # Volume-root filename the shim's DEFAULT_ZBI_FILENAME expects.
        "//products:cf-sz5-firstlight": "bootx64.zbi",
    },
    size_mb = 96,
    volume_label = "CERISE",
)

uefi_disk_image(
    name = "cf-sz5-uefi-disk",
    esp = ":cf-sz5-uefi-esp",
    size_mb = 128,
)

# -----------------------------------------------------------------------------
# CF-SZ5 IN-KERNEL UNIT TESTS as a bootable disk image.
#
# Exactly the cf-sz5-uefi-esp/-disk pair above, with //tests/zircon:cf-sz5-kernel-utest
# (the `ut all` kernel + the AMT SOL cmdline `kernel.serial=ioport,0xf0a0,0`) in place
# of //products:cf-sz5-firstlight. The shim's DEFAULT_ZBI_FILENAME is the ESP-root
# `bootx64.zbi`, so the only thing that changes is which ZBI sits there.
#
# WHY A DISK IMAGE AND NOT A ZBI COPY: the disk image can be served over HTTP and
# `sanboot`ed by iPXE, so a unit-test run on the unit writes NOTHING to its SSD —
# no partitioning, no ESP flashing, no chance of a storage stack touching a disk
# whose contents matter. The utest ZBI is already safe on that axis by construction
# (its bootfs is a single entry, bin/userboot-smoke: no fshost, no component_manager,
# no drivers), and this keeps it safe on the DELIVERY axis too.
#
# WHY compression = "none" HERE, unlike every other image in this file: an iPXE
# `sanboot http://...` exposes the URL as a random-access block device, so it needs
# raw bytes. The gzipped default those other targets keep is fine for them because
# their consumer (uefi_test / a `dd` after `gunzip`) materializes the image first;
# a SAN URI has no such step, and a .gz served there is simply not a disk.
#
# Sizes: the utest ZBI is ~8.2 MiB against firstlight's ~63.8 MiB, so the smoke-uefi
# pair's 64/96 MiB is ample (fat_image's own floor is 34 MiB) and keeps the served
# image small. testonly because //tests/zircon is a testonly package.
#
# The pass/fail contract for what comes back over the serial console is
