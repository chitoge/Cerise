    "//toolchain:zircon_x64_phys_cc_toolchain_registration",
    "//toolchain:zircon_x86_32_phys_cc_toolchain_registration",
    "//toolchain:zircon_x64_efi_cc_toolchain_registration",
    "//toolchain:zircon_x64_user_cc_toolchain_registration",
    "//toolchain:zircon_arm64_kernel_toolchain",
    "//toolchain:zircon_arm64_kernel_cc_toolchain_registration",
