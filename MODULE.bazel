# (vfs + runtime_capabilities fuchsia closure).
crate.spec(package = "pin-project", version = "1")
crate.spec(package = "scopeguard", version = "1")
# cm_types, cm_rust, cm_graph, moniker, cm_config closure.
crate.spec(features = ["serde"], package = "flyweights", version = "0.1")
crate.spec(package = "url", version = "2")
crate.spec(features = ["serde1"], package = "camino", version = "1")
crate.spec(package = "itertools", version = "0.13")
crate.spec(package = "darling", version = "0.20")
crate.spec(package = "darling_core", version = "0.20")
crate.spec(package = "darling_macro", version = "0.20")
