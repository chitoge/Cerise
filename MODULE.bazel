)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # Nightly pin (deliberate, owner-approved): netstack3-core uses unstable Rust
    # APIs (MaybeUninit::write_copy_of_slice etc.). 2025-09-18 is in rules_rust 0.66's
    # known_shas (incl x86_64-unknown-fuchsia + aarch64-linux-gnu exec). Select it via
    # `--@rules_rust//rust/toolchain/channel=nightly` (set in .bazelrc). Unstable
    # features enabled per-target via -Zcrate-attr on the netstack3 rust_library targets.
    versions = ["nightly/2025-09-18"],
    extra_target_triples = ["x86_64-unknown-none", "x86_64-unknown-fuchsia"],
)
use_repo(
    rust,
    "rust_toolchains",
    "rust_linux_x86_64__x86_64-unknown-none__nightly_tools",
    "rust_linux_aarch64__x86_64-unknown-none__nightly_tools",
)

# third-party Rust crate closure for netstack3-core via
# crate_universe. Inline specs (no separate Cargo.toml in the build graph);
# the resolved lock is a regeneration input (repin with CARGO_BAZEL_REPIN=1).
# Starting minimal (no_std leaf crates) to validate the mechanism, then expand
# to netstack3-core's full closure.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    default_features = False,
    package = "arrayvec",
    version = "0.7",
)
crate.spec(
    package = "static_assertions",
    version = "1.1",
)
crate.spec(
    package = "assert_matches",
    version = "1.5",
)
crate.spec(
    package = "rand",
    version = "0.9",
)
crate.spec(
    package = "byteorder",
    version = "1",
)
crate.spec(
    # use_core makes derivative emit ::core:: paths (netstack3 crates are no_std).
    features = ["use_core"],
    package = "derivative",
    version = "2",
)
crate.spec(
    package = "either",
    version = "1",
)
crate.spec(
    features = ["kv_std"],
    package = "log",
    version = "0.4",
)
crate.spec(
    # thiserror 2.x supports no_std (emits core::error::Error on Rust >=1.81);
    # 1.x is std-only and breaks the no_std netstack3 crates.
    package = "thiserror",
    version = "2",
)
crate.spec(
    default_features = False,
    features = ["derive"],
    package = "zerocopy",
    version = "0.8",
)
crate.spec(
    package = "zerocopy-derive",
    version = "0.8",
)
crate.spec(
    # Derives packed bitfield accessors. Used by the imported virtualization
    # definitions, whose register and descriptor layouts are expressed as
    # bitfields.
    package = "bitfield-struct",
    version = "0.11",
)
crate.spec(
    # Structured diagnostics used throughout the imported virtualization crates.
    package = "tracing",
    version = "0.1",
)
crate.spec(
    # Subscriber side of the above; env-filter is the selection mechanism those
    # crates expect to configure.
    features = ["env-filter"],
    package = "tracing-subscriber",
    version = "0.3",
)
crate.spec(
    # Filesystem wrappers whose errors name the offending path. Used by the
    # imported crates that read host topology.
    package = "fs-err",
    version = "3.1",
)
crate.spec(
    package = "proc-macro2",
    version = "1",
)
crate.spec(
    package = "quote",
    version = "1",
)
crate.spec(
    features = [
        "full",
        "extra-traits",
        "visit",
        "visit-mut",
    ],
    package = "syn",
    version = "2",
)
crate.spec(package = "arc-swap", version = "1")
crate.spec(package = "bitflags", version = "2")
crate.spec(package = "cfg-if", version = "1")
crate.spec(default_features = False, features = ["std"], package = "hmac", version = "0.12")
crate.spec(package = "lru-cache", version = "0.1")
crate.spec(package = "once_cell", version = "1")
crate.spec(package = "ref-cast", version = "1")
crate.spec(default_features = False, package = "sha2", version = "0.10")
# OS-self-OTA (src/cerise/ota_updater): pure-Rust FAT driver over std
# Read+Write+Seek traits — no OS deps — used to write the inactive slot's ZBI
# and \abr into the ESP FAT filesystem via a block-client adapter. 0.3.6 is the
