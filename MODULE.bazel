# Register cerise-overlay-exports.patch into the llvm module's
# _LLVM_22_SOURCE_PATCHES so the LLVM-22 libcxx/libunwind overlay BUILDs
# exports_files their src/**. src/cerise/runtime cross-compiles libc++/libunwind
# for Fuchsia from those raw overlay sources, and Bazel 9 strict file visibility
# requires them exported (the upstream 22.x patch list dropped the 21.x treatment).
single_version_override(
    module_name = "llvm",
    patches = ["//third_party/llvm:llvm22-add-overlay-exports.patch"],
    patch_strip = 1,
)

bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_rust", version = "0.66.0")

