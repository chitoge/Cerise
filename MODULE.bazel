# gRPC codegen: protoc built from source via the
# hermetic C++ exec toolchain, driven by rules_rust's prost/tonic toolchain.
# 33.4 is what MVS resolves here (the transitive graph requires >= 33.4), and it
# builds protoc from source cleanly against Bazel 9.2 + rules_cc 0.2.18; pinning
# the direct dep to the effective version keeps --check_direct_dependencies
# quiet. Proto toolchain resolution is enabled in .bazelrc
# (--incompatible_enable_proto_toolchain_resolution) so protoc is selected via
# @rules_proto//proto:toolchain_type rather than the deprecated proto_compiler attr.
bazel_dep(name = "protobuf", version = "33.4")

# rules_rust's prost/tonic extension is a separate BCR module in 0.66
# (rules_rust/extensions/prost carries its own MODULE.bazel, so it is a repo
# boundary, not a package of @rules_rust). Provides rust_prost_library /
# rust_prost_toolchain and the prost toolchain_type.
bazel_dep(name = "rules_rust_prost", version = "0.66.0")

