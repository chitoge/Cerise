crate.spec(default_features = False, package = "strum", version = "0.26")
crate.spec(package = "strum_macros", version = "0.26")
# Rust async + FIDL crate closure (net-new entries only;
# thiserror, proc-macro2, quote, syn, zerocopy, static_assertions already above).
crate.spec(package = "futures", version = "0.3")
crate.spec(package = "pin-project-lite", version = "0.2")
crate.spec(package = "crossbeam", version = "0.8")
crate.spec(package = "libc", version = "0.2")
crate.spec(package = "rustc-hash", version = "2")
crate.spec(features = ["all"], package = "socket2", version = "0.5")
crate.spec(package = "bstr", version = "1")
crate.spec(package = "slab", version = "0.4")
