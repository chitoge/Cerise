# ---------------------------------------------------------------------------
# gRPC server stack. Second, ISOLATED crate universe.
#
# Rationale (the two-universe split): inline crate.spec
# features are unconditional across every triple in a universe. The existing
# @crates pins tokio with [net,...], which is latent-unbuilt on fuchsia today;
# pulling h2 -> tokio into @crates would instantiate mio for the fuchsia triple
# and break the build (mio has no fuchsia selector). isolate=True gives @grpc a
# private tokio[io-util]-only closure. The only concrete type crossing the
# @crates/@grpc seam is fuchsia_async::net::TcpStream (no generic trait bound
# crosses), so the two universes never need to agree on a shared version.
#
# use_repo name is `grpc`, so the crates are @grpc//:tonic, @grpc//:h2, etc.
grpc_ext = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate", isolate = True)
# tonic 0.12 (the design called for 0.13): NO
# protoc-gen-tonic plugin targets tonic-build 0.13 — the plugin ecosystem
# jumped 0.4.1 (tonic-build 0.12) straight to 0.5.0 (tonic-build 0.14.1),
# skipping 0.13 entirely (crates.io index verified). tonic-build 0.12 codegen
# against a 0.13 runtime fails to compile (empty_body/UnsyncBoxBody moved). 0.12
# is the minimal-deviation resolution: it keeps the task's explicit "0.4.x"
# plugin, and its codegen re-exports (empty_body, BoxBody) are UNGATED in
# codegen.rs — transport-independent exactly as the design's [codegen,prost]
# thesis requires (no `server` feature, so no tokio/net -> mio on fuchsia). The
# rest of the stack (prost 0.13, hyper 1, h2 0.4, http 1, tower 0.5) is
# unchanged from the design.
grpc_ext.spec(default_features = False, features = ["codegen", "prost"], package = "tonic", version = "0.12")
grpc_ext.spec(default_features = False, features = ["std", "derive"], package = "prost", version = "0.13")
# prost-types: reexported as the toolchain's prost_types crate.
grpc_ext.spec(package = "prost-types", version = "0.13")
# hyper[http1, http2, server, client]. HTTP/2 carries target-local gRPC; HTTP/1
# is the browser-facing server in the on-target management component.
# `client` is the other direction and it is NOT symmetric with it: hyper's
# client half is a different code path (`hyper::client::conn::http2`), and
# whether it compiles for x86_64-unknown-fuchsia was an open risk rather than a
# corollary of the server working.
# `//src/cerise/lib/hyper_rt:hyper_client_compile_probe` is the answer: it
# builds and links for the fuchsia platform.
#
# A feature added to the EXISTING spec, not a second `crate.spec` for hyper: a
# duplicate spec does not error, it silently collapses the alias and can
# repoint unrelated targets at a different version.
grpc_ext.spec(features = ["http1", "http2", "server", "client"], package = "hyper", version = "1")
grpc_ext.spec(package = "h2", version = "0.4")
# hyper-util[service]: only for TowerToHyperService. Kept in the fuchsia graph
# only if the fuchsia-triple build proves it pulls no tokio net/mio (design
# risk #3); otherwise dropped in favor of the hand-rolled bridge.
grpc_ext.spec(default_features = False, features = ["service"], package = "hyper-util", version = "0.1")
grpc_ext.spec(package = "http", version = "1")
grpc_ext.spec(package = "http-body", version = "1")
grpc_ext.spec(package = "http-body-util", version = "0.1")
grpc_ext.spec(default_features = False, package = "tower", version = "0.5")
grpc_ext.spec(package = "bytes", version = "1")
# tokio[io-util] ONLY — pure buffer helpers, no mio/net; safe for fuchsia.
grpc_ext.spec(default_features = False, features = ["io-util"], package = "tokio", version = "1")
grpc_ext.spec(package = "futures", version = "0.3")
# Executor-neutral deadline future for the raw h2c clients. These clients do
# not use tonic::transport::Channel, so they do not inherit Channel's timeout
# layer and must bound an unanswered RPC themselves.
grpc_ext.spec(package = "futures-timer", version = "3")
grpc_ext.spec(package = "async-trait", version = "0.1")
grpc_ext.spec(package = "pin-project-lite", version = "0.2")
grpc_ext.from_specs(
    supported_platform_triples = [
        "x86_64-unknown-fuchsia",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(grpc_ext, grpc = "crates")

# gRPC protoc plugins: HOST-ONLY isolated universe. protoc-gen-prost /
# protoc-gen-tonic are rust_binary tools that run on the exec platform only, so
# their triples are the host triples (no fuchsia). gen_binaries exposes the
# plugin binaries as @grpc_tools//:protoc-gen-prost__protoc-gen-prost etc.
grpc_tools_ext = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate", isolate = True)
grpc_tools_ext.spec(package = "protoc-gen-prost", version = "0.4")
grpc_tools_ext.spec(package = "protoc-gen-tonic", version = "0.4")
grpc_tools_ext.annotation(crate = "protoc-gen-prost", gen_binaries = ["protoc-gen-prost"])
grpc_tools_ext.annotation(crate = "protoc-gen-tonic", gen_binaries = ["protoc-gen-tonic"])
grpc_tools_ext.from_specs(
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(grpc_tools_ext, grpc_tools = "crates")

# ---------------------------------------------------------------------------
# RustCrypto/CMS stack for cryogen's support/crypto. Third, ISOLATED
# crate universe, same shape as grpc_ext above and for the same reason: it
# needs sha2 0.11 (der 0.8/signature 3.0/spki 0.8 are the digest-0.11
# generation of RustCrypto), and @crates already pins sha2 0.10 for the
# OS-self-OTA FAT driver (digest 0.10) — two incompatible 0.x majors, not a
# version to guess-reconcile. Isolating keeps @crates's sha2 0.10 untouched.
#
# support/crypto's public error types embed `der::Error` directly under
# --cfg=rust (`Pkcs7Error(#[source] der::Error, ...)` in pkcs7/mod.rs), so
# every direct consumer of that surface must resolve `der` (and friends) to
# this SAME instance, not @crates's. firmware_uefi is the one such consumer
# here: it depends on @crypto_crates//:der, not @crates//:der.
#
# Versions and feature selections copied verbatim from the upstream workspace's
# own root Cargo.toml [workspace.dependencies].
crypto_ext = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate", isolate = True)
crypto_ext.spec(features = ["derive", "alloc", "oid"], package = "der", version = "0.8")
crypto_ext.spec(default_features = False, package = "cms", version = "0.3.0-pre.2")
crypto_ext.spec(package = "pkcs1", version = "0.8.0-rc.4")
crypto_ext.spec(features = ["alloc"], package = "pkcs8", version = "0.11.0")
crypto_ext.spec(default_features = False, features = ["encoding", "sha2"], package = "rsa", version = "0.10.0-rc.18")
crypto_ext.spec(default_features = False, features = ["oid"], package = "sha1", version = "0.11.0")
crypto_ext.spec(default_features = False, package = "sha2", version = "0.11.0")
crypto_ext.spec(default_features = False, features = ["alloc"], package = "signature", version = "3.0.0")
crypto_ext.spec(default_features = False, features = ["alloc"], package = "spki", version = "0.8.0")
crypto_ext.spec(default_features = False, package = "x509-cert", version = "0.3.0-rc.4")
# getrandom is ALSO duplicated here (same version/features as @crates's own
# pin) even though support/crypto originally listed only "@crates//:getrandom".
# Reason, found only by building: `crypto::rsa::rust` implements
# `rsa::rand_core::{CryptoRng,TryRng}` (rsa's re-export of the isolated
# universe's `rand_core`) directly on `getrandom::SysRng`. If `getrandom`
# stays in @crates, its transitive `rand_core` is a SEPARATE compilation from
# @crypto_crates's `rand_core` (two isolated Cargo/crate_universe graphs never
# unify a shared transitive dep, even at the identical pinned version), so
# `SysRng: rsa::rand_core::TryRng` fails to typecheck — "multiple different
# versions of crate `rand_core`". Every other @crates pin used by
# support/crypto (anyhow, thiserror) and by firmware_uefi (tracing, zerocopy,
# jiff, async-trait) stays put: none of them is reached through rsa's trait
# bridge, only getrandom is.
crypto_ext.spec(features = ["sys_rng"], package = "getrandom", version = "0.4")
crypto_ext.from_specs(
    supported_platform_triples = [
        "x86_64-unknown-fuchsia",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crypto_ext, crypto_crates = "crates")

# Rust prost/tonic codegen toolchain (build/grpc:prost_toolchain). Listed before
# @rust_toolchains so it is the resolved prost toolchain.
register_toolchains("//build/grpc:prost_toolchain")

llvm_repo = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm_repo, "llvm-project")

# Hosted hermetic cc toolchain for host tools (fidlc, etc.)
# Declares linux_x86_64_to_linux_x86_64 for builds on x86_64 exec (remote workers)
# and linux_aarch64_to_linux_x86_64 for builds on aarch64 exec (this host local).
llvm_toolchain_ext = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain_ext.exec(os = "linux", arch = "x86_64")
llvm_toolchain_ext.exec(os = "linux", arch = "aarch64")
llvm_toolchain_ext.target(os = "linux", arch = "x86_64")
use_repo(llvm_toolchain_ext, "llvm_toolchains")
