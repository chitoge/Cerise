load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Hermetic zstd compress/decompress CLI built from the vendored //third_party/zstd
# sources (via //:zstd_host). Runs as a build-time tool (exec config) for
# tools/zbi/simple_zbi.py (compress STORAGE_BOOTFS) and the host bootfs
# inspectors (decompress before parsing). No dependency on a system zstd.
cc_binary(
    name = "zstd_cli",
    srcs = ["zstd_cli.c"],
    deps = ["//:zstd_host"],
)
