+# Minimal boringssl subset for use in the Fuchsia kernel.
+# Provides: CRYPTO_chacha_20, SHA256_Init/Update/Final/SHA256, OPENSSL_cleanse.
+# Must be compiled with the kernel toolchain (no pthreads, no libc).
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+cc_library(
+    name = "kernel_crypto",
+    srcs = [
+        "crypto/chacha/chacha.cc",
+        "crypto/sha/sha256.cc",
+        "crypto/fipsmodule/kernel_sha256_bcm.cc",
+    ],
+    hdrs = crypto_headers + bcm_internal_headers + crypto_internal_headers,
+    includes = ["include"],
+    copts = [
+        "-DOPENSSL_NO_ASM",
+        "-DOPENSSL_NO_THREADS_CORRUPT_MEMORY_AND_LEAK_SECRETS_IF_THREADED",
+        "-DBORINGSSL_IMPLEMENTATION",
+    ],
+    alwayslink = True,
+    visibility = ["//visibility:public"],
+)
