+// Copyright 2024 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Provides BCM SHA-256 implementations for the Fuchsia kernel.
+// This compiles sha256.cc.inc without the full FIPS/BCM module, providing
+// BCM_sha224_init, BCM_sha256_init, BCM_sha256_update, BCM_sha256_final, etc.
+// that are called by crypto/sha/sha256.cc.
+
+#include "sha/sha256.cc.inc"
+
+// OPENSSL_cleanse is declared in <openssl/mem.h> and used by sha256.cc.
+// Kernel-safe volatile-byte-loop avoids optimizing-out the zero fill.
+#include <string.h>
+extern "C" void OPENSSL_cleanse(void *ptr, size_t len) {
+  volatile unsigned char *p = static_cast<volatile unsigned char *>(ptr);
+  while (len-- != 0) *p++ = 0;
+}
