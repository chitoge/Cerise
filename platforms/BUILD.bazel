package(default_visibility = ["//visibility:public"])

platform(
    name = "zircon_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "x64-kernel",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        "//platforms/env:kernel",
    ],
)

platform(
    name = "x64-phys",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        "//platforms/env:phys",
    ],
