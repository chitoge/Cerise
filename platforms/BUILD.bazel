# probe platform for the upstream x86_64-unknown-fuchsia
# Rust std target. Used to validate that std compiles for the Fuchsia target in
# our hermetic rules_rust setup, ahead of the libc/sysroot port. Resolves
# the rules_rust auto-generated fuchsia toolchain via @rust_toolchains//:all.
platform(
    name = "x64-fuchsia",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:fuchsia",
    ],
)

